# The build profile of the sandbox: the six capabilities that buildah needs for chroot isolation, and no SYS_ADMIN. Do not run it with sandbox.container.
# The root is writable and the seccomp profile keeps unshare and mount, because buildah needs them. See the README.
[Unit]
Description=The hardened Podman sandbox, build profile
Requires=sandbox-proxy.service
After=sandbox-proxy.service
Conflicts=sandbox.service

[Container]
ContainerName=sandbox-build
Image=localhost/sandbox-dev:latest
PodmanArgs=--runtime=crun --cpus=4
Network=none
ReadOnly=false
User=0
WorkingDir=/home/agent
DropCapability=ALL
AddCapability=SETUID SETGID SETPCAP CHOWN DAC_OVERRIDE FOWNER SYS_CHROOT
NoNewPrivileges=true
SeccompProfile=%h/.config/containers/systemd/sandbox/seccomp-build.json
PidsLimit=1024
Memory=3g
Tmpfs=/tmp:rw,nosuid,nodev,size=512m
Tmpfs=/run:rw,nosuid,nodev,size=16m
EnvironmentFile=%h/.config/containers/systemd/sandbox/sandbox.env
Environment=SANDBOX_AGENT_CAPS=+chown,+dac_override,+fowner,+sys_chroot,+setuid,+setgid
Environment=BUILDAH_ISOLATION=chroot
# The home first. The mounts in /home/agent are top-level folders of the home: a deeper mount makes root own the folders above it.
Volume=sandbox-home.volume:/home/agent
Volume=%h/.local/state/sandbox/ca.crt:/etc/ssl/certs/ca-certificates.crt:ro
Volume=%t/sandbox:/run/sandbox/proxy:ro
Volume=%h/Projects/engineersdaybook/.git:/run/sandbox/source:ro
Volume=%h/.local/state/omarchy/current/theme:/home/agent/.omarchy-theme:ro
Volume=sandbox-workspace.volume:/home/agent/engineersdaybook
Volume=sandbox-claude-home.volume:/home/agent/.claude
Volume=sandbox-qwen-home.volume:/home/agent/.qwen
Volume=sandbox-headroom-home.volume:/home/agent/.headroom
Volume=sandbox-herdr.volume:/home/agent/.herdr
Volume=sandbox-cache.volume:/home/agent/.cache
Volume=sandbox-terraform-providers.volume:/home/agent/.cache/terraform-providers
Volume=sandbox-containers.volume:/home/agent/.buildah

[Service]
Restart=on-failure

