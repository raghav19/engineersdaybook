# The builder: BuildKit (buildkitd) in a rootless gVisor container. `just sandbox setup` links this file for Quadlet.
# The builder reaches the internet only through the builder proxy, which checks host names and holds no token.
# The agent runs docker build in the sandbox. docker connects to the socket that buildkitd makes in %t/sandbox/buildkit.
# The builder lives as long as the sandbox. A stop removes the container and its tmpfs, so the cache is gone.
# It has no network device and no secret. Any holder of the socket can run any build step, so the container is the wall.
# %t is $XDG_RUNTIME_DIR. Quadlet reads no other variable.
# For a Compose reader: [Container] is the Compose service. [Unit], [Quadlet] and [Service] are systemd sections.
# A comment names the Compose key of a setting.
[Unit]
Description=Builder of the agent sandbox (BuildKit and gVisor)
# Requires= and After= are depends_on. PartOf= has no Compose key.
# The builder proxy must run before the container mounts the folder of its socket.
Requires=sandbox-builder-proxy.service
After=sandbox-builder-proxy.service
# A stop or a restart of sandbox-agent.service stops or restarts the builder.
PartOf=sandbox-agent.service

# No network at start. This drops the wait for network-online.
[Quadlet]
DefaultDependencies=false

[Container]
# Compose keys: ContainerName=container_name, Image=image, Network=network_mode, User=user, Exec=command,
# DropCapability=cap_drop, AddCapability=cap_add, Tmpfs=tmpfs, Environment=environment, Volume=volumes.
# PodmanArgs=--runtime=runsc-builder is runtime. Health* is healthcheck: HealthCmd=test, HealthInterval=interval, HealthTimeout=timeout, HealthRetries=retries, HealthStartPeriod=start_period.
# Notify=healthy and HealthOnFailure=kill have no Compose key. Notify=healthy is close to depends_on with condition: service_healthy, for the units that start after this one.
ContainerName=sandbox-builder
# `just sandbox build` builds this image from builder/image/Containerfile.
Image=localhost/sandbox-builder:latest
# runsc-builder has its flags in builder/runsc.conf.
PodmanArgs=--runtime=runsc-builder
Network=none
# User 1000 is a subuid. It is the same subuid as the user agent, so the agent may connect.
User=1000
# rootlesskit needs these three capabilities for newuidmap. No other capability.
DropCapability=ALL
AddCapability=SETUID
AddCapability=SETGID
AddCapability=SYS_CHROOT
# no-new-privileges stays off. With it, rootlesskit hangs with no log and no socket.
# gVisor has no PID namespace for build steps. The flag allows this in a container.
Exec=--addr unix:///run/buildkit/buildkitd.sock --oci-worker-no-process-sandbox --oci-worker-snapshotter=native
# The cache is in memory and counts against MemoryMax.
Tmpfs=/home/user/.local/share/buildkit:rw,exec,mode=1777,size=1g
# buildkitd makes its socket here. The sandbox mounts this folder read-only.
Volume=%t/sandbox/buildkit:/run/buildkit
# The socket of the builder proxy. The folder holds nothing else.
Volume=%t/sandbox-builder-proxy:/run/sandbox/proxy:ro
# buildkitd and the build steps use the relay in the builder. The builder proxy passes TLS through, so no CA is needed.
Environment=HTTPS_PROXY=http://127.0.0.1:3129
Environment=HTTP_PROXY=http://127.0.0.1:3129
Environment=NO_PROXY=localhost,127.0.0.1
# Ready when buildkitd lists a worker. sandbox-agent.service starts after that. A builder that is not ready fails the start.
HealthCmd=buildctl --addr unix:///run/buildkit/buildkitd.sock debug workers
HealthInterval=5s
HealthTimeout=5s
HealthRetries=6
HealthStartPeriod=60s
Notify=healthy
# An unhealthy builder stops. systemd then restarts it with an empty cache.
HealthOnFailure=kill

[Service]
# Compose keys: MemoryMax=mem_limit, TasksMax=pids_limit, CPUQuota=200% is cpus: 2, Restart=on-failure is restart: on-failure.
# MemorySwapMax=0 turns swap off, like memswap_limit. ExecStartPre, ExecStartPost and TimeoutStartSec have no Compose key.
# gVisor ignores the limits of Podman, so the service holds them.
MemoryMax=2G
# Without MemorySwapMax=0, swap hides the memory limit.
MemorySwapMax=0
TasksMax=1024
CPUQuota=200%
# A subuid owns the folder, so chown runs in the user namespace of Podman. Mode 0700 keeps other host users out.
ExecStartPre=/usr/bin/mkdir -p -m 0711 %t/sandbox
ExecStartPre=/usr/bin/mkdir -p -m 0700 %t/sandbox/buildkit
ExecStartPre=/usr/bin/podman unshare chown 1000:1000 %t/sandbox/buildkit
# The first start pulls the image.
TimeoutStartSec=300
# The relay listens on 127.0.0.1:3129 and copies the bytes to the socket of the builder proxy. buildkitd and the build steps use it.
# The step runs after the builder is healthy. sandbox-agent.service starts after this step.
ExecStartPost=/usr/bin/podman exec -d sandbox-builder socat TCP-LISTEN:3129,bind=127.0.0.1,fork,reuseaddr UNIX-CONNECT:/run/sandbox/proxy/proxy.sock
# buildkitd exits with code 1 on a stop, so systemctl shows failed after a stop. This is normal.
Restart=on-failure
