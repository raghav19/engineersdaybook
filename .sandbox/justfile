# The Podman sandbox: a hardened rootless container for Claude Code, Qwen Code and the TTT editor. ../justfile loads this file as `mod sandbox`.
# The container has no network. The host proxy (.sandbox/proxy) is its only way out. compose.yaml defines the container and its volume.
# The recipes run in this folder, so podman-compose finds compose.yaml and podman build finds image/.
# A backslash at the end of a line continues the command on the next line. Each line of a recipe is one command.
#
#   just sandbox run     make the container if it does not exist, start it if it stopped, and open Herdr in it.
#   just sandbox rm      remove the container. The volume stays.
#   just sandbox build   build the image, tag it with the commit and push it to ghcr.io. Extra flags go to podman build.
#
# After you edit compose.yaml or build the image, run `just sandbox rm` and then `just sandbox run`.

set quiet
set shell := ['bash', '-euo', 'pipefail', '-c']

# --- Required tools ---
# These lines only check that a tool exists. just stops with a message before any recipe runs if one is missing.
bws            := require("bws")
git            := require("git")
podman         := require("podman")
podman_compose := require("podman-compose")
systemd_creds  := require("systemd-creds")

# --- Names and paths ---
registry := 'ghcr.io/raghav19/engineersdaybook/sandbox-dev'
# The tag of the image is the commit, as in .msb/justfile.
commit := shell(git + ' rev-parse HEAD')
# The Bitwarden access token of the proxy. `build` reads it, so there is no prompt. See .sandbox/proxy/README.md, step 6.
credential := home_directory() / '.config/sandbox/bws-token.cred'

proxy_socket := SANDBOX_SOCKET / 'proxy.sock'

# compose.yaml reads these variables from the environment, so they are exported.
export SANDBOX_CA := home_directory() / '.local/state/sandbox/ca.crt'
export SANDBOX_SOCKET := env('XDG_RUNTIME_DIR') / 'sandbox'
export SANDBOX_GIT_DIR := shell(git + ' rev-parse --path-format=absolute --git-common-dir')
export SANDBOX_THEME := home_directory() / '.local/state/omarchy/current/theme'
export SANDBOX_BRANCH := shell(git + ' branch --show-current')

# Stops with a message if a file is missing. A recipe lists the files that it needs on its first line: `build: (_needs credential)`.
[private]
_needs file:
    {{ if path_exists(file) == 'true' { 'true' } else { error('sandbox: missing ' + file + '. See .sandbox/proxy/README.md.') } }}

# List the recipes (the default)
[default]
help:
    just --list --unsorted

# Open Herdr in the clone. Close the terminal and the sandbox keeps running: run this again for the same session.
# Give a command to run it in place of Herdr: `just sandbox run claude --version`.
run *command: _check (_needs proxy_socket) (_needs SANDBOX_CA)
    # Make the container if it does not exist, and start it if it stopped. A running container stays as it is.
    # --wait waits for the healthcheck in compose.yaml.
    podman-compose up -d --no-recreate \
        --wait --wait-timeout 180 \
        sandbox

    # --wait-timeout does not fail by itself. This stops the recipe with "unhealthy" if the container is not ready.
    # See then: podman logs sandbox
    podman healthcheck run sandbox

    # Open Herdr, or run the command that you gave.
    podman-compose exec \
        -w /home/agent/engineersdaybook \
        sandbox \
        {{ if command == '' { 'herdr' } else { command } }}

# Remove the container. The volume sandbox-home stays, so the clone and the logins stay.
rm:
    podman-compose down

# Build the image and push it to ghcr.io. Flags go to podman build: `just sandbox build --no-cache` updates the tools that the Dockerfile pins by a prefix (claude, qwen).
build *args: (_needs credential)
    # Log in to ghcr.io. GITHUB_TOKEN (write:packages) comes from Bitwarden.
    # The && stops the recipe if systemd-creds fails. A failed $(...) in front of a command does not stop it.
    token="$(systemd-creds --user decrypt --name=bws-token '{{ credential }}' -)" && \
        BWS_ACCESS_TOKEN="$token" \
        bws run -- sh -c 'printf %s "$GITHUB_TOKEN" | podman login ghcr.io -u raghav19 --password-stdin'

    # Build. Each stage is an image in {{ registry }}-cache, so a stage that did not change comes from there.
    # localhost/sandbox-dev:latest is the tag that compose.yaml uses.
    podman build image \
        -t localhost/sandbox-dev:latest \
        -t {{ registry }}:{{ commit }} \
        --cache-from {{ registry }}-cache \
        --cache-to {{ registry }}-cache \
        {{ args }}

    # Push the commit tag.
    podman push {{ registry }}:{{ commit }}

    # Remove the login. If the build fails, the login stays until you run: podman logout ghcr.io
    podman logout ghcr.io

# Stops if an older setup left a container named sandbox. It must run podman, so it is a shell command.
# It is a dependency of `run` only. `run` also needs the proxy socket and the CA: see `_needs`.
[private]
[no-exit-message]
_check:
    # A container named sandbox must come from this compose.yaml. An older setup left one with this name.
    [ -z "$(podman ps -a -q --filter name=^sandbox$)" ] || [ -n "$(podman ps -a -q --filter name=^sandbox$ --filter label=com.docker.compose.project=agent-sandbox)" ] || { \
        echo "sandbox: the container sandbox is from an older setup. It does not start as the user agent."; \
        echo "Remove it: podman rm -f sandbox (the volumes stay). Then run this again."; \
        exit 1; \
    } >&2
