# The Podman sandbox: a hardened rootless container for Claude Code, Qwen Code and the Fresh editor. ../justfile loads this file as `mod sandbox`.
# The container runs in gVisor and has no network. The host proxy container (.sandbox/agent/proxy) is its only way out. agent/sandbox-agent.container defines the container.
# The recipes run in this folder. podman build uses agent/image and builder/image.
# A backslash at the end of a line continues the command on the next line. Each line of a recipe is one command.
#
#   just sandbox setup   make the CA and the credential. Link the container units, the gVisor flags, the Headroom bridge and the repo. Run it again after you edit a file in agent/ or builder/.
#   just sandbox run     restart the container and open Herdr in it. The volume keeps the clone and the logins.
#   just sandbox rm      stop and remove the container, the builder and both proxies. The volume stays.
#   just sandbox build   build the four images, tag the agent sandbox image with the commit and push it to ghcr.io. Extra flags go to podman build.
#
# After you edit agent/sandbox-agent.container or build the image, run `just sandbox run`. It makes a new container.
# Do not put a colon and a space in the quoted text of a plain echo or read line, as in echo 'a: b'. Fresh 0.5.9 then draws the rest of the file in one colour.

set quiet
set shell := ['bash', '-euo', 'pipefail', '-c']

# --- Required tools ---
# These lines only check that a tool exists. just stops with a message before any recipe runs if one is missing.
# bws comes from mise.toml. Run `mise install` once. socat is for the host bridge.
bws            := require("bws")
git            := require("git")
openssl        := require("openssl")
podman         := require("podman")
runsc          := require("runsc")
socat          := require("socat")
systemd_creds  := require("systemd-creds")

# --- Names and paths ---
registry := 'ghcr.io/raghav19/engineersdaybook/sandbox-dev'
# The tag of the image is the commit.
commit := shell(git + ' rev-parse HEAD')
# The Bitwarden access token of the proxy. `setup` makes it. `build` reads it, so there is no prompt.
credential := config_directory() / 'credstore.encrypted/bws-token'

# `run` checks that this path exists. It equals a Volume line of agent/sandbox-agent.container.
SANDBOX_CA := home_directory() / '.local/state/sandbox/ca.crt'
# The .git folder of the repo that you run just in. `setup` links it to ~/.config/sandbox/repo.git, and the unit mounts that link.
git_dir := shell(git + ' rev-parse --path-format=absolute --git-common-dir')

# Stops with a message if a file is missing. A recipe lists the files that it needs on its first line: `build: (_needs credential)`.
_needs file:
    {{ assert(path_exists(file) == 'true', 'sandbox: missing ' + file + '. Run: just sandbox setup') }}

# List the recipes (the default)
[default]
help:
    just --list --unsorted

# Run it in your main checkout, because the links of the units point to the files in this folder.
# It asks for the access token of a Bitwarden machine account. See Prerequisites in README.md.
# Make the CA and the credential. Link the units. Run it again after you edit a file in agent/ or builder/.
[script('bash')]
setup:
    set -euo pipefail
    src='{{ source_directory() }}'
    state="$HOME/.local/state/sandbox"
    mkdir -p "$state" "$HOME/.config/sandbox"

    # iron-proxy ends the TLS of each HTTPS call with this CA. The sandbox gets ca.crt only. An old CA stays.
    if [ ! -f "$state/ca.crt" ] || [ ! -f "$state/ca.key" ]; then
        openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:P-256 -nodes -days 365 \
            -subj '/CN=sandbox egress proxy CA' \
            -addext 'basicConstraints=critical,CA:TRUE,pathlen:0' \
            -addext 'keyUsage=critical,keyCertSign,cRLSign' \
            -keyout "$state/ca.key" -out "$state/ca.crt"
        chmod 0600 "$state/ca.key"
        chmod 0644 "$state/ca.crt"
    fi

    # The proxy containers mount these two configs.
    ln -sf "$src/agent/proxy/iron-proxy.yaml" "$HOME/.config/sandbox/iron-proxy.yaml"
    ln -sf "$src/builder/proxy/iron-proxy.yaml" "$HOME/.config/sandbox/iron-proxy-builder.yaml"

    mkdir -p '{{ parent_directory(credential) }}'
    # Ask for the token only if the credential is missing or systemd-creds cannot read it. The pipe writes no plaintext file.
    if ! systemd-creds --user decrypt --name=bws-token '{{ credential }}' - >/dev/null 2>&1; then
        read -rsp 'Bitwarden access token> ' tok; echo
        rm -f '{{ credential }}'
        printf '%s' "$tok" | systemd-creds --user encrypt --name=bws-token - '{{ credential }}'
        chmod 0400 '{{ credential }}'
    fi

    # The containers. Quadlet reads the units from ~/.config/containers/systemd/. Podman reads the gVisor flags from containers.conf.d/ (see agent/runsc.conf and builder/runsc.conf).
    # The two proxy folders have the same file names. The link name has the prefix sandbox- or sandbox-builder-.
    # repo.git points to the .git folder of this repo. The unit mounts it read-only, and the container clones it.
    mkdir -p "$HOME/.config/containers/systemd" "$HOME/.config/containers/containers.conf.d"
    ln -sf "$src/agent/sandbox-agent.container" "$HOME/.config/containers/systemd/sandbox-agent.container"
    ln -sf "$src/agent/proxy/proxy.container" "$HOME/.config/containers/systemd/sandbox-proxy.container"
    ln -sf "$src/builder/sandbox-builder.container" "$HOME/.config/containers/systemd/sandbox-builder.container"
    ln -sf "$src/builder/proxy/proxy.container" "$HOME/.config/containers/systemd/sandbox-builder-proxy.container"
    ln -sf "$src/agent/runsc.conf" "$HOME/.config/containers/containers.conf.d/sandbox-agent-runsc.conf"
    ln -sf "$src/builder/runsc.conf" "$HOME/.config/containers/containers.conf.d/sandbox-builder-runsc.conf"
    ln -sfn '{{ git_dir }}' "$HOME/.config/sandbox/repo.git"

    # The host bridge. One unit opens each port of agent/ports on 127.0.0.1 on the host and sends it into the sandbox. The sandbox keeps Network=none.
    mkdir -p "$HOME/.config/systemd/user"
    ln -sf "$src/agent/ports" "$HOME/.config/sandbox/ports"
    ln -sf "$src/agent/bridge.sh" "$HOME/.config/sandbox/bridge.sh"
    ln -sf "$src/agent/bridge.service" "$HOME/.config/systemd/user/sandbox-bridge.service"
    systemctl --user daemon-reload
    systemctl --user enable sandbox-bridge.service
    systemctl --user restart sandbox-bridge.service
    echo 'Next, run just sandbox build. Then run just sandbox run.'

# Restart the container and open Herdr in it. Each run makes a new container from the image. The clone, the logins and the histories stay in the volume sandbox-home.
# A process in the old container stops. Give a command to run it in place of Herdr: `just sandbox run claude --version`.
run *command: (_needs SANDBOX_CA)
    # restart stops the unit if it runs, and starts it. The builder and both proxies restart with it.
    # daemon-reload makes systemd read an edit of sandbox-agent.container.
    systemctl --user daemon-reload
    systemctl --user restart sandbox-agent.service

    # Wait for the healthcheck in sandbox-agent.container. `podman healthcheck run` runs the check at once and exits 0 when it passes.
    # If the container is not ready after 180 s, this stops the recipe. See then: podman logs sandbox-agent
    # --foreground and </dev/null keep podman away from your terminal. Without them, timeout runs podman in a background group.
    # In a terminal, the kernel then stops podman for good, and a stopped podman holds the lock of the container, so every podman command hangs.
    timeout --foreground 180 sh -c 'until podman healthcheck run sandbox-agent >/dev/null 2>&1 </dev/null; do sleep 2; done' \
        || { echo 'sandbox: the container is not healthy. To see why, run podman logs sandbox-agent.' >&2; exit 1; }

    # Open Herdr, or run the command that you gave.
    podman exec -it \
        -w /home/agent/engineersdaybook \
        sandbox-agent \
        {{ if command == '' { 'herdr' } else { command } }}

# Stop and remove the container. The volume sandbox-home stays, so the clone and the logins stay.
# The builder and both proxies stop too.
rm:
    systemctl --user stop sandbox-agent.service

# Build the image and push it to ghcr.io. Flags go to podman build: `just sandbox build --no-cache` updates the tools that the Dockerfile pins by a prefix (claude, qwen).
build *args: (_needs credential)
    # Log in to ghcr.io. GITHUB_TOKEN (write:packages) comes from Bitwarden.
    # The && stops the recipe if systemd-creds fails. A failed $(...) in front of a command does not stop it.
    # bws run joins its arguments into one string and runs it with a shell. Do not add sh -c: the shell then loses the quotes.
    token="$(systemd-creds --user decrypt --name=bws-token '{{ credential }}' -)" && \
        BWS_ACCESS_TOKEN="$token" \
        '{{ bws }}' run -- 'printf %s "$GITHUB_TOKEN" | podman login ghcr.io -u raghav19 --password-stdin'

    # Build. Each stage is an image in {{ registry }}-cache, so a stage that did not change comes from there.
    # --jobs 4 builds the stages that do not depend on each other at the same time. The default is 1.
    # localhost/sandbox-dev:latest is the tag that agent/sandbox-agent.container uses.
    podman build agent/image \
        -t localhost/sandbox-dev:latest \
        -t {{ registry }}:{{ commit }} \
        --jobs 4 \
        --cache-from {{ registry }}-cache \
        --cache-to {{ registry }}-cache \
        {{ args }}

    # The builder image: BuildKit and the relay to the builder proxy. The unit sandbox-builder.container runs it.
    podman build builder/image -t localhost/sandbox-builder:latest

    # The proxy images: iron-proxy and socat. The host proxy image also has bws. The units sandbox-proxy and sandbox-builder-proxy run them.
    podman build agent/proxy -t localhost/sandbox-proxy:latest
    podman build builder/proxy -t localhost/sandbox-builder-proxy:latest

    # Push the commit tag.
    podman push {{ registry }}:{{ commit }}

    # Remove the login. If the build fails, the login stays until you run: podman logout ghcr.io
    podman logout ghcr.io
