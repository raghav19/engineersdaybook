# The Podman sandbox: a hardened rootless container for Claude Code, Qwen Code and the TTT editor. ../justfile loads this file as `mod sandbox`.
# The container runs in gVisor and has no network. The host proxy (.sandbox/proxy) is its only way out. sandbox.container defines the container.
# The recipes run in this folder, so podman build finds image/.
# A backslash at the end of a line continues the command on the next line. Each line of a recipe is one command.
#
#   just sandbox setup   install the host proxy and the firewall rule. Link the container unit, the gVisor flags and the repo. Run it again after you edit a file in proxy/.
#   just sandbox run     restart the container and open Herdr in it. The volume keeps the clone and the logins.
#   just sandbox rm      stop and remove the container. The volume stays.
#   just sandbox build   build the image, tag it with the commit and push it to ghcr.io. Extra flags go to podman build.
#   just sandbox queue   start the build queue (Valkey). Run it again after you edit build/ or change the secret QUEUE_WORKER_PASSWORD.
#   just sandbox queue-check   test the rights of the agent and of the worker in the queue.
#   just sandbox queue-down    stop and remove the queue. The waiting jobs are lost.
#
# After you edit sandbox.container or build the image, run `just sandbox run`. It makes a new container.

set quiet
set shell := ['bash', '-euo', 'pipefail', '-c']

# --- Required tools ---
# These lines only check that a tool exists. just stops with a message before any recipe runs if one is missing.
# bws, iron-proxy and yq come from mise.toml. Run `mise install` once.
bws            := require("bws")
git            := require("git")
iron_proxy     := require("iron-proxy")
nft            := require("nft")
openssl        := require("openssl")
podman         := require("podman")
podman_compose := require("podman-compose")
runsc          := require("runsc")
sudo           := require("sudo")
systemd_creds  := require("systemd-creds")
yq             := require("yq")

# --- Names and paths ---
registry := 'ghcr.io/raghav19/engineersdaybook/sandbox-dev'
# The tag of the image is the commit, as in .msb/justfile.
commit := shell(git + ' rev-parse HEAD')
# The Bitwarden access token of the proxy. `setup` makes it. `build` reads it, so there is no prompt.
credential := config_directory() / 'credstore.encrypted/bws-token'

proxy_socket := SANDBOX_SOCKET / 'proxy.sock'

# The ACL of the queue. `queue` renders it from build/queue-policy.yaml. It holds only the hash of the worker password. The folder is not in the sandbox.
queue_acl := env('XDG_RUNTIME_DIR') / 'sandbox-queue/users.acl'

# `run` checks that these two paths exist. They equal the Volume lines of sandbox.container.
SANDBOX_CA := home_directory() / '.local/state/sandbox/ca.crt'
SANDBOX_SOCKET := env('XDG_RUNTIME_DIR') / 'sandbox'
# The .git folder of the repo that you run just in. `setup` links it to ~/.config/sandbox/repo.git, and the unit mounts that link.
git_dir := shell(git + ' rev-parse --path-format=absolute --git-common-dir')

# Stops with a message if a file is missing. A recipe lists the files that it needs on its first line: `build: (_needs credential)`.
_needs file:
    {{ assert(path_exists(file) == 'true', 'sandbox: missing ' + file + '. Run: just sandbox setup') }}

# List the recipes (the default)
[default]
help:
    just --list --unsorted

# Run it in your main checkout, because the links of the units point to the files in this folder.
# It asks for the access token of a Bitwarden machine account. See "What this setup assumes" in proxy/README.md.
# Install and start the host proxy. Run it again after you edit a file in proxy/.
[script('bash')]
setup:
    set -euo pipefail
    proxy='{{ source_directory() }}/proxy'
    state="$HOME/.local/state/sandbox"
    mkdir -p "$state" "$HOME/.config/sandbox"

    # The unit runs the real binaries, not the mise shims. A shim needs the mise.toml of the repo, and the proxy does not see it.
    mkdir -p "$HOME/.config/sandbox/bin"
    for tool in '{{ bws }}' '{{ iron_proxy }}'; do
        case "$tool" in */shims/*) echo "sandbox: $tool is a mise shim. Activate mise in this shell and run this again." >&2; exit 1 ;; esac
        ln -sf "$tool" "$HOME/.config/sandbox/bin/$(basename "$tool")"
    done

    # iron-proxy ends the TLS of each HTTPS call with this CA. The sandbox gets ca.crt only. An old CA stays.
    if [ ! -f "$state/ca.crt" ] || [ ! -f "$state/ca.key" ]; then
        openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:P-256 -nodes -days 365 \
            -subj '/CN=sandbox egress proxy CA' \
            -addext 'basicConstraints=critical,CA:TRUE,pathlen:0' \
            -addext 'keyUsage=critical,keyCertSign,cRLSign' \
            -keyout "$state/ca.key" -out "$state/ca.crt"
        chmod 0600 "$state/ca.key"
        chmod 0644 "$state/ca.crt"
    fi

    ln -sf "$proxy/iron-proxy.yaml" "$HOME/.config/sandbox/iron-proxy.yaml"

    # The container. Quadlet reads the unit from ~/.config/containers/systemd/. Podman reads the gVisor flags from containers.conf.d/ (see runsc.conf).
    # repo.git points to the .git folder of this repo. The unit mounts it read-only, and the container clones it.
    mkdir -p "$HOME/.config/containers/systemd" "$HOME/.config/containers/containers.conf.d"
    ln -sf '{{ source_directory() }}/sandbox.container' "$HOME/.config/containers/systemd/sandbox.container"
    ln -sf '{{ source_directory() }}/runsc.conf' "$HOME/.config/containers/containers.conf.d/runsc.conf"
    ln -sfn '{{ git_dir }}' "$HOME/.config/sandbox/repo.git"
    systemctl --user daemon-reload

    # The firewall rule. A TCP port on 127.0.0.1 has no check of the user, so any local user could use the proxy and its real tokens.
    # The rule lets only your user connect to the proxy ports. nft needs root, so sudo asks for your password.
    # The rule and the unit are copies that root owns. A link to a file in your repo would let you change what root runs.
    # If a step fails, setup stops here and the proxy does not start.
    echo 'sandbox: the firewall rule needs root. sudo asks for your password.'
    sed "s/@UID@/$(id -u)/" "$proxy/sandbox-guard.nft" | sudo tee /etc/sandbox-guard.nft >/dev/null
    sudo install -m 0644 "$proxy/sandbox-guard.service" /etc/systemd/system/sandbox-guard.service
    sudo systemctl daemon-reload
    sudo systemctl enable sandbox-guard.service
    sudo systemctl restart sandbox-guard.service

    mkdir -p '{{ parent_directory(credential) }}'
    # Ask for the token only if the credential is missing or systemd-creds cannot read it. The pipe writes no plaintext file.
    if ! systemd-creds --user decrypt --name=bws-token '{{ credential }}' - >/dev/null 2>&1; then
        read -rsp 'Bitwarden access token: ' tok; echo
        rm -f '{{ credential }}'
        printf '%s' "$tok" | systemd-creds --user encrypt --name=bws-token - '{{ credential }}'
        chmod 0400 '{{ credential }}'
    fi

    systemctl --user link "$proxy"/sandbox-{proxy.service,bridge.service,bridge.socket}
    systemctl --user enable sandbox-proxy.service
    systemctl --user restart sandbox-proxy.service
    sleep 2
    systemctl --user is-active --quiet sandbox-proxy.service \
        || { echo 'sandbox: the proxy did not start. See: journalctl --user -u sandbox-proxy' >&2; exit 1; }
    echo 'The proxy runs.'

# Restart the container and open Herdr in it. Each run makes a new container from the image. The clone, the logins and the histories stay in the volume sandbox-home.
# A process in the old container stops. Give a command to run it in place of Herdr: `just sandbox run claude --version`.
run *command: (_needs proxy_socket) (_needs SANDBOX_CA)
    # restart stops the unit if it runs, and starts it. The unit runs `podman run --replace`, so it also replaces a container that an older setup left with the name sandbox.
    # daemon-reload makes systemd read an edit of sandbox.container.
    systemctl --user daemon-reload
    systemctl --user restart sandbox.service

    # Wait for the healthcheck in sandbox.container. `podman healthcheck run` runs the check at once and exits 0 when it passes.
    # If the container is not ready after 180 s, this stops the recipe. See then: podman logs sandbox
    # --foreground and </dev/null keep podman away from your terminal. Without them, timeout runs podman in a background group.
    # In a terminal, the kernel then stops podman for good, and a stopped podman holds the lock of the container, so every podman command hangs.
    timeout --foreground 180 sh -c 'until podman healthcheck run sandbox >/dev/null 2>&1 </dev/null; do sleep 2; done' \
        || { echo 'sandbox: the container is not healthy. See: podman logs sandbox' >&2; exit 1; }

    # Open Herdr, or run the command that you gave.
    podman exec -it \
        -w /home/agent/engineersdaybook \
        sandbox \
        {{ if command == '' { 'herdr' } else { command } }}

# Stop and remove the container. The volume sandbox-home stays, so the clone and the logins stay.
rm:
    systemctl --user stop sandbox.service

# Build the image and push it to ghcr.io. Flags go to podman build: `just sandbox build --no-cache` updates the tools that the Dockerfile pins by a prefix (claude, qwen).
build *args: (_needs credential)
    # Log in to ghcr.io. GITHUB_TOKEN (write:packages) comes from Bitwarden.
    # The && stops the recipe if systemd-creds fails. A failed $(...) in front of a command does not stop it.
    # bws run joins its arguments into one string and runs it with a shell. Do not add sh -c: the shell then loses the quotes.
    token="$(systemd-creds --user decrypt --name=bws-token '{{ credential }}' -)" && \
        BWS_ACCESS_TOKEN="$token" \
        '{{ bws }}' run -- 'printf %s "$GITHUB_TOKEN" | podman login ghcr.io -u raghav19 --password-stdin'

    # Build. Each stage is an image in {{ registry }}-cache, so a stage that did not change comes from there.
    # localhost/sandbox-dev:latest is the tag that sandbox.container uses.
    podman build image \
        -t localhost/sandbox-dev:latest \
        -t {{ registry }}:{{ commit }} \
        --cache-from {{ registry }}-cache \
        --cache-to {{ registry }}-cache \
        {{ args }}

    # Push the commit tag.
    podman push {{ registry }}:{{ commit }}

    # Remove the login. If the build fails, the login stays until you run: podman logout ghcr.io
    podman logout ghcr.io

# The agent and the worker connect to $XDG_RUNTIME_DIR/sandbox/valkey.sock. The container is in build/compose.yaml.
# The password of the worker is the Bitwarden secret QUEUE_WORKER_PASSWORD. You make it and rotate it there. The ACL holds only its hash.
# Start the build queue (Valkey). Run it again after you edit a file in build/ or change the secret. A start drops the waiting jobs.
[script('bash')]
queue: (_needs credential)
    set -euo pipefail
    build='{{ source_directory() }}/build'
    mkdir -p -m 0711 '{{ SANDBOX_SOCKET }}'
    mkdir -p -m 0700 '{{ parent_directory(queue_acl) }}'

    # The hash of the password. The password stays inside bws run.
    # An empty or short secret stops the recipe. The hash of an empty password would be a valid login.
    # bws run joins its arguments into one string and runs it with a shell. Do not add sh -c: the shell then loses the quotes.
    token="$(systemd-creds --user decrypt --name=bws-token '{{ credential }}' -)"
    hash="$(BWS_ACCESS_TOKEN="$token" '{{ bws }}' run -- 'test "${#QUEUE_WORKER_PASSWORD}" -ge 24 && printf %s "$QUEUE_WORKER_PASSWORD" | sha256sum | cut -d" " -f1')" \
        || { echo 'sandbox: the Bitwarden secret QUEUE_WORKER_PASSWORD is missing or shorter than 24 characters.' >&2; exit 1; }

    # build/queue-acl.yq turns the policy into the ACL. It needs the hash in PW_HASH.
    (
        umask 077
        PW_HASH="$hash" '{{ yq }}' -r --from-file "$build/queue-acl.yq" "$build/queue-policy.yaml" > '{{ queue_acl }}'
    )

    # --force-recreate makes a new container, so it reads the new ACL.
    QUEUE_SOCKET_DIR='{{ SANDBOX_SOCKET }}' QUEUE_ACL='{{ queue_acl }}' \
        '{{ podman_compose }}' -f "$build/compose.yaml" up -d --force-recreate
    # A stale valkey.sock from an earlier run can exist, so ask the server. NOAUTH means that it runs and wants a login.
    timeout 30 sh -c 'until podman exec sandbox-queue valkey-cli -s /run/valkey/valkey.sock ping 2>&1 | grep -qE "PONG|NOAUTH"; do sleep 1; done' \
        || { echo 'sandbox: the queue did not start. See: podman logs sandbox-queue' >&2; exit 1; }
    echo 'The queue runs.'

# The client is a gVisor container with no network. It has only the socket folder, as the sandbox has. The checks use the keys job:t1:*, and they remove them at the end.
# Test the rights of the agent and of the worker in the queue. Each line is ok or FAIL. The recipe fails if a line fails.
[script('bash')]
queue-check: (_needs queue_acl)
    set -euo pipefail
    check="$(mktemp -p '{{ parent_directory(queue_acl) }}')"
    trap 'rm -f "$check"' EXIT
    cat > "$check" <<'CHECKS'
    sock=/run/valkey/valkey.sock
    # a is the agent. w is the worker. The agent has no password, so any value logs it in.
    a() { valkey-cli -s $sock --no-auth-warning --user agent --pass x "$@" 2>&1; }
    w() { valkey-cli -s $sock --no-auth-warning --user worker --pass "$QUEUE_WORKER_PASSWORD" "$@" 2>&1; }
    fail=0
    expect() { if printf '%s' "$3" | grep -qE "$2"; then echo "ok    $1"; else echo "FAIL  $1 -> $3"; fail=1; fi; }
    expect 'no login: refused'                'NOAUTH'     "$(valkey-cli -s $sock ping 2>&1)"
    expect 'agent: SET context'               '^OK$'       "$(a SET job:t1:ctx abc EX 60)"
    expect 'agent: SET spec'                  '^OK$'       "$(a SET job:t1:spec 'image=x tag=y')"
    expect 'agent: LPUSH queue'               '^1$'        "$(a LPUSH build:queue t1)"
    expect 'agent: read a missing status'     '^\[\]$'     "[$(a GET job:t1:status)]"
    expect 'agent: GET context is blocked'    'NOPERM'     "$(a GET job:t1:ctx)"
    expect 'agent: SET status is blocked'     'NOPERM'     "$(a SET job:t1:status done)"
    expect 'agent: LRANGE queue is blocked'   'NOPERM'     "$(a LRANGE build:queue 0 -1)"
    expect 'agent: KEYS is blocked'           'NOPERM'     "$(a KEYS '*')"
    expect 'agent: CONFIG is blocked'         'NOPERM'     "$(a CONFIG GET dir)"
    expect 'agent: EVAL is blocked'           'NOPERM'     "$(a EVAL 'return 1' 0)"
    expect 'agent: FLUSHALL is blocked'       'NOPERM'     "$(a FLUSHALL)"
    expect 'agent: DEL is blocked'            'NOPERM'     "$(a DEL job:t1:ctx)"
    expect 'worker: wrong password fails'     'WRONGPASS'  "$(valkey-cli -s $sock --no-auth-warning --user worker --pass wrong ping 2>&1)"
    expect 'worker: BLMOVE takes the job'     '^t1$'       "$(w BLMOVE build:queue build:active RIGHT LEFT 1)"
    expect 'worker: GET context'              '^abc$'      "$(w GET job:t1:ctx)"
    expect 'worker: SET status'               '^OK$'       "$(w SET job:t1:status running)"
    expect 'agent: reads the status'          '^running$'  "$(a GET job:t1:status)"
    expect 'worker: FLUSHALL is blocked'      'NOPERM'     "$(w FLUSHALL)"
    expect 'worker: CONFIG is blocked'        'NOPERM'     "$(w CONFIG GET dir)"
    w LREM build:active 1 t1 >/dev/null
    w DEL job:t1:ctx job:t1:spec job:t1:status >/dev/null
    exit $fail
    CHECKS
    token="$(systemd-creds --user decrypt --name=bws-token '{{ credential }}' -)"
    BWS_ACCESS_TOKEN="$token" '{{ bws }}' run -- \
        "test -n \"\$QUEUE_WORKER_PASSWORD\" && podman run --rm --runtime runsc --network none -v '{{ SANDBOX_SOCKET }}:/run/valkey:ro' -v '$check:/check.sh:ro' -e QUEUE_WORKER_PASSWORD --entrypoint sh docker.io/valkey/valkey:8 /check.sh"

# Stop and remove the build queue. The waiting jobs are lost.
queue-down:
    QUEUE_SOCKET_DIR='{{ SANDBOX_SOCKET }}' QUEUE_ACL='{{ queue_acl }}' \
        '{{ podman_compose }}' -f '{{ source_directory() }}/build/compose.yaml' down
    rm -f '{{ queue_acl }}' '{{ SANDBOX_SOCKET }}/valkey.sock'
