# The Podman sandbox: a hardened rootless container for Claude Code, Qwen Code and the TTT editor. ../justfile loads this file as `mod sandbox`.
# The container has no network. The host proxy (.sandbox/proxy) is its only way out. compose.yaml defines both containers and their volumes.
#
#   just sandbox run     the agent sandbox. It starts if it does not run. Opens Herdr in it.
#   just sandbox build   the build sandbox: a separate container for buildah, with its own home. It sees the home of the agent at /src, read-only.
#
# Make the image once: podman build .sandbox/image -t localhost/sandbox-dev:latest

set quiet
set shell := ['bash', '-euo', 'pipefail', '-c']

socket := env('XDG_RUNTIME_DIR') / 'sandbox'
ca := home_directory() / '.local/state/sandbox/ca.crt'
compose := 'podman-compose -f ' + source_directory() / 'compose.yaml'

# compose.yaml reads these variables.
# podman-compose fails with "name already in use" if the container exists, so each recipe starts the container only if it does not run.
# --force-recreate replaces a stopped container. The volumes stay.
export SANDBOX_CA := ca
export SANDBOX_SOCKET := socket
export SANDBOX_GIT_DIR := shell('git rev-parse --path-format=absolute --git-common-dir')
export SANDBOX_THEME := home_directory() / '.local/state/omarchy/current/theme'
export SANDBOX_BRANCH := shell('git branch --show-current')

# List the recipes (the default)
[default]
help:
    just --list --unsorted

# Open Herdr in the clone. Close the terminal and the sandbox keeps running: run this again for the same session.
# Give a command to run it in place of Herdr: `just sandbox run claude --version`.
run *command: _check
    podman ps -q --filter name=^sandbox$ | grep -q . || {{ compose }} up -d --force-recreate sandbox
    timeout 180 bash -c 'until podman exec sandbox test -e /tmp/sandbox-ready 2>/dev/null; do sleep 1; done'
    podman exec -it -u 0 -w /home/agent/engineersdaybook sandbox sandbox-entry {{ if command == '' { 'herdr' } else { command } }}

# The same in the build sandbox. In it, `mise run build -- -t name /src/engineersdaybook` and `mise run push -- name ghcr.io/owner/name:tag` work.
build *command: _check
    podman ps -q --filter name=^sandbox-build$ | grep -q . || {{ compose }} up -d --force-recreate sandbox-build
    timeout 180 bash -c 'until podman exec sandbox-build test -e /tmp/sandbox-ready 2>/dev/null; do sleep 1; done'
    podman exec -it -u 0 -w /home/agent/engineersdaybook sandbox-build sandbox-entry {{ if command == '' { 'herdr' } else { command } }}

# The sandbox needs the proxy socket and the CA. The proxy units make them. This recipe only checks that they exist.
[private]
_check:
    [ -S '{{ socket }}/proxy.sock' ] || { echo 'sandbox: no proxy socket at {{ socket }}/proxy.sock. Start the proxy: systemctl --user start sandbox-proxy (see .sandbox/proxy/README.md).' >&2; exit 1; }
    [ -f '{{ ca }}' ] || { echo 'sandbox: no CA at {{ ca }}. See .sandbox/proxy/README.md.' >&2; exit 1; }
