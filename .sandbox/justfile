# The Podman sandbox: a hardened rootless container for Claude Code, Qwen Code and the TTT editor. ../justfile loads this file as `mod sandbox`.
# Quadlet declares the container (quadlet/) and systemd starts it. The README has the commands. This file builds the image.

set quiet
set shell := ['bash', '-euo', 'pipefail', '-c']

podman := require("podman")

image := 'localhost/sandbox-dev:latest'
image_dir := source_directory() / 'image'

# List the recipes (the default)
[default]
help:
    just --list --unsorted

# Build the image. The first build takes several minutes.
build:
    podman build {{ image_dir }} -t {{ image }}
