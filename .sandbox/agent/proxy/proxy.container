# The host proxy: iron-proxy in a rootless container. `just sandbox setup` links this file as sandbox-proxy.container for Quadlet.
# It is the only way out of the agent sandbox. It holds the real tokens, and the agent sandbox does not.
# The agent sandbox connects to the Unix socket proxy.sock in %t/sandbox. socat in this container joins the socket to the tunnel port of iron-proxy.
# The port exists only in the network namespace of this container, so no firewall rule is needed.
# %h is your home folder. %t is $XDG_RUNTIME_DIR. %d is the folder of the systemd credentials of this service.
# For a Compose reader: [Container] is the Compose service. [Unit], [Quadlet] and [Service] are systemd sections.
# A comment names the Compose key of a setting.
[Unit]
Description=Host proxy of the agent sandbox (iron-proxy in a container)
# A stop or a restart of sandbox-agent.service stops or restarts this unit. The real tokens are in memory only while a sandbox runs.
PartOf=sandbox-agent.service

# No wait for network-online.
[Quadlet]
DefaultDependencies=false

[Container]
# Compose keys: ContainerName=container_name, Image=image, ReadOnly=read_only, DropCapability=cap_drop, Tmpfs=tmpfs,
# Environment=environment, WorkingDir=working_dir, RunInit=init, Volume=volumes, Exec=command.
# NoNewPrivileges=true is security_opt: no-new-privileges.
ContainerName=sandbox-proxy
Image=localhost/sandbox-proxy:latest
ReadOnly=true
DropCapability=ALL
NoNewPrivileges=true
Tmpfs=/tmp
# bws writes its state in HOME.
Environment=HOME=/tmp
WorkingDir=/etc/iron-proxy
# An init process passes the stop signal to bws. As PID 1, bws would ignore it, and the stop would wait for the kill.
RunInit=true
# The config, the CA and its key. The sandbox gets ca.crt only.
Volume=%h/.config/sandbox/iron-proxy.yaml:/etc/iron-proxy/iron-proxy.yaml:ro
Volume=%h/.local/state/sandbox/ca.crt:/etc/iron-proxy/ca.crt:ro
Volume=%h/.local/state/sandbox/ca.key:/etc/iron-proxy/ca.key:ro
# The folder of proxy.sock. The sandbox mounts the same folder.
Volume=%t/sandbox:/run/sandbox
# The Bitwarden access token. systemd decrypts it to memory. It does not go into the config of the container.
Volume=%d/bws-token:/run/secrets/bws-token:ro
# bws run puts the real tokens in the environment of iron-proxy only. The access token does not reach iron-proxy.
Exec=sh -c 'BWS_ACCESS_TOKEN="$(cat /run/secrets/bws-token)" exec bws run -- env -u BWS_ACCESS_TOKEN iron-proxy -config /etc/iron-proxy/iron-proxy.yaml'

[Service]
# Compose keys: MemoryMax=mem_limit, TasksMax=pids_limit, Restart=on-failure is restart: on-failure.
# MemorySwapMax=0 turns swap off, like memswap_limit. LoadCredentialEncrypted, SuccessExitStatus, ExecStartPre and ExecStartPost have no Compose key.
# The credential bws-token: ~/.config/credstore.encrypted/bws-token. just sandbox setup makes the file.
LoadCredentialEncrypted=bws-token
# gVisor is not here, so the limits of Podman do not apply to this container either. The service holds the limits.
# A stop ends the proxy with the signal TERM, which is the exit code 143. This is a normal stop.
SuccessExitStatus=143
MemoryMax=512M
MemorySwapMax=0
TasksMax=512
# The folder is for the sockets. 0711 lets the sandbox reach proxy.sock, and nothing else.
ExecStartPre=/usr/bin/mkdir -p -m 0711 %t/sandbox
# socat listens on proxy.sock. The mode 0666 lets the sandbox user connect, because it is a subuid in rootless Podman.
# unlink-early removes an old socket file. socat connects to the tunnel port for each connection.
ExecStartPost=/usr/bin/podman exec -d sandbox-proxy socat UNIX-LISTEN:/run/sandbox/proxy.sock,fork,mode=0666,unlink-early TCP:127.0.0.1:18080
Restart=on-failure
