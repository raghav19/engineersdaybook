# The host bridge: one unit for all the ports in agent/ports. It runs on the host, not in the sandbox. See bridge.sh.
# The limits are here, as in the container units. See sandbox-agent.container.
[Unit]
Description=Host bridge to the ports of the agent sandbox

[Service]
ExecStart=%h/.config/sandbox/bridge.sh
Restart=on-failure
NoNewPrivileges=true
MemoryMax=256M
MemorySwapMax=0
TasksMax=256

[Install]
WantedBy=default.target
