{
  "permissions": {
    "allow": [
      "mcp__github__get_me",
      "mcp__github__list_pull_requests",
      "mcp__github__create_pull_request",
      "mcp__github__update_pull_request",
      "mcp__github__list_dependabot_alerts",
      "mcp__github__get_dependabot_alert",
      "Bash(herdr worktree create:*)",
      "Bash(herdr worktree list:*)"
    ],
    "deny": [
      "mcp__github__merge_pull_request",
      "mcp__github__delete_file",
      "mcp__github__delete_repository",
      "mcp__github__create_repository",
      "mcp__github__fork_repository"
    ],
    "additionalDirectories": [
      "/home/agent/.herdr/worktrees"
    ],
    "disableBypassPermissionsMode": "disable",
    "blockReadsOutsideWorkingDirectories": true,
    "blockWritesOutsideWorkingDirectories": true
  },
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "OTEL_METRICS_EXPORTER": "otlp",
    "OTEL_LOGS_EXPORTER": "otlp",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "http/protobuf",
    "OTEL_EXPORTER_OTLP_ENDPOINT": "http://127.0.0.1:4318",
    "OTEL_LOG_TOOL_DETAILS": "1"
  },
  "allowManagedHooksOnly": true,
  "allowManagedPermissionRulesOnly": true,
  "allowManagedMcpServersOnly": true,
  "allowedMcpServers": [
    { "serverUrl": "https://mcp.draw.io/mcp" },
    { "serverUrl": "https://schemas.fluxoperator.dev/mcp" },
    { "serverUrl": "https://api.githubcopilot.com/mcp/" }
  ],
  "managedMcpServers": {
    "drawio": {
      "type": "http",
      "url": "https://mcp.draw.io/mcp"
    },
    "flux-schema-catalog": {
      "type": "http",
      "url": "https://schemas.fluxoperator.dev/mcp"
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer sandbox-placeholder-GH_TOKEN",
        "X-MCP-Toolsets": "context,dependabot,issues,pull_requests,repos"
      }
    }
  }
}
