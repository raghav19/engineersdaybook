<mxCell id="title" value="How the files connect" style="text;html=0;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="800" height="40" as="geometry"/></mxCell>
<mxCell id="just" value="justfile&#xa;setup and build make the files below. run starts them." style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="420" height="70" as="geometry"/></mxCell>
<mxCell id="note" value="Placeholders must match&#xa;sandbox-agent.container, managed-settings.json,&#xa;docker-config.json and agent/proxy/iron-proxy.yaml" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1070" y="60" width="440" height="84" as="geometry"/></mxCell>
<mxCell id="A" value="In the repo: .sandbox/" style="swimlane;rounded=1;arcSize=4;startSize=40;whiteSpace=wrap;html=0;fontSize=16;fillColor=#ffffff;strokeColor=#d6b656;align=left;spacingLeft=10;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="170" width="420" height="740" as="geometry"/></mxCell>
