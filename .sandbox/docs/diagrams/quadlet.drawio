<mxfile host="app.diagrams.net"><diagram id="quadlet" name="quadlet"><mxGraphModel dx="1000" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1340" background="#ffffff" math="0" shadow="0"><root>
<mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="title" value="How Quadlet controls the sandbox" style="text;html=0;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="800" height="40" as="geometry"/></mxCell>
<mxCell id="files" value="The four .container files&#xa;sandbox-agent, sandbox-builder&#xa;sandbox-proxy&#xa;sandbox-builder-proxy" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="20" y="640" width="310" height="110" as="geometry"/></mxCell>
<mxCell id="gen" value="Quadlet generator&#xa;reads the .container files&#xa;writes the .service files" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="380" y="635" width="220" height="120" as="geometry"/></mxCell>
<mxCell id="note1" value="Podman limits are not used&#xa;--memory and --cpus: gVisor ignores them&#xa;(runsc.conf: ignore-cgroups)" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="860" width="340" height="84" as="geometry"/></mxCell>
<mxCell id="note2" value="PartOf the agent&#xa;A stop of sandbox-agent.service&#xa;stops the builder and both proxies" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="980" width="340" height="84" as="geometry"/></mxCell>
