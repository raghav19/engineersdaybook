<mxfile host="app.diagrams.net"><diagram id="architecture" name="architecture"><mxGraphModel adaptiveColors="auto" dx="1000" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="960" math="0" shadow="0"><root>
<mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="title" value="&lt;b&gt;Architecture of the hardened Podman sandbox&lt;/b&gt;" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="1060" height="40" as="geometry"/></mxCell>
<mxCell id="bw" value="&lt;b&gt;Bitwarden project&lt;/b&gt;&lt;br&gt;&lt;small&gt;GH_TOKEN, CLAUDE_CODE_OAUTH_TOKEN, QWEN_API_KEY, GITHUB_TOKEN&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="760" y="60" width="280" height="76" as="geometry"/></mxCell>
<mxCell id="host" value="Host: your user, rootless Podman with crun, systemd user services" style="swimlane;rounded=1;arcSize=6;startSize=26;whiteSpace=wrap;html=1;fontSize=14;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="20" y="216" width="1060" height="560" as="geometry"/></mxCell>
<mxCell id="term" value="&lt;b&gt;Your terminal&lt;/b&gt;&lt;br&gt;&lt;small&gt;just sandbox run&lt;/small&gt;&lt;br&gt;&lt;small&gt;podman exec -it&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="host"><mxGeometry x="20" y="108" width="230" height="90" as="geometry"/></mxCell>
<mxCell id="files" value="&lt;b&gt;Read-only mounts&lt;/b&gt;&lt;br&gt;&lt;small&gt;.git folder of the repo&lt;/small&gt;&lt;br&gt;&lt;small&gt;ca.crt (the CA of the proxy)&lt;/small&gt;&lt;br&gt;&lt;small&gt;Omarchy theme&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="host"><mxGeometry x="20" y="350" width="230" height="150" as="geometry"/></mxCell>
<mxCell id="sbx" value="Sandbox: Podman container (crun)&lt;br&gt;&lt;small&gt;--network none, read-only root, seccomp&lt;/small&gt;" style="swimlane;rounded=1;arcSize=6;startSize=48;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffffff;strokeColor=#82b366;align=left;spacingLeft=10;" vertex="1" parent="host"><mxGeometry x="290" y="46" width="340" height="480" as="geometry"/></mxCell>
<mxCell id="agent" value="&lt;b&gt;Agent tools&lt;/b&gt;&lt;br&gt;&lt;small&gt;Claude Code, Qwen Code, Herdr, TTT&lt;/small&gt;&lt;br&gt;&lt;small&gt;buildah in the build profile&lt;/small&gt;&lt;br&gt;&lt;small&gt;holds placeholders only&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="sbx"><mxGeometry x="20" y="60" width="300" height="110" as="geometry"/></mxCell>
<mxCell id="relay" value="&lt;b&gt;Relay (socat)&lt;/b&gt;&lt;br&gt;&lt;small&gt;127.0.0.1:3128 to the proxy socket&lt;/small&gt;&lt;br&gt;&lt;small&gt;runs as container root, no capability&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="sbx"><mxGeometry x="20" y="200" width="300" height="80" as="geometry"/></mxCell>
<mxCell id="vols" value="&lt;b&gt;Named volumes&lt;/b&gt;&lt;br&gt;&lt;small&gt;workspace (the clone)&lt;/small&gt;&lt;br&gt;&lt;small&gt;claude-home, qwen-home&lt;/small&gt;&lt;br&gt;&lt;small&gt;headroom-home, herdr&lt;/small&gt;&lt;br&gt;&lt;small&gt;cache, terraform-providers&lt;/small&gt;&lt;br&gt;&lt;small&gt;containers (buildah storage)&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="sbx"><mxGeometry x="20" y="310" width="300" height="150" as="geometry"/></mxCell>
<mxCell id="svc" value="Host services&lt;br&gt;&lt;small&gt;systemd user units&lt;/small&gt;" style="swimlane;rounded=1;arcSize=6;startSize=48;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=10;" vertex="1" parent="host"><mxGeometry x="730" y="46" width="310" height="420" as="geometry"/></mxCell>
<mxCell id="proxy" value="&lt;b&gt;iron-proxy&lt;/b&gt;&lt;br&gt;&lt;small&gt;sandbox-proxy.service&lt;/small&gt;&lt;br&gt;&lt;small&gt;allowlist, TLS CA, secret swap&lt;/small&gt;&lt;br&gt;&lt;small&gt;tunnel 127.0.0.1:18080&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="svc"><mxGeometry x="20" y="60" width="270" height="90" as="geometry"/></mxCell>
<mxCell id="bridge" value="&lt;b&gt;Socket unit and systemd-socket-proxyd&lt;/b&gt;&lt;br&gt;&lt;small&gt;sandbox-bridge.socket: proxy.sock to 127.0.0.1:18080&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="svc"><mxGeometry x="20" y="190" width="270" height="70" as="geometry"/></mxCell>
<mxCell id="toks" value="&lt;b&gt;Real tokens&lt;/b&gt;&lt;br&gt;&lt;small&gt;in the proxy environment only&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="svc"><mxGeometry x="20" y="290" width="270" height="50" as="geometry"/></mxCell>
<mxCell id="cakey" value="&lt;b&gt;CA private key&lt;/b&gt;&lt;br&gt;&lt;small&gt;~/.local/state/sandbox, mode 600&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="svc"><mxGeometry x="20" y="350" width="270" height="50" as="geometry"/></mxCell>
<mxCell id="net" value="&lt;b&gt;Allowed hosts&lt;/b&gt;&lt;br&gt;&lt;small&gt;github.com, api.anthropic.com, the Qwen endpoint, ghcr.io and the rest of the allowlist&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="700" y="856" width="380" height="76" as="geometry"/></mxCell>
<mxCell id="e1" value="podman exec" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=1;html=1;labelBackgroundColor=default;fontSize=12;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="term" target="agent"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e2" value="mounts" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=1;html=1;labelBackgroundColor=default;fontSize=12;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="files" target="vols"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e3" value="Unix socket proxy.sock&lt;br&gt;(read-only mount)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=1;html=1;labelBackgroundColor=default;fontSize=12;strokeWidth=2;strokeColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="relay" target="bridge"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e4" value="loopback TCP 18080" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=1;html=1;labelBackgroundColor=default;fontSize=12;strokeWidth=2;strokeColor=#333333;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="bridge" target="proxy"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e5" value="real tokens at start&lt;br&gt;(bws run)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=1;html=1;labelBackgroundColor=default;fontSize=12;strokeWidth=2;strokeColor=#d79b00;" edge="1" parent="1" source="bw" target="svc"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e6" value="allowed hosts only" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=1;html=1;labelBackgroundColor=default;fontSize=12;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="svc" target="net"><mxGeometry relative="1" as="geometry"/></mxCell>
