<mxfile host="app.diagrams.net"><diagram id="architecture" name="architecture"><mxGraphModel dx="1000" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="800" background="#ffffff" math="0" shadow="0"><root>
<mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="title" value="Architecture of the hardened Podman sandbox" style="text;html=0;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="700" height="36" as="geometry"/></mxCell>
<mxCell id="bw" value="Bitwarden project&#xa;GH_TOKEN, CLAUDE_CODE_OAUTH_TOKEN,&#xa;QWEN_API_KEY, GITHUB_TOKEN" style="rounded=1;whiteSpace=wrap;html=0;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1065" y="20" width="330" height="70" as="geometry"/></mxCell>
<mxCell id="host" value="Host: your user, rootless Podman with crun, systemd user services" style="swimlane;rounded=1;arcSize=4;startSize=30;whiteSpace=wrap;html=0;fontSize=14;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="20" y="150" width="1290" height="610" as="geometry"/></mxCell>
<mxCell id="term" value="Your terminal&#xa;just sandbox run&#xa;opens Herdr in the container" style="rounded=1;whiteSpace=wrap;html=0;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="210" height="90" as="geometry"/></mxCell>
<mxCell id="ro" value="Read-only mounts&#xa;.git folder of the repo&#xa;ca.crt (the CA of the proxy)&#xa;the proxy socket folder&#xa;Omarchy theme" style="rounded=1;whiteSpace=wrap;html=0;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="595" width="210" height="125" as="geometry"/></mxCell>
<mxCell id="sbx" value="Sandbox: Podman container (crun)&#xa;user agent, no capabilities, no-new-privileges&#xa;--network none, read-only root" style="swimlane;rounded=1;arcSize=4;startSize=70;whiteSpace=wrap;html=0;fontSize=14;fillColor=#ffffff;strokeColor=#82b366;align=left;spacingLeft=10;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="330" y="190" width="440" height="550" as="geometry"/></mxCell>
<mxCell id="agent" value="Agent tools&#xa;Claude Code, Qwen Code, Herdr, TTT&#xa;holds placeholders, never a real token" style="rounded=1;whiteSpace=wrap;html=0;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="350" y="270" width="400" height="90" as="geometry"/></mxCell>
<mxCell id="relay" value="Relay (socat)&#xa;127.0.0.1:3128 to the proxy socket&#xa;runs as the user agent, no capability" style="rounded=1;whiteSpace=wrap;html=0;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="470" y="440" width="280" height="90" as="geometry"/></mxCell>
<mxCell id="home" value="sandbox-home (named volume)&#xa;the clone, .claude, .qwen, .headroom,&#xa;.herdr and .cache" style="rounded=1;whiteSpace=wrap;html=0;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="350" y="620" width="400" height="80" as="geometry"/></mxCell>
<mxCell id="svc" value="Host services: real tokens, CA key" style="swimlane;rounded=1;arcSize=4;startSize=30;whiteSpace=wrap;html=0;fontSize=14;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="930" y="190" width="360" height="380" as="geometry"/></mxCell>
<mxCell id="proxy" value="iron-proxy (sandbox-proxy.service)&#xa;1. allowlist: any other host gets 403&#xa;2. ends the TLS with its own CA&#xa;3. swaps a placeholder for the real token&#xa;tunnel 127.0.0.1:18080" style="rounded=1;whiteSpace=wrap;html=0;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="950" y="240" width="320" height="120" as="geometry"/></mxCell>
<mxCell id="bridge" value="Socket unit and systemd-socket-proxyd&#xa;sandbox-bridge.socket" style="rounded=1;whiteSpace=wrap;html=0;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="950" y="440" width="320" height="90" as="geometry"/></mxCell>
<mxCell id="net" value="Allowed hosts&#xa;github.com, api.anthropic.com,&#xa;the Qwen endpoint, ghcr.io and&#xa;the rest of the allowlist" style="rounded=1;whiteSpace=wrap;html=0;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1390" y="255" width="240" height="100" as="geometry"/></mxCell>
<mxCell id="e1" value="runs Herdr" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=1;html=0;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;fontSize=12;strokeWidth=2;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="term" target="agent"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e2" value="HTTPS_PROXY 127.0.0.1:3128" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=1;html=0;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;fontSize=12;strokeWidth=2;strokeColor=#333333;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.6429;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="agent" target="relay"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e3" value="reads and writes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=1;html=0;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;fontSize=12;strokeWidth=2;strokeColor=#333333;exitX=0.125;exitY=1;exitDx=0;exitDy=0;entryX=0.125;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="agent" target="home"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e4" value="the only way out:&#xa;Unix socket proxy.sock&#xa;(read-only mount)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=1;html=0;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;fontSize=12;strokeWidth=3;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="relay" target="bridge"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e5" value="loopback TCP 18080" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=1;html=0;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;fontSize=12;strokeWidth=2;strokeColor=#333333;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="bridge" target="proxy"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e6" value="allowed&#xa;hosts only" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=1;html=0;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;fontSize=12;strokeWidth=2;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="proxy" target="net"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e7" value="real tokens at start (bws run)&#xa;access token: a systemd credential" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=1;html=0;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;fontSize=12;strokeWidth=2;strokeColor=#d79b00;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.875;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="bw" target="proxy"><mxGeometry x="-0.6" relative="1" as="geometry"/></mxCell>
<mxCell id="e8" value="mounts" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=1;html=0;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;fontSize=12;strokeWidth=2;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.7482;entryDx=0;entryDy=0;" edge="1" parent="1" source="ro" target="sbx"><mxGeometry relative="1" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>
