<mxCell id="prx" value="Proxy: iron-proxy container&lt;br&gt;&lt;small&gt;host uids 200000-265535&lt;/small&gt;" style="swimlane;rounded=1;arcSize=6;startSize=48;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=10;" vertex="1" parent="host"><mxGeometry x="760" y="46" width="280" height="400" as="geometry"/></mxCell>
<mxCell id="ports" value="&lt;b&gt;DNS :53, HTTP :80, HTTPS :443&lt;/b&gt;&lt;br&gt;&lt;small&gt;on 10.89.61.2 and 10.89.62.2&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="prx"><mxGeometry x="20" y="60" width="240" height="70" as="geometry"/></mxCell>
