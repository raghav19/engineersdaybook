<mxCell id="agent" value="&lt;b&gt;Agent tools&lt;/b&gt;&lt;br&gt;&lt;small&gt;Claude Code, Qwen Code, Herdr, TTT&lt;/small&gt;&lt;br&gt;&lt;small&gt;holds placeholders only&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="sbx"><mxGeometry x="20" y="60" width="270" height="96" as="geometry"/></mxCell>
<mxCell id="sshd" value="&lt;b&gt;sshd on port 2222&lt;/b&gt;&lt;br&gt;&lt;small&gt;key login, user agent only&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="sbx"><mxGeometry x="20" y="186" width="270" height="70" as="geometry"/></mxCell>
