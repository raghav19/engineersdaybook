<mxCell id="title" value="&lt;b&gt;Architecture of the Podman sandbox&lt;/b&gt;" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="1060" height="40" as="geometry"/></mxCell>
<mxCell id="bw" value="&lt;b&gt;Bitwarden project&lt;/b&gt;&lt;br&gt;&lt;small&gt;GH_TOKEN, CLAUDE_CODE_OAUTH_TOKEN, QWEN_API_KEY, GITHUB_TOKEN&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="760" y="60" width="280" height="76" as="geometry"/></mxCell>
<mxCell id="host" value="Host: rootless Podman, crun with krun" style="swimlane;rounded=1;arcSize=6;startSize=26;whiteSpace=wrap;html=1;fontSize=14;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="20" y="216" width="1060" height="560" as="geometry"/></mxCell>
<mxCell id="term" value="&lt;b&gt;Your terminal&lt;/b&gt;&lt;br&gt;&lt;small&gt;just sandbox run&lt;/small&gt;&lt;br&gt;&lt;small&gt;ssh to 127.0.0.1:2222&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="host"><mxGeometry x="20" y="222" width="240" height="90" as="geometry"/></mxCell>
<mxCell id="files" value="&lt;b&gt;Host files&lt;/b&gt;&lt;br&gt;&lt;small&gt;~/.ssh/id_ed25519.pub&lt;/small&gt;&lt;br&gt;&lt;small&gt;ca.crt (public certificate)&lt;/small&gt;&lt;br&gt;&lt;small&gt;.git folder of the repo&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="host"><mxGeometry x="20" y="350" width="240" height="150" as="geometry"/></mxCell>
