<mxfile host="app.diagrams.net"><diagram id="security-controls" name="security-controls"><mxGraphModel dx="1000" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1820" pageHeight="1320" background="#ffffff" math="0" shadow="0"><root>
<mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="title" value="Security controls of the agent sandbox" style="text;html=0;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="700" height="40" as="geometry"/></mxCell>
<mxCell id="sbx" value="Agent sandbox&#xa;rootless Podman" style="swimlane;rounded=1;arcSize=4;startSize=60;whiteSpace=wrap;html=0;fontSize=16;fillColor=#ffffff;strokeColor=#82b366;align=left;spacingLeft=10;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="580" height="510" as="geometry"/></mxCell>
<mxCell id="proxy" value="Host proxy container&#xa;rootless Podman" style="swimlane;rounded=1;arcSize=4;startSize=60;whiteSpace=wrap;html=0;fontSize=16;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=10;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1020" y="80" width="480" height="510" as="geometry"/></mxCell>
<mxCell id="bld" value="Builder (new for each session)&#xa;rootless Podman" style="swimlane;rounded=1;arcSize=4;startSize=60;whiteSpace=wrap;html=0;fontSize=16;fillColor=#ffffff;strokeColor=#82b366;align=left;spacingLeft=10;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="810" width="580" height="470" as="geometry"/></mxCell>
<mxCell id="bproxy" value="Builder proxy container&#xa;rootless Podman" style="swimlane;rounded=1;arcSize=4;startSize=60;whiteSpace=wrap;html=0;fontSize=16;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=10;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1020" y="810" width="480" height="378" as="geometry"/></mxCell>
<mxCell id="g_a" value="gVisor: userspace kernel" style="swimlane;rounded=1;arcSize=4;startSize=32;whiteSpace=wrap;html=0;fontSize=16;fillColor=#ffffff;strokeColor=#9673a6;align=left;spacingLeft=10;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="436" width="540" height="134" as="geometry"/></mxCell>
<mxCell id="g_b" value="gVisor: userspace kernel" style="swimlane;rounded=1;arcSize=4;startSize=32;whiteSpace=wrap;html=0;fontSize=16;fillColor=#ffffff;strokeColor=#9673a6;align=left;spacingLeft=10;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="880" width="540" height="134" as="geometry"/></mxCell>
<mxCell id="a2" value="No network device&#xa;The proxy socket is&#xa;the only way out" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="156" width="260" height="70" as="geometry"/></mxCell>
<mxCell id="a3" value="No root, no capability&#xa;user agent (a subuid),&#xa;no-new-privileges" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="320" y="156" width="260" height="70" as="geometry"/></mxCell>
<mxCell id="a4" value="Read-only root file system&#xa;tmpfs for /tmp and /run,&#xa;/etc/docker read-only" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="234" width="260" height="70" as="geometry"/></mxCell>
<mxCell id="a5" value="Read-only mounts&#xa;CA, proxy socket,&#xa;builder socket" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="320" y="234" width="260" height="70" as="geometry"/></mxCell>
<mxCell id="a6" value="Limits in the Quadlet service&#xa;3 GB, 4 CPUs, 2048 threads,&#xa;no swap" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="312" width="260" height="70" as="geometry"/></mxCell>
<mxCell id="a7" value="Private clone of the repo&#xa;Your .git is read-only:&#xa;no git hook for the agent" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="320" y="312" width="260" height="70" as="geometry"/></mxCell>
<mxCell id="agent" value="Agent tools&#xa;Claude, Qwen, Herdr, Fresh&#xa;hold placeholders only" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="480" width="250" height="76" as="geometry"/></mxCell>
<mxCell id="relay" value="socat relay&#xa;127.0.0.1:3128&#xa;to proxy.sock" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="400" y="480" width="160" height="76" as="geometry"/></mxCell>
<mxCell id="bk" value="BuildKit (buildkitd)&#xa;reached by docker over&#xa;buildkitd.sock" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="924" width="250" height="76" as="geometry"/></mxCell>
<mxCell id="brelay" value="socat relay&#xa;127.0.0.1:3129&#xa;to proxy.sock" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="400" y="924" width="160" height="76" as="geometry"/></mxCell>
<mxCell id="b2" value="No network device&#xa;The proxy socket is&#xa;the only way out" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="1034" width="260" height="70" as="geometry"/></mxCell>
<mxCell id="b3" value="No token, no secret&#xa;The builder holds&#xa;none" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="320" y="1034" width="260" height="70" as="geometry"/></mxCell>
<mxCell id="b4" value="Three capabilities&#xa;SETUID, SETGID, SYS_CHROOT,&#xa;no others" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="1112" width="260" height="70" as="geometry"/></mxCell>
<mxCell id="b5" value="Cache in memory&#xa;tmpfs of 1 GB, gone with&#xa;the session" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="320" y="1112" width="260" height="70" as="geometry"/></mxCell>
<mxCell id="b6" value="Limits in the Quadlet service&#xa;2 GB, 2 CPUs, 1024 threads,&#xa;no swap" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="1190" width="260" height="70" as="geometry"/></mxCell>
<mxCell id="sock" value="proxy.sock&#xa;one Unix socket,&#xa;the only way out" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="720" y="480" width="180" height="76" as="geometry"/></mxCell>
<mxCell id="bsock" value="proxy.sock&#xa;one Unix socket,&#xa;the only way out" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="720" y="924" width="180" height="76" as="geometry"/></mxCell>
<mxCell id="h1" value="Allowlist of hosts&#xa;Any other host&#xa;gets 403" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1040" y="156" width="215" height="70" as="geometry"/></mxCell>
<mxCell id="h2" value="Path rules&#xa;Write to one repo and&#xa;one ghcr.io namespace" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1265" y="156" width="215" height="70" as="geometry"/></mxCell>
<mxCell id="h3" value="TLS ended with its CA&#xa;ca.key stays here;&#xa;sandbox gets ca.crt" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1040" y="234" width="215" height="70" as="geometry"/></mxCell>
<mxCell id="h4" value="Token swap&#xa;Placeholder to real&#xa;token, listed hosts" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1265" y="234" width="215" height="70" as="geometry"/></mxCell>
<mxCell id="h5" value="Audit log&#xa;One JSON line for&#xa;each request" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1040" y="312" width="215" height="70" as="geometry"/></mxCell>
<mxCell id="h6" value="No root, no capability&#xa;Read-only root fs,&#xa;no-new-privileges" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1265" y="312" width="215" height="70" as="geometry"/></mxCell>
<mxCell id="h7" value="Limits in the service&#xa;512 MB, 512 threads,&#xa;no swap" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1040" y="390" width="215" height="70" as="geometry"/></mxCell>
<mxCell id="h8" value="Access token&#xa;systemd-creds, encrypted&#xa;not given to iron-proxy" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1265" y="390" width="215" height="70" as="geometry"/></mxCell>
<mxCell id="iron" value="iron-proxy&#xa;socat joins proxy.sock to&#xa;port 18080 in the container" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1040" y="480" width="440" height="76" as="geometry"/></mxCell>
<mxCell id="biron" value="iron-proxy&#xa;socat joins proxy.sock to&#xa;port 18080 in the container" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1040" y="924" width="440" height="76" as="geometry"/></mxCell>
<mxCell id="p1" value="Allowlist of host names&#xa;TLS passes through.&#xa;Other hosts get 403." style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1040" y="1020" width="215" height="70" as="geometry"/></mxCell>
<mxCell id="p2" value="No token, no CA&#xa;The proxy holds no&#xa;secret." style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1265" y="1020" width="215" height="70" as="geometry"/></mxCell>
