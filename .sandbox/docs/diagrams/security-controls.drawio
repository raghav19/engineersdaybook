<mxCell id="p4" value="Limits in the service&#xa;256 MB, 256 threads,&#xa;no swap" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1265" y="1098" width="215" height="70" as="geometry"/></mxCell>
