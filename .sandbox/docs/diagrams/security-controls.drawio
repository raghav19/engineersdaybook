<mxfile host="app.diagrams.net"><diagram id="security-controls" name="security-controls"><mxGraphModel dx="1000" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1130" background="#ffffff" math="0" shadow="0"><root>
<mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="title" value="Security controls of the agent sandbox" style="text;html=0;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="700" height="40" as="geometry"/></mxCell>
<mxCell id="sbx" value="Agent sandbox&#xa;rootless Podman, gVisor" style="swimlane;rounded=1;arcSize=4;startSize=60;whiteSpace=wrap;html=0;fontSize=16;fillColor=#ffffff;strokeColor=#82b366;align=left;spacingLeft=10;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="580" height="506" as="geometry"/></mxCell>
<mxCell id="bld" value="Builder (new for each session)&#xa;rootless Podman, gVisor" style="swimlane;rounded=1;arcSize=4;startSize=60;whiteSpace=wrap;html=0;fontSize=16;fillColor=#ffffff;strokeColor=#82b366;align=left;spacingLeft=10;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="666" width="580" height="428" as="geometry"/></mxCell>
<mxCell id="proxy" value="Host proxy container&#xa;rootless Podman" style="swimlane;rounded=1;arcSize=4;startSize=60;whiteSpace=wrap;html=0;fontSize=16;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=10;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1020" y="80" width="480" height="506" as="geometry"/></mxCell>
<mxCell id="bproxy" value="Builder proxy container&#xa;rootless Podman" style="swimlane;rounded=1;arcSize=4;startSize=60;whiteSpace=wrap;html=0;fontSize=16;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=10;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1020" y="666" width="480" height="350" as="geometry"/></mxCell>
<mxCell id="agent" value="Agent tools&#xa;Claude, Qwen, Herdr, Fresh&#xa;hold placeholders only" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="156" width="250" height="76" as="geometry"/></mxCell>
<mxCell id="relay" value="socat relay&#xa;127.0.0.1:3128&#xa;to proxy.sock" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="380" y="156" width="200" height="76" as="geometry"/></mxCell>
<mxCell id="a1" value="gVisor&#xa;Syscalls go to gVisor,&#xa;not to the host kernel" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="262" width="260" height="70" as="geometry"/></mxCell>
<mxCell id="a2" value="No network device&#xa;The proxy socket is&#xa;the only way out" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="320" y="262" width="260" height="70" as="geometry"/></mxCell>
<mxCell id="a3" value="No root, no capability&#xa;user agent (a subuid),&#xa;no-new-privileges" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="260" height="70" as="geometry"/></mxCell>
<mxCell id="a4" value="Read-only root file system&#xa;tmpfs for /tmp and /run,&#xa;/etc/docker read-only" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="320" y="340" width="260" height="70" as="geometry"/></mxCell>
<mxCell id="a5" value="Read-only mounts&#xa;CA, proxy socket,&#xa;builder socket" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="418" width="260" height="70" as="geometry"/></mxCell>
<mxCell id="a6" value="Limits in the Quadlet service&#xa;3 GB, 4 CPUs, 2048 threads,&#xa;no swap" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="320" y="418" width="260" height="70" as="geometry"/></mxCell>
<mxCell id="a7" value="Private clone of the repo&#xa;Your .git is read-only. The agent&#xa;cannot plant a git hook." style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="496" width="540" height="70" as="geometry"/></mxCell>
<mxCell id="bk" value="BuildKit (buildkitd)&#xa;runs the build steps&#xa;of the agent" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="742" width="250" height="76" as="geometry"/></mxCell>
<mxCell id="brelay" value="socat relay&#xa;127.0.0.1:3129&#xa;to proxy.sock" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="380" y="742" width="200" height="76" as="geometry"/></mxCell>
<mxCell id="b1" value="gVisor&#xa;Syscalls go to gVisor,&#xa;not to the host kernel" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="848" width="260" height="70" as="geometry"/></mxCell>
<mxCell id="b2" value="No network device&#xa;The proxy socket is&#xa;the only way out" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="320" y="848" width="260" height="70" as="geometry"/></mxCell>
<mxCell id="b3" value="No token, no secret&#xa;The builder holds&#xa;none" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="926" width="260" height="70" as="geometry"/></mxCell>
<mxCell id="b4" value="Three capabilities&#xa;SETUID, SETGID, SYS_CHROOT,&#xa;no others" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="320" y="926" width="260" height="70" as="geometry"/></mxCell>
<mxCell id="b5" value="Cache in memory&#xa;tmpfs of 1 GB, gone with&#xa;the session" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="1004" width="260" height="70" as="geometry"/></mxCell>
<mxCell id="b6" value="Limits in the Quadlet service&#xa;2 GB, 2 CPUs, 1024 threads,&#xa;no swap" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="320" y="1004" width="260" height="70" as="geometry"/></mxCell>
<mxCell id="sock" value="proxy.sock&#xa;one Unix socket,&#xa;the only way out" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="720" y="156" width="180" height="76" as="geometry"/></mxCell>
<mxCell id="bsock" value="proxy.sock&#xa;one Unix socket,&#xa;the only way out" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="720" y="742" width="180" height="76" as="geometry"/></mxCell>
<mxCell id="iron" value="iron-proxy&#xa;socat joins proxy.sock to&#xa;port 18080 in the container" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1040" y="156" width="440" height="76" as="geometry"/></mxCell>
<mxCell id="h1" value="Allowlist of hosts&#xa;Any other host&#xa;gets 403" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1040" y="262" width="215" height="70" as="geometry"/></mxCell>
<mxCell id="h2" value="Path rules&#xa;Write to one repo and&#xa;one ghcr.io namespace" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1265" y="262" width="215" height="70" as="geometry"/></mxCell>
<mxCell id="h3" value="TLS ended with its CA&#xa;ca.key stays here;&#xa;sandbox gets ca.crt" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1040" y="340" width="215" height="70" as="geometry"/></mxCell>
<mxCell id="h4" value="Token swap&#xa;Placeholder to real&#xa;token, listed hosts" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1265" y="340" width="215" height="70" as="geometry"/></mxCell>
<mxCell id="h5" value="Audit log&#xa;One JSON line for&#xa;each request" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1040" y="418" width="215" height="70" as="geometry"/></mxCell>
<mxCell id="h6" value="No root, no capability&#xa;Read-only root fs,&#xa;no-new-privileges" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1265" y="418" width="215" height="70" as="geometry"/></mxCell>
<mxCell id="h7" value="Limits in the service&#xa;512 MB, 512 threads,&#xa;no swap" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1040" y="496" width="215" height="70" as="geometry"/></mxCell>
<mxCell id="h8" value="Access token&#xa;systemd-creds, encrypted&#xa;not given to iron-proxy" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1265" y="496" width="215" height="70" as="geometry"/></mxCell>
<mxCell id="biron" value="iron-proxy&#xa;socat joins proxy.sock to&#xa;port 18080 in the container" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1040" y="742" width="440" height="76" as="geometry"/></mxCell>
<mxCell id="p1" value="Allowlist of host names&#xa;TLS passes through.&#xa;Other hosts get 403." style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1040" y="848" width="215" height="70" as="geometry"/></mxCell>
<mxCell id="p2" value="No token, no CA&#xa;The proxy holds no&#xa;secret." style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1265" y="848" width="215" height="70" as="geometry"/></mxCell>
<mxCell id="p3" value="No root, no capability&#xa;Read-only root fs,&#xa;no-new-privileges" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1040" y="926" width="215" height="70" as="geometry"/></mxCell>
<mxCell id="p4" value="Limits in the service&#xa;256 MB, 256 threads,&#xa;no swap" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1265" y="926" width="215" height="70" as="geometry"/></mxCell>
<mxCell id="bw" value="Bitwarden&#xa;Secrets Manager" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1620" y="60" width="160" height="70" as="geometry"/></mxCell>
