<mxfile host="app.diagrams.net"><diagram id="network-flow" name="network-flow"><mxGraphModel adaptiveColors="auto" dx="1000" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="700" math="0" shadow="0"><root>
<mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="title" value="&lt;b&gt;Network flow of one request&lt;/b&gt;" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="1060" height="40" as="geometry"/></mxCell>
<mxCell id="l_sbx" value="Sandbox (no network)" style="swimlane;rounded=1;arcSize=6;startSize=30;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffffff;strokeColor=#82b366;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="260" height="580" as="geometry"/></mxCell>
<mxCell id="agent" value="&lt;b&gt;Agent&lt;/b&gt;&lt;br&gt;&lt;small&gt;calls api.github.com&lt;/small&gt;&lt;br&gt;&lt;small&gt;sends a placeholder in the Authorization header&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="l_sbx"><mxGeometry x="20" y="50" width="220" height="110" as="geometry"/></mxCell>
<mxCell id="relay" value="&lt;b&gt;1  Relay (socat)&lt;/b&gt;&lt;br&gt;&lt;small&gt;HTTPS_PROXY is 127.0.0.1:3128. The relay copies the bytes to the socket.&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="l_sbx"><mxGeometry x="20" y="200" width="220" height="110" as="geometry"/></mxCell>
<mxCell id="block" value="&lt;b&gt;No other route&lt;/b&gt;&lt;br&gt;&lt;small&gt;the only interface is lo&lt;/small&gt;&lt;br&gt;&lt;small&gt;a direct connection fails&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="l_sbx"><mxGeometry x="20" y="420" width="220" height="110" as="geometry"/></mxCell>
<mxCell id="l_host" value="Host" style="swimlane;rounded=1;arcSize=6;startSize=30;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="460" y="60" width="320" height="580" as="geometry"/></mxCell>
<mxCell id="p2" value="&lt;b&gt;2  Bridge (socat)&lt;/b&gt;&lt;br&gt;&lt;small&gt;Unix socket to 127.0.0.1:1080&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="l_host"><mxGeometry x="20" y="50" width="280" height="60" as="geometry"/></mxCell>
<mxCell id="p3" value="&lt;b&gt;3  Ends the TLS&lt;/b&gt;&lt;br&gt;&lt;small&gt;iron-proxy, with its own CA. The sandbox trusts ca.crt.&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="l_host"><mxGeometry x="20" y="140" width="280" height="70" as="geometry"/></mxCell>
<mxCell id="p4" value="&lt;b&gt;4  Checks the allowlist&lt;/b&gt;&lt;br&gt;&lt;small&gt;a host that is not listed gets 403&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="l_host"><mxGeometry x="20" y="240" width="280" height="70" as="geometry"/></mxCell>
<mxCell id="p5" value="&lt;b&gt;5  Swaps the placeholder&lt;/b&gt;&lt;br&gt;&lt;small&gt;real token, only for the hosts of its rule&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="l_host"><mxGeometry x="20" y="340" width="280" height="80" as="geometry"/></mxCell>
<mxCell id="p7" value="&lt;b&gt;7  Sends the response&lt;/b&gt;&lt;br&gt;&lt;small&gt;back through the socket to the sandbox&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="l_host"><mxGeometry x="20" y="450" width="280" height="60" as="geometry"/></mxCell>
<mxCell id="l_net" value="Allowed host" style="swimlane;rounded=1;arcSize=6;startSize=30;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffffff;strokeColor=#666666;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="900" y="60" width="180" height="580" as="geometry"/></mxCell>
<mxCell id="real" value="&lt;b&gt;api.github.com&lt;/b&gt;&lt;br&gt;&lt;small&gt;sees the real token&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="l_net"><mxGeometry x="10" y="340" width="160" height="80" as="geometry"/></mxCell>
<mxCell id="f0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=1;html=1;labelBackgroundColor=default;fontSize=12;strokeWidth=2;strokeColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="agent" target="relay"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f1" value="Unix socket" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=1;html=1;labelBackgroundColor=default;fontSize=12;strokeWidth=2;strokeColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="relay" target="p2"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=1;html=1;labelBackgroundColor=default;fontSize=12;strokeWidth=2;strokeColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p2" target="p3"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=1;html=1;labelBackgroundColor=default;fontSize=12;strokeWidth=2;strokeColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p3" target="p4"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=1;html=1;labelBackgroundColor=default;fontSize=12;strokeWidth=2;strokeColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p4" target="p5"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f6" value="6  real token" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=1;html=1;labelBackgroundColor=default;fontSize=12;strokeWidth=2;strokeColor=#d79b00;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p5" target="real"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=1;html=1;labelBackgroundColor=default;fontSize=12;strokeWidth=2;strokeColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p5" target="p7"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f8" value="response" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=1;html=1;labelBackgroundColor=default;fontSize=12;strokeWidth=2;strokeColor=#333333;dashed=1;exitX=0;exitY=0.5;entryX=1;entryY=0.9;" edge="1" parent="1" source="p7" target="agent"><mxGeometry relative="1" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>
