<mxfile host="app.diagrams.net"><diagram id="network-flow" name="network-flow"><mxGraphModel adaptiveColors="auto" dx="1000" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="640" math="0" shadow="0"><root>
<mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="title" value="&lt;b&gt;Network flow of one request&lt;/b&gt;" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="1060" height="40" as="geometry"/></mxCell>
<mxCell id="l_sbx" value="Sandbox" style="swimlane;rounded=1;arcSize=6;startSize=30;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffffff;strokeColor=#82b366;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="260" height="520" as="geometry"/></mxCell>
<mxCell id="agent" value="&lt;b&gt;Agent&lt;/b&gt;&lt;br&gt;&lt;small&gt;calls api.github.com&lt;/small&gt;&lt;br&gt;&lt;small&gt;sends a placeholder in the Authorization header&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="l_sbx"><mxGeometry x="20" y="50" width="220" height="110" as="geometry"/></mxCell>
<mxCell id="block" value="&lt;b&gt;No other route&lt;/b&gt;&lt;br&gt;&lt;small&gt;a direct connection to an IP address fails&lt;/small&gt;&lt;br&gt;&lt;small&gt;DNS to a public resolver fails&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="l_sbx"><mxGeometry x="20" y="380" width="220" height="110" as="geometry"/></mxCell>
<mxCell id="l_prx" value="Proxy" style="swimlane;rounded=1;arcSize=6;startSize=30;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="480" y="60" width="300" height="520" as="geometry"/></mxCell>
<mxCell id="p_in" value="&lt;b&gt;Receives the request&lt;/b&gt;&lt;br&gt;&lt;small&gt;on 10.89.61.2, answers DNS with its own address&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="l_prx"><mxGeometry x="20" y="50" width="260" height="70" as="geometry"/></mxCell>
<mxCell id="p3" value="&lt;b&gt;3  Ends the TLS&lt;/b&gt;&lt;br&gt;&lt;small&gt;with its own CA. The sandbox trusts ca.crt.&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="l_prx"><mxGeometry x="20" y="150" width="260" height="70" as="geometry"/></mxCell>
<mxCell id="p4" value="&lt;b&gt;4  Checks the allowlist&lt;/b&gt;&lt;br&gt;&lt;small&gt;a host that is not listed gets 403&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="l_prx"><mxGeometry x="20" y="250" width="260" height="70" as="geometry"/></mxCell>
<mxCell id="p5" value="&lt;b&gt;5  Swaps the placeholder&lt;/b&gt;&lt;br&gt;&lt;small&gt;real token, only for the hosts of its rule&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="l_prx"><mxGeometry x="20" y="350" width="260" height="80" as="geometry"/></mxCell>
<mxCell id="p7" value="&lt;b&gt;7  Sends the response&lt;/b&gt;&lt;br&gt;&lt;small&gt;back to the sandbox&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="l_prx"><mxGeometry x="20" y="450" width="260" height="50" as="geometry"/></mxCell>
<mxCell id="l_net" value="Allowed host" style="swimlane;rounded=1;arcSize=6;startSize=30;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffffff;strokeColor=#666666;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="900" y="60" width="180" height="520" as="geometry"/></mxCell>
<mxCell id="real" value="&lt;b&gt;api.github.com&lt;/b&gt;&lt;br&gt;&lt;small&gt;sees the real token&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="l_net"><mxGeometry x="10" y="350" width="160" height="80" as="geometry"/></mxCell>
<mxCell id="f1" value="1  DNS query" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=1;html=1;labelBackgroundColor=default;fontSize=12;strokeWidth=2;strokeColor=#333333;exitX=1;exitY=0.2;entryX=0;entryY=0.2;" edge="1" parent="1" source="agent" target="p_in"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f2" value="2  HTTPS, placeholder" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=1;html=1;labelBackgroundColor=default;fontSize=12;strokeWidth=2;strokeColor=#333333;exitX=1;exitY=0.55;entryX=0;entryY=0.7;" edge="1" parent="1" source="agent" target="p_in"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=1;html=1;labelBackgroundColor=default;fontSize=12;strokeWidth=2;strokeColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p_in" target="p3"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=1;html=1;labelBackgroundColor=default;fontSize=12;strokeWidth=2;strokeColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p3" target="p4"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=1;html=1;labelBackgroundColor=default;fontSize=12;strokeWidth=2;strokeColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p4" target="p5"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f6" value="6  real token&lt;br&gt;outer network" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=1;html=1;labelBackgroundColor=default;fontSize=12;strokeWidth=2;strokeColor=#d79b00;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p5" target="real"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=1;html=1;labelBackgroundColor=default;fontSize=12;strokeWidth=2;strokeColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p5" target="p7"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f8" value="response" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=1;html=1;labelBackgroundColor=default;fontSize=12;strokeWidth=2;strokeColor=#333333;dashed=1;exitX=0;exitY=0.5;entryX=1;entryY=0.9;" edge="1" parent="1" source="p7" target="agent"><mxGeometry relative="1" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>
