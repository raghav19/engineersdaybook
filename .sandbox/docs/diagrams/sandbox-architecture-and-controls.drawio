<mxCell id="sec-pbox" value="Agent proxy&#10;rootless Podman, no gVisor" style="rounded=1;arcSize=4;container=1;collapsible=0;whiteSpace=wrap;html=0;fontSize=16;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;align=left;spacingLeft=10;fontStyle=3;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1180" y="1060" width="580" height="568" as="geometry"/></mxCell>
