<mxCell id="sec-pc0" value="&lt;b&gt;Allowlist of hosts&lt;/b&gt;&lt;br&gt;Other hosts get 403" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1200" y="1130" width="260" height="60" as="geometry"/></mxCell>
<mxCell id="sec-pc1" value="&lt;b&gt;Method and path rules&lt;/b&gt;&lt;br&gt;Writes go to one repo and&lt;br&gt;one ghcr.io namespace" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1480" y="1130" width="260" height="60" as="geometry"/></mxCell>
<mxCell id="sec-pc2" value="&lt;b&gt;TLS termination&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1200" y="1200" width="260" height="60" as="geometry"/></mxCell>
<mxCell id="sec-pc3" value="&lt;b&gt;Token swap&lt;/b&gt;&lt;br&gt;Placeholder becomes the real&lt;br&gt;token, for listed hosts only" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1480" y="1200" width="260" height="60" as="geometry"/></mxCell>
<mxCell id="sec-pc4" value="&lt;b&gt;Audit log&lt;/b&gt;&lt;br&gt;One JSON line per request" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1200" y="1270" width="260" height="60" as="geometry"/></mxCell>
<mxCell id="sec-pc5" value="&lt;b&gt;Encrypted access token&lt;/b&gt;&lt;br&gt;Not given to iron-proxy" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1480" y="1270" width="260" height="60" as="geometry"/></mxCell>
<mxCell id="sec-pc6" value="&lt;b&gt;Hardened container&lt;/b&gt;&lt;br&gt;No capability or new privilege&lt;br&gt;Read-only root file system" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1200" y="1340" width="260" height="60" as="geometry"/></mxCell>
<mxCell id="sec-pc7" value="&lt;b&gt;Limits (Quadlet service)&lt;/b&gt;&lt;br&gt;512 MB, 512 threads" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1480" y="1340" width="260" height="60" as="geometry"/></mxCell>
<mxCell id="sec-pc8" value="&lt;b&gt;Wiped when the session ends&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1200" y="1410" width="260" height="60" as="geometry"/></mxCell>
<mxCell id="sec-piron" value="iron-proxy&#10;the egress proxy" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1530" y="1531" width="210" height="66" as="geometry"/></mxCell>
