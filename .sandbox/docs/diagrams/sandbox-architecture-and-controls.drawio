<mxCell id="sec-qc0" value="&lt;b&gt;Allowlist of host names&lt;/b&gt;&lt;br&gt;Other hosts get 403" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1200" y="1996" width="260" height="60" as="geometry"/></mxCell>
<mxCell id="sec-qc1" value="&lt;b&gt;TLS passthrough&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1480" y="1996" width="260" height="60" as="geometry"/></mxCell>
<mxCell id="sec-qc2" value="&lt;b&gt;No URL path rules&lt;/b&gt;&lt;br&gt;The proxy sees the host name&lt;br&gt;only. It does not decrypt TLS." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1200" y="2066" width="260" height="60" as="geometry"/></mxCell>
<mxCell id="sec-qc3" value="&lt;b&gt;Hardened container&lt;/b&gt;&lt;br&gt;No capability or new privilege&lt;br&gt;Read-only root file system" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1480" y="2066" width="260" height="60" as="geometry"/></mxCell>
<mxCell id="sec-qc4" value="&lt;b&gt;Limits (Quadlet service)&lt;/b&gt;&lt;br&gt;256 MB, 256 threads" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1200" y="2136" width="260" height="60" as="geometry"/></mxCell>
<mxCell id="sec-qc5" value="&lt;b&gt;Wiped when the session ends&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1480" y="2136" width="260" height="60" as="geometry"/></mxCell>
