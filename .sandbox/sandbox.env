# The environment of the sandbox containers. The values are not secrets.
# The placeholders: the proxy swaps in the real tokens. They must equal the proxy_value lines of the proxy config.
GH_TOKEN=sandbox-placeholder-GH_TOKEN
CLAUDE_CODE_OAUTH_TOKEN=sandbox-placeholder-CLAUDE_CODE_OAUTH_TOKEN
QWEN_API_KEY=sandbox-placeholder-QWEN_API_KEY
GHCR_PUSH_TOKEN=sandbox-placeholder-GHCR_PUSH_TOKEN
# The relay in sandbox-entry listens here. A tool that ignores these variables has no route.
HTTP_PROXY=http://127.0.0.1:3128
HTTPS_PROXY=http://127.0.0.1:3128
http_proxy=http://127.0.0.1:3128
https_proxy=http://127.0.0.1:3128
NO_PROXY=localhost,127.0.0.1
NODE_USE_ENV_PROXY=1
# The CA of the proxy is a read-only mount over this file. Each tool needs to read it.
SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
GIT_SSL_CAINFO=/etc/ssl/certs/ca-certificates.crt
NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt
NODE_OPTIONS=--use-system-ca
HOME=/home/agent
TMPDIR=/tmp
COLORTERM=truecolor
SANDBOX_WORKSPACE=/home/agent/engineersdaybook
REPO_URL=https://github.com/raghav19/engineersdaybook
GIT_AUTHOR_NAME=agent
GIT_COMMITTER_NAME=agent
GIT_AUTHOR_EMAIL=agent@localhost
GIT_COMMITTER_EMAIL=agent@localhost
MISE_TRUSTED_CONFIG_PATHS=/home/agent/engineersdaybook
MISE_IGNORED_CONFIG_PATHS=/home/agent/engineersdaybook/mise.toml
CLAUDE_CONFIG_DIR=/home/agent/.claude
DISABLE_UPDATES=1
HEADROOM_HARD_WATCHDOG_SECS=0
