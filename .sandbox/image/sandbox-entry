#!/bin/sh
# The command of the sandbox container. It starts as root in the krun microVM, because krun has no `podman exec`.
# It makes three things ready for Podman inside the sandbox (nested Podman). Then it drops to the user agent and runs your command.
# Example: sandbox-entry bash --login -i
# If a step fails, the script prints the reason and exits with 1.
set -eu

fail() { echo "sandbox-entry: $*" >&2; exit 1; }

[ "$(id -u)" = 0 ] || fail "run as root"
[ "$#" -gt 0 ] || fail "give a command to run"

# 1. Where nested Podman keeps its images.
#    The disk of a krun microVM is a virtiofs share of the host. The overlay driver of Podman cannot use it:
#    "unable to create kernel-style whiteout". A volume, a tmpfs and the vfs driver fail on the same limit.
#    The overlay driver does work on an ext4 file system. So the entry makes a sparse file, formats it as ext4
#    and mounts it with a loop device on the folder where Podman keeps its images.
#    Make /var/lib/sandbox a named volume to keep the images after you remove the container.
storage_dir=/home/agent/.local/share/containers
storage_img=/var/lib/sandbox/podman-storage.img
mkdir -p /var/lib/sandbox "$storage_dir" || fail "could not make the folders of the storage"
if [ ! -f "$storage_img" ]; then
  truncate -s 20G "$storage_img" && mkfs.ext4 -q -F "$storage_img" || fail "could not make $storage_img"
fi
mount -o loop "$storage_img" "$storage_dir" || fail "could not mount $storage_img on $storage_dir"
chown agent:agent "$storage_dir" || fail "could not give $storage_dir to agent"

# 2. The network of a nested container.
#    Podman uses pasta, and pasta opens /dev/net/tun. The kernel makes it for root only. Give it to the group agent.
chgrp agent /dev/net/tun && chmod 660 /dev/net/tun || fail "could not open /dev/net/tun for podman"

# 3. Trust the CA of the egress proxy.
#    The proxy ends the TLS with its own CA. The compose file mounts the public part of it. Add it to the trust store of the sandbox.
#    Nested containers get the same trust store (configs/containers/containers.conf).
if [ -f /usr/local/share/ca-certificates/sandbox-proxy.crt ]; then
  update-ca-certificates >/dev/null || fail "update-ca-certificates failed"
fi

# The host can pass its NOTIFY_SOCKET. A nested podman then tries to notify the host service manager and fails.
unset NOTIFY_SOCKET

exec setpriv --reuid=agent --regid=agent --init-groups --inh-caps=-all env HOME=/home/agent "$@"
