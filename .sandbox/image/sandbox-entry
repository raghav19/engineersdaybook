#!/bin/sh
# The command of the sandbox container. It starts the relay to the egress proxy, then it runs your command.
# Example: sandbox-entry bash --login -i
# The container starts as the user agent. sandbox.container gives the container no capability.
# If a step fails, the script prints the reason and exits with 1.
set -eu

fail() { echo "sandbox-entry: $*" >&2; exit 1; }

[ "$(id -u)" != 0 ] || fail "run as the user agent, not as root"
[ "$#" -gt 0 ] || fail "give a command to run"

# The host can pass its NOTIFY_SOCKET. A tool in the sandbox then tries to notify the host service manager and fails.
unset NOTIFY_SOCKET

# The relay to the proxy.
#   The sandbox has no network. The proxy on the host listens on a Unix socket that sandbox.container mounts at /run/sandbox/proxy/proxy.sock.
#   The socket has the mode 0666, so the user agent opens it. Only you and the containers that mount the folder reach it.
#   The relay listens on 127.0.0.1:3128 and copies the bytes to the socket. HTTPS_PROXY points at it.
#   The relay starts only when the entry is the first process of the container. A `podman exec` session finds the relay already running.
sock=/run/sandbox/proxy/proxy.sock
if [ "$$" != 1 ]; then
  :
elif [ -S "$sock" ]; then
  socat TCP-LISTEN:3128,bind=127.0.0.1,fork,reuseaddr UNIX-CONNECT:"$sock" &
else
  echo "sandbox-entry: no proxy socket at $sock. The sandbox has no way out." >&2
fi

exec "$@"
