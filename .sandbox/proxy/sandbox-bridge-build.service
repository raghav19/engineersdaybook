# Joins the socket of sandbox-bridge-build.socket to the tunnel of the build proxy. systemd starts it at the first connection.
[Unit]
Description=Bridge from the builder socket to the build proxy
Requires=sandbox-proxy-build.service
After=sandbox-proxy-build.service

[Service]
ExecStart=/usr/lib/systemd/systemd-socket-proxyd 127.0.0.1:18085
NoNewPrivileges=yes
PrivateTmp=yes
