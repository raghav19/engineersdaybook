# Joins the socket of sandbox-builder-proxy-bridge.socket to the tunnel of the builder proxy. systemd starts it at the first connection.
[Unit]
Description=Bridge from the builder socket to the builder proxy
Requires=sandbox-builder-proxy.service
After=sandbox-builder-proxy.service

[Service]
ExecStart=/usr/lib/systemd/systemd-socket-proxyd 127.0.0.1:18085
NoNewPrivileges=yes
PrivateTmp=yes
