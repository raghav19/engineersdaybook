# iron-proxy, the only way out of the sandbox. Run `just sandbox setup` to install it. See README.md in this folder.
# bws run gives the real tokens to the proxy. The Bitwarden access token comes from the systemd credential bws-token,
# so it is not in this file and not in the arguments.
[Unit]
Description=iron-proxy: egress proxy of the sandbox
# Wants= starts the socket of the bridge with the proxy. The socket has PartOf=, so a stop or a restart of the proxy reaches it.
Wants=sandbox-bridge.socket

[Service]
WorkingDirectory=%h/.local/state/sandbox
# No path: the user manager reads ~/.config/credstore.encrypted/bws-token. just sandbox setup makes the file.
LoadCredentialEncrypted=bws-token
# systemd starts this unit, not your shell, so mise is not active here. just sandbox setup links bws and iron-proxy into ~/.config/sandbox/bin.
# systemd decrypts the credential to a file. bws reads its token only from the variable BWS_ACCESS_TOKEN, so the shell copies the file into the variable.
Environment=PATH=%h/.config/sandbox/bin:/usr/bin:/bin
# Go reads SSL_CERT_FILE for its trust roots. The file has the system CAs and the CA of each cluster, so the proxy trusts the clusters. Only the proxy uses it.
Environment=SSL_CERT_FILE=%h/.local/state/sandbox/upstream-ca.pem
ExecStart=/bin/sh -c 'BWS_ACCESS_TOKEN="$(cat "$CREDENTIALS_DIRECTORY/bws-token")" exec bws run -- env -u BWS_ACCESS_TOKEN iron-proxy -config %E/sandbox/iron-proxy.yaml'
Restart=on-failure
# Hardening. README.md in this folder says what each line does. Check the score: systemd-analyze --user security sandbox-proxy.service
NoNewPrivileges=yes
PrivateTmp=yes
# The proxy sees an empty /home and the files below. For a new file, add a BindReadOnlyPaths= line.
ProtectHome=tmpfs
BindReadOnlyPaths=%E/sandbox/iron-proxy.yaml
BindReadOnlyPaths=%h/.local/state/sandbox/ca.crt %h/.local/state/sandbox/ca.key
BindReadOnlyPaths=%h/.local/state/sandbox/upstream-ca.pem %h/.local/state/sandbox/tokens
# The hosts file of the proxy. It maps kubernetes.default.svc to k3s. The proxy sees no other hosts file.
BindReadOnlyPaths=%E/sandbox/hosts:/etc/hosts
BindReadOnlyPaths=%h/.local/share/mise %h/.config/sandbox/bin
SystemCallFilter=@system-service
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes

[Install]
WantedBy=default.target
