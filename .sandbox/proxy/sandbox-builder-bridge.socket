# The Unix socket that the builder mounts. It is in its own folder, so the builder cannot see proxy.sock of the sandbox.
# The builder is a subuid in rootless Podman, so the socket needs the mode 0666. $XDG_RUNTIME_DIR has the mode 0700.
[Unit]
Description=Socket of the builder proxy bridge
PartOf=sandbox-builder-proxy.service

[Socket]
ListenStream=%t/sandbox-builder-proxy/proxy.sock
SocketMode=0666
DirectoryMode=0711
RemoveOnStop=yes
ExecStartPost=/usr/bin/chmod 0711 %t/sandbox-builder-proxy
