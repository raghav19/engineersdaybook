# Only one user may connect to the loopback ports of the sandbox proxy and of the build proxy.
# A TCP or UDP port on 127.0.0.1 has no check of the user, so any local user could use the proxies and the real tokens of the sandbox proxy.
# `just sandbox setup` replaces @UID@ with your user id and loads this file with sandbox-guard.service.
# The bridge (systemd-socket-proxyd) runs as you, so it still connects. A program of another user gets a refusal.
# One clause for each protocol, as in iron-proxy.yaml and iron-proxy-build.yaml.
# TCP: 18080 to 18083 (sandbox proxy) and 18085 to 18088 (build proxy). UDP: 18084 and 18089 (the DNS listeners).
# The proxies reserve 18080 to 18089. If you add a listener in that range, add it to the right clause here.
table inet sandbox_guard
delete table inet sandbox_guard
table inet sandbox_guard {
    chain output {
        type filter hook output priority 0; policy accept;
        ip daddr 127.0.0.1 tcp dport { 18080-18083, 18085-18088 } meta skuid != @UID@ reject
        ip daddr 127.0.0.1 udp dport { 18084, 18089 } meta skuid != @UID@ reject
    }
}
