# The build proxy for the builder. It holds no token, so it needs no credential and no bws.
# `just sandbox setup` links this file with systemctl --user link.
[Unit]
Description=iron-proxy: build proxy of the sandbox builder (host names only, no tokens)
Wants=sandbox-bridge-build.socket

[Service]
Environment=PATH=%h/.config/sandbox/bin:/usr/bin:/bin
ExecStart=%h/.config/sandbox/bin/iron-proxy -config %E/sandbox/iron-proxy-build.yaml
Restart=on-failure
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=tmpfs
BindReadOnlyPaths=%E/sandbox/iron-proxy-build.yaml
BindReadOnlyPaths=%h/.local/share/mise %h/.config/sandbox/bin
SystemCallFilter=@system-service
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes

[Install]
WantedBy=default.target
