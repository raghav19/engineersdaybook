<mxCell id="title" value="&lt;b&gt;Agent workload identity of the microVM&lt;/b&gt;" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="1060" height="40" as="geometry"/></mxCell>
<mxCell id="l_cluster" value="k3s cluster" style="swimlane;rounded=1;arcSize=6;startSize=26;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;html=1;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="1060" height="162" as="geometry"/></mxCell>
<mxCell id="entries" value="&lt;b&gt;Registration entries&lt;/b&gt;&lt;br&gt;&lt;small&gt;node entry sandbox-dev (exists)&lt;/small&gt;&lt;br&gt;&lt;small&gt;delegate entry (not built)&lt;/small&gt;&lt;br&gt;&lt;small&gt;VM entry: msbvm:name, unix:uid (not built)&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="l_cluster"><mxGeometry x="20" y="46" width="470" height="96" as="geometry"/></mxCell>
<mxCell id="srv" value="&lt;b&gt;SPIRE server&lt;/b&gt;&lt;br&gt;&lt;small&gt;trust domain mcp.local&lt;/small&gt;&lt;br&gt;&lt;small&gt;NodeAttestor x509pop&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="l_cluster"><mxGeometry x="700" y="46" width="340" height="96" as="geometry"/></mxCell>
<mxCell id="l_host" value="Host" style="swimlane;rounded=1;arcSize=6;startSize=26;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;html=1;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="20" y="292" width="1060" height="446" as="geometry"/></mxCell>
<mxCell id="agent" value="Host SPIRE agent" style="swimlane;rounded=1;arcSize=6;startSize=30;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=10;" vertex="1" parent="l_host"><mxGeometry x="20" y="46" width="1020" height="156" as="geometry"/></mxCell>
<mxCell id="api" value="&lt;b&gt;Delegated Identity API&lt;/b&gt;&lt;br&gt;&lt;small&gt;on admin.sock&lt;/small&gt;&lt;br&gt;&lt;small&gt;checks authorized_delegates&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="agent"><mxGeometry x="20" y="46" width="300" height="90" as="geometry"/></mxCell>
<mxCell id="msbvm" value="&lt;b&gt;msbvm plugin&lt;/b&gt;&lt;br&gt;&lt;small&gt;pid to VM name and sandbox ID&lt;/small&gt;&lt;br&gt;&lt;small&gt;checks the command line and the run row&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="agent"><mxGeometry x="350" y="46" width="300" height="90" as="geometry"/></mxCell>
<mxCell id="unix" value="&lt;b&gt;unix attestor&lt;/b&gt;&lt;br&gt;&lt;small&gt;pid to uid&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="agent"><mxGeometry x="680" y="46" width="300" height="90" as="geometry"/></mxCell>
<mxCell id="delegate" value="&lt;b&gt;Delegate&lt;/b&gt;&lt;br&gt;&lt;small&gt;sends the pid of the VMM&lt;/small&gt;&lt;br&gt;&lt;small&gt;holds the SVID and the key&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="l_host"><mxGeometry x="40" y="282" width="300" height="90" as="geometry"/></mxCell>
<mxCell id="vmm" value="VMM: msb machine" style="swimlane;rounded=1;arcSize=6;startSize=30;whiteSpace=wrap;html=1;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;" vertex="1" parent="l_host"><mxGeometry x="380" y="282" width="330" height="140" as="geometry"/></mxCell>
<mxCell id="vm" value="&lt;b&gt;microVM&lt;/b&gt;&lt;br&gt;&lt;small&gt;holds no key and no socket&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="vmm"><mxGeometry x="20" y="46" width="290" height="70" as="geometry"/></mxCell>
<mxCell id="db" value="&lt;b&gt;msb.db&lt;/b&gt;&lt;br&gt;&lt;small&gt;run row: pid and start time&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="l_host"><mxGeometry x="780" y="282" width="260" height="90" as="geometry"/></mxCell>
<mxCell id="ea" value="a" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=1;html=1;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="entries" target="srv"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="eb" value="b" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=1;html=1;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;startArrow=classic;startFill=1;exitX=0.8333;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="agent" target="srv"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e1" value="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=1;html=1;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;exitX=0.25;exitY=0;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="delegate" target="api"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e4" value="4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=1;html=1;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="api" target="delegate"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e2" value="2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=1;html=1;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.2424;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="msbvm" target="vmm"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e3" value="3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=1;html=1;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;exitX=0.85;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="msbvm" target="db"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="flow" value="&lt;b&gt;Flow&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="778" width="1060" height="330" as="geometry"/></mxCell>
<mxCell id="flow_0" value="&lt;b&gt;Prerequisites, once&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;a&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;Flux applies the entries from git.&lt;br&gt;The controller manager copies them to&lt;br&gt;the server. The node entry exists.&lt;br&gt;The delegate entry and the VM entry&lt;br&gt;are not built.&lt;br&gt;&lt;br&gt;&lt;b&gt;b&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;The host agent attests with x509pop.&lt;br&gt;Its config loads the msbvm plugin&lt;br&gt;(path and checksum) and sets&lt;br&gt;admin.sock. The server sends the&lt;br&gt;entries of the node. The agent mints&lt;br&gt;their SVIDs.&lt;br&gt;&lt;br&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="814" width="320" height="284" as="geometry"/></mxCell>
<mxCell id="flow_1" value="&lt;b&gt;Each time a VM needs its SVID&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;The delegate connects to admin.sock&lt;br&gt;and sends the pid of the VMM. The&lt;br&gt;agent checks the delegate.&lt;br&gt;&lt;br&gt;&lt;b&gt;2&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;The unix attestor gives the uid. The&lt;br&gt;msbvm plugin reads the exe and the&lt;br&gt;command line of the VMM.&lt;br&gt;&lt;br&gt;&lt;b&gt;3&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;The plugin checks the run row: same&lt;br&gt;pid, same start time. It returns the&lt;br&gt;VM name and the sandbox ID.&lt;br&gt;&lt;br&gt;&lt;b&gt;4&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;The agent matches the VM entry. It&lt;br&gt;sends the SVID and the key to the&lt;br&gt;delegate. Zero SVIDs is a refusal.&lt;br&gt;&lt;br&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="385" y="814" width="320" height="284" as="geometry"/></mxCell>
<mxCell id="flow_2" value="&lt;b&gt;Lifetimes and names&lt;/b&gt;&lt;br&gt;&lt;br&gt;The VM never sees the key or a socket of&lt;br&gt;the agent.&lt;br&gt;&lt;br&gt;The pid is an input, not a selector. It&lt;br&gt;changes at each start.&lt;br&gt;&lt;br&gt;The agent SVID lives 4 hours. The life&lt;br&gt;of the VM SVID is not tested.&lt;br&gt;&lt;br&gt;The ID: spiffe://mcp.local/node/sandbox-&lt;br&gt;dev/user/&amp;lt;user&amp;gt;/vm/&amp;lt;vm&amp;gt;&lt;br&gt;&lt;br&gt;The orange boxes are not built yet.&lt;br&gt;&lt;br&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="730" y="814" width="320" height="284" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>
