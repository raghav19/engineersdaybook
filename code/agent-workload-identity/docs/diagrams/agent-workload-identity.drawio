<mxCell id="flow_0" value="&lt;b&gt;Prerequisites, once&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;a&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;Flux applies the entries from git.&lt;br&gt;The controller manager copies them to&lt;br&gt;the server.&lt;br&gt;&lt;br&gt;&lt;b&gt;b&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;The host agent attests to the server.&lt;br&gt;The server sends the entries of the&lt;br&gt;node.&lt;br&gt;&lt;br&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="764" width="320" height="204" as="geometry"/></mxCell>
<mxCell id="flow_1" value="&lt;b&gt;Each time a VM needs its SVID&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;The delegate sends the pid of the VMM&lt;br&gt;to the agent.&lt;br&gt;&lt;br&gt;&lt;b&gt;2&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;The msbvm plugin reads the VMM.&lt;br&gt;&lt;br&gt;&lt;b&gt;3&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;The plugin checks the run row in&lt;br&gt;msb.db.&lt;br&gt;&lt;br&gt;&lt;b&gt;4&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;The agent sends the SVID and the key&lt;br&gt;to the delegate.&lt;br&gt;&lt;br&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="385" y="764" width="320" height="204" as="geometry"/></mxCell>
<mxCell id="flow_2" value="&lt;b&gt;The ID&lt;/b&gt;&lt;br&gt;&lt;br&gt;spiffe://mcp.local/node/sandbox-&lt;br&gt;dev/user/&amp;lt;user&amp;gt;/vm/&amp;lt;vm&amp;gt;&lt;br&gt;&lt;br&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="730" y="764" width="320" height="204" as="geometry"/></mxCell>
