set quiet

# VARIABLES

flux_operator_chart := 'oci://ghcr.io/controlplaneio-fluxcd/charts/flux-operator'
flux_operator_version := '0.62.1'
ghcr_user := env('GHCR_USER', 'raghav19')
ctx := env('KUBE_CONTEXT', 'default')

# RECIPES

# Hand a fresh k3s to Flux (host). Run `just publish` first, so the artifact exists when Flux starts.
# GHCR_PULL_TOKEN holds a token with read:packages. `up` pipes it into the Secret ghcr-pull.
# The token goes to no file, no Git and no artifact.
# `ref` is the tag or digest that Flux pulls.
# Before the first merge, pass the tag that `just publish` printed.
[script('bash')]
up ref='latest': _host
    set -euo pipefail
    : "${GHCR_PULL_TOKEN:?Set GHCR_PULL_TOKEN (read:packages) before you run this recipe}"
    k="kubectl --context {{ ctx }}"
    # The cluster contract: Ready node, Gateway API CRDs and the packaged Traefik.
    $k wait --for=condition=Ready node --all --timeout=5m
    $k get crd gateways.gateway.networking.k8s.io > /dev/null
    $k -n kube-system get deploy traefik > /dev/null
    $k apply -f traefik-config.yaml
    helm upgrade --install flux-operator {{ flux_operator_chart }} --version {{ flux_operator_version }} \
      --kube-context {{ ctx }} --namespace flux-system --create-namespace --wait --timeout 10m
    $k -n flux-system create secret docker-registry ghcr-pull --docker-server=ghcr.io --docker-username={{ ghcr_user }} \
      --docker-password="$GHCR_PULL_TOKEN" --dry-run=client -o yaml | $k apply -f -
    REF='{{ ref }}' yq '.spec.sync.ref = strenv(REF)' flux-instance.yaml | $k apply -f -
    $k -n flux-system wait --for=condition=Ready fluxinstance/flux --timeout=10m

_host:
    [ -z "${SANDBOX_NAME:-}" ] || { echo "Run this on the host, not in the sandbox ($SANDBOX_NAME): the registry token is not for the sandbox." >&2; exit 1; }
