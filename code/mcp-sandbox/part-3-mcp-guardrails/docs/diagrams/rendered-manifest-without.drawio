<mxfile host="app.diagrams.net"><diagram id="rendered-manifest-without" name="Without rendered manifests"><mxGraphModel adaptiveColors="auto" dx="1000" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="Without rendered manifests: the cluster renders" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="760" height="40" as="geometry"/></mxCell>
<mxCell id="clus" value="Cluster" style="swimlane;startSize=26;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;html=1;" vertex="1" parent="1"><mxGeometry x="520" y="50" width="360" height="160" as="geometry"/></mxCell>
<mxCell id="dev" value="Developer&lt;br&gt;&lt;small&gt;changes values or templates&lt;/small&gt;" style="shape=image;html=1;verticalAlign=top;verticalLabelPosition=bottom;labelBackgroundColor=default;imageAspect=0;aspect=fixed;fontSize=14;image=https://icons.diagrams.net/assets/developer/1/Developer-44.svg;labelPerimeter=1;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="31" height="56" as="geometry"/></mxCell>
<mxCell id="rev" value="Reviewer&lt;br&gt;&lt;small&gt;reads values, not final YAML&lt;/small&gt;" style="shape=image;html=1;verticalAlign=top;verticalLabelPosition=bottom;labelBackgroundColor=default;imageAspect=0;aspect=fixed;fontSize=14;image=https://icons.diagrams.net/icon-cache1/Essential-2101/Search-1356.svg;labelPerimeter=1;" vertex="1" parent="1"><mxGeometry x="190" y="90" width="52" height="52" as="geometry"/></mxCell>
<mxCell id="git" value="Git repository&lt;br&gt;&lt;small&gt;dry source only&lt;/small&gt;" style="shape=image;html=1;verticalAlign=top;verticalLabelPosition=bottom;labelBackgroundColor=default;imageAspect=0;aspect=fixed;fontSize=14;image=https://icons.diagrams.net/assets/developer/1/Code.svg;labelPerimeter=1;" vertex="1" parent="1"><mxGeometry x="330" y="90" width="70" height="50" as="geometry"/></mxCell>
<mxCell id="ctrl" value="GitOps controller&lt;br&gt;&lt;small&gt;renders Helm or Kustomize&lt;/small&gt;" style="shape=image;html=1;verticalAlign=top;verticalLabelPosition=bottom;labelBackgroundColor=default;imageAspect=0;aspect=fixed;fontSize=14;image=https://icons.diagrams.net/assets/kubernetes/1/c-c-m.svg;labelPerimeter=1;" vertex="1" parent="clus"><mxGeometry x="70" y="40" width="56" height="56" as="geometry"/></mxCell>
<mxCell id="wl" value="Workloads&lt;br&gt;&lt;small&gt;run the final YAML&lt;/small&gt;" style="shape=image;html=1;verticalAlign=top;verticalLabelPosition=bottom;labelBackgroundColor=default;imageAspect=0;aspect=fixed;fontSize=14;image=https://icons.diagrams.net/assets/kubernetes/1/deploy.svg;labelPerimeter=1;" vertex="1" parent="clus"><mxGeometry x="250" y="40" width="56" height="56" as="geometry"/></mxCell>
<mxCell id="e1" value="PR" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;" edge="1" source="dev" target="rev" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e2" value="merge" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;" edge="1" source="rev" target="git" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e3" value="pull" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;" edge="1" source="git" target="ctrl" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e4" value="render, apply" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;" edge="1" source="ctrl" target="wl" parent="clus"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="n1" value="Reviewers see only the source change. A small value change can alter many objects, and nobody sees them." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="110" y="240" width="320" height="70" as="geometry"/></mxCell>
<mxCell id="n2" value="The final YAML first exists inside the cluster, after the merge. No check runs on it before it applies." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="520" y="240" width="360" height="70" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>
