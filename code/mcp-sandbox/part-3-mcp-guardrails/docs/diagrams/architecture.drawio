          <mxGeometry x="290" y="30" width="700" height="500" as="geometry"/>
        </mxCell>
        <mxCell id="client" value="&lt;b&gt;MCP client&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New' style='font-size:10px'&gt;&quot;mcpServers&quot;: {&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;guardrails&quot;: {&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;type&quot;: &quot;http&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;url&quot;: &quot;http://127.0.0.1:8080/mcp&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;headers&quot;: {&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;Authorization&quot;: &quot;Bearer &amp;lt;JWT&amp;gt;&quot;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;}&lt;br&gt;&amp;nbsp;&amp;nbsp;}&lt;br&gt;}&lt;/font&gt;&lt;br&gt;tools: github_*, drawio_*, flux_*" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="10" y="185" width="250" height="200" as="geometry"/>
        </mxCell>
