          <mxGeometry x="20" y="215" width="140" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="gw" value="agentgateway" style="swimlane;startSize=28;fillColor=#eef4fb;strokeColor=#6c8ebf;fontStyle=1;rounded=1;html=1;" vertex="1" parent="frame">
          <mxGeometry x="220" y="160" width="300" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="req" value="&lt;b&gt;Request policies&lt;/b&gt;&lt;br&gt;JWT&lt;br&gt;rate limit&lt;br&gt;tool RBAC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;" vertex="1" parent="gw">
