<mxfile host="app.diagrams.net"><diagram id="node-attestation" name="node-attestation"><mxGraphModel adaptiveColors="auto" dx="1000" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="780" math="0" shadow="0"><root>
<mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="title" value="&lt;b&gt;Node attestation of the microVM with x509pop&lt;/b&gt;" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="1060" height="40" as="geometry"/></mxCell>
<mxCell id="l_cluster" value="k3s cluster" style="swimlane;rounded=1;arcSize=6;startSize=26;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;html=1;align=left;spacingLeft=40;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="1060" height="316" as="geometry"/></mxCell>
<mxCell id="l_host" value="Host" style="swimlane;rounded=1;arcSize=6;startSize=26;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;html=1;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="20" y="446" width="640" height="150" as="geometry"/></mxCell>
<mxCell id="l_vm" value="microVM" style="swimlane;rounded=1;arcSize=6;startSize=26;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;html=1;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="700" y="446" width="380" height="310" as="geometry"/></mxCell>
<mxCell id="ca" value="&lt;b&gt;Node CA&lt;/b&gt;&lt;br&gt;&lt;small&gt;Issuer node-ca&lt;/small&gt;&lt;br&gt;&lt;small&gt;made by cert-manager&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="l_cluster"><mxGeometry x="20" y="46" width="240" height="80" as="geometry"/></mxCell>
<mxCell id="bundle" value="&lt;b&gt;ConfigMap node-ca-bundle&lt;/b&gt;&lt;br&gt;&lt;small&gt;written by trust-manager&lt;/small&gt;&lt;br&gt;&lt;small&gt;holds the node CA certificate&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="l_cluster"><mxGeometry x="380" y="46" width="240" height="80" as="geometry"/></mxCell>
<mxCell id="srv" value="&lt;b&gt;SPIRE server&lt;/b&gt;&lt;br&gt;&lt;small&gt;trust domain mcp.local&lt;/small&gt;&lt;br&gt;&lt;small&gt;NodeAttestor x509pop&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="l_cluster"><mxGeometry x="760" y="46" width="240" height="80" as="geometry"/></mxCell>
<mxCell id="cert" value="&lt;b&gt;Certificate sandbox-node&lt;/b&gt;&lt;br&gt;&lt;small&gt;key pair and 90-day certificate&lt;/small&gt;&lt;br&gt;&lt;small&gt;in Secret sandbox-node-tls&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="l_cluster"><mxGeometry x="20" y="206" width="240" height="80" as="geometry"/></mxCell>
<mxCell id="gw" value="&lt;b&gt;Istio ingress gateway&lt;/b&gt;&lt;br&gt;&lt;small&gt;TLSRoute spire, port 443&lt;/small&gt;&lt;br&gt;&lt;small&gt;passes the TLS through&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="l_cluster"><mxGeometry x="760" y="206" width="240" height="80" as="geometry"/></mxCell>
<mxCell id="nodecert" value="&lt;b&gt;just msb node-cert&lt;/b&gt;&lt;br&gt;&lt;small&gt;runs before the VM starts&lt;/small&gt;&lt;br&gt;&lt;small&gt;copies key, certificate, bundle&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="l_host"><mxGeometry x="20" y="46" width="240" height="80" as="geometry"/></mxCell>
<mxCell id="folder" value="&lt;b&gt;~/.config/msb/node&lt;/b&gt;&lt;br&gt;&lt;small&gt;node.key, node.crt, bundle.json&lt;/small&gt;&lt;br&gt;&lt;small&gt;the key is mode 600&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="l_host"><mxGeometry x="380" y="46" width="240" height="80" as="geometry"/></mxCell>
<mxCell id="agent" value="&lt;b&gt;SPIRE agent&lt;/b&gt;&lt;br&gt;&lt;small&gt;runs as root, NodeAttestor x509pop&lt;/small&gt;&lt;br&gt;&lt;small&gt;reads /run/sandbox/node (read-only)&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="l_vm"><mxGeometry x="40" y="46" width="300" height="80" as="geometry"/></mxCell>
<mxCell id="boot" value="&lt;b&gt;sandbox-boot&lt;/b&gt;&lt;br&gt;&lt;small&gt;maps spire.localhost to the host&lt;/small&gt;&lt;br&gt;&lt;small&gt;starts the agent, waits until healthy&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="l_vm"><mxGeometry x="40" y="206" width="300" height="80" as="geometry"/></mxCell>
