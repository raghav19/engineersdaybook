<mxfile host="app.diagrams.net"><diagram id="node-attestation" name="node-attestation"><mxGraphModel adaptiveColors="auto" dx="1000" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1160" math="0" shadow="0"><root>
<mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="title" value="&lt;b&gt;Node attestation of the microVM with x509pop&lt;/b&gt;" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="1060" height="40" as="geometry"/></mxCell>
<mxCell id="l_cluster" value="k3s cluster" style="swimlane;rounded=1;arcSize=6;startSize=26;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;html=1;align=left;spacingLeft=40;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="1060" height="332" as="geometry"/></mxCell>
<mxCell id="l_host" value="Host" style="swimlane;rounded=1;arcSize=6;startSize=26;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;html=1;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="20" y="462" width="640" height="150" as="geometry"/></mxCell>
<mxCell id="l_vm" value="microVM" style="swimlane;rounded=1;arcSize=6;startSize=26;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;html=1;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="700" y="462" width="380" height="310" as="geometry"/></mxCell>
<mxCell id="ca" value="&lt;b&gt;Node CA&lt;/b&gt;&lt;br&gt;&lt;small&gt;Issuer node-ca&lt;/small&gt;&lt;br&gt;&lt;small&gt;made by cert-manager&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="l_cluster"><mxGeometry x="20" y="46" width="240" height="80" as="geometry"/></mxCell>
<mxCell id="bundle" value="&lt;b&gt;ConfigMap node-ca-bundle&lt;/b&gt;&lt;br&gt;&lt;small&gt;written by trust-manager&lt;/small&gt;&lt;br&gt;&lt;small&gt;holds the node CA certificate&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="l_cluster"><mxGeometry x="380" y="46" width="240" height="80" as="geometry"/></mxCell>
<mxCell id="srv" value="&lt;b&gt;SPIRE server&lt;/b&gt;&lt;br&gt;&lt;small&gt;trust domain mcp.local&lt;/small&gt;&lt;br&gt;&lt;small&gt;NodeAttestor x509pop&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="l_cluster"><mxGeometry x="760" y="46" width="240" height="80" as="geometry"/></mxCell>
<mxCell id="cert" value="&lt;b&gt;Certificate sandbox-node&lt;/b&gt;&lt;br&gt;&lt;small&gt;key pair and 90-day certificate&lt;/small&gt;&lt;br&gt;&lt;small&gt;in Secret sandbox-node-tls&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="l_cluster"><mxGeometry x="20" y="206" width="240" height="80" as="geometry"/></mxCell>
<mxCell id="entry" value="&lt;b&gt;ClusterStaticEntry sandbox-node&lt;/b&gt;&lt;br&gt;&lt;small&gt;ID spiffe://mcp.local/node/sandbox-dev&lt;/small&gt;&lt;br&gt;&lt;small&gt;selector: CN sandbox-dev&lt;/small&gt;&lt;br&gt;&lt;small&gt;selector: URI SAN github-id raghav19&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="l_cluster"><mxGeometry x="330" y="206" width="300" height="96" as="geometry"/></mxCell>
<mxCell id="gw" value="&lt;b&gt;Istio ingress gateway&lt;/b&gt;&lt;br&gt;&lt;small&gt;TLSRoute spire, port 443&lt;/small&gt;&lt;br&gt;&lt;small&gt;passes the TLS through&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="l_cluster"><mxGeometry x="760" y="206" width="240" height="80" as="geometry"/></mxCell>
<mxCell id="nodecert" value="&lt;b&gt;just msb node-cert&lt;/b&gt;&lt;br&gt;&lt;small&gt;runs before the VM starts&lt;/small&gt;&lt;br&gt;&lt;small&gt;copies key, certificate, bundle&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="l_host"><mxGeometry x="20" y="46" width="240" height="80" as="geometry"/></mxCell>
<mxCell id="folder" value="&lt;b&gt;~/.config/msb/node&lt;/b&gt;&lt;br&gt;&lt;small&gt;node.key, node.crt, bundle.json&lt;/small&gt;&lt;br&gt;&lt;small&gt;the key is mode 600&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="l_host"><mxGeometry x="380" y="46" width="240" height="80" as="geometry"/></mxCell>
<mxCell id="agent" value="&lt;b&gt;SPIRE agent&lt;/b&gt;&lt;br&gt;&lt;small&gt;runs as root, NodeAttestor x509pop&lt;/small&gt;&lt;br&gt;&lt;small&gt;reads /run/sandbox/node (read-only)&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="l_vm"><mxGeometry x="40" y="46" width="300" height="80" as="geometry"/></mxCell>
<mxCell id="boot" value="&lt;b&gt;sandbox-boot&lt;/b&gt;&lt;br&gt;&lt;small&gt;maps spire.localhost to the host&lt;/small&gt;&lt;br&gt;&lt;small&gt;starts the agent, waits until healthy&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="l_vm"><mxGeometry x="40" y="206" width="300" height="80" as="geometry"/></mxCell>
<mxCell id="ea" value="a" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=1;html=1;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="ca" target="cert" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="eb" value="b" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=1;html=1;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="ca" target="bundle" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="ec" value="c" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=1;html=1;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="bundle" target="srv" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="ed" value="d" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=1;html=1;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" source="entry" target="srv" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="710" y="304"/><mxPoint x="710" y="156"/></Array></mxGeometry></mxCell>
<mxCell id="e1" value="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=1;html=1;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" source="nodecert" target="cert" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e2" value="2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=1;html=1;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="nodecert" target="folder" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e3" value="3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=1;html=1;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="folder" target="agent" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e4" value="4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=1;html=1;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" source="boot" target="agent" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e5" value="5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=1;html=1;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;startArrow=classic;startFill=1;exitX=0.5333;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" source="agent" target="gw" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e6" value="6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=1;html=1;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;startArrow=classic;startFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" source="gw" target="srv" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="flow" value="&lt;b&gt;Flow&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="800" width="1060" height="340" as="geometry"/></mxCell>
<mxCell id="flow_0" value="&lt;b&gt;Prerequisites, once (Flux, from git)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;a&lt;/b&gt;&amp;nbsp;&amp;nbsp;The node CA signs the Certificate&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;sandbox-node. cert-manager makes its&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;key pair and its 90-day certificate.&lt;br&gt;&lt;br&gt;&lt;b&gt;b&lt;/b&gt;&amp;nbsp;&amp;nbsp;trust-manager copies the CA certificate&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;into the ConfigMap node-ca-bundle.&lt;br&gt;&lt;br&gt;&lt;b&gt;c&lt;/b&gt;&amp;nbsp;&amp;nbsp;The SPIRE server reads the bundle. It&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;trusts only certificates that the node&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;CA signed.&lt;br&gt;&lt;br&gt;&lt;b&gt;d&lt;/b&gt;&amp;nbsp;&amp;nbsp;The controller manager registers the&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;node entry in the server. A node with&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;both selectors gets this ID." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="836" width="320" height="294" as="geometry"/></mxCell>
<mxCell id="flow_1" value="&lt;b&gt;Each run (just msb run)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1&lt;/b&gt;&amp;nbsp;&amp;nbsp;node-cert waits until the Certificate&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;is ready. It reads the Secret and the&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;trust bundle.&lt;br&gt;&lt;br&gt;&lt;b&gt;2&lt;/b&gt;&amp;nbsp;&amp;nbsp;It writes key, certificate and bundle&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;to the host folder (key mode 600).&lt;br&gt;&lt;br&gt;&lt;b&gt;3&lt;/b&gt;&amp;nbsp;&amp;nbsp;The VM mounts the folder read-only.&lt;br&gt;&lt;br&gt;&lt;b&gt;4&lt;/b&gt;&amp;nbsp;&amp;nbsp;sandbox-boot maps spire.localhost to&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;the host and starts the agent.&lt;br&gt;&lt;br&gt;&lt;b&gt;5&lt;/b&gt;&amp;nbsp;&amp;nbsp;The agent calls spire.localhost on port&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;443. The gateway reads only the name.&lt;br&gt;&lt;br&gt;&lt;b&gt;6&lt;/b&gt;&amp;nbsp;&amp;nbsp;The gateway passes the TLS through. The&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;server sends a nonce, checks the&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;signed answer and issues the SVID." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="385" y="836" width="320" height="294" as="geometry"/></mxCell>
<mxCell id="flow_2" value="&lt;b&gt;About every 2 hours, and the names&lt;/b&gt;&lt;br&gt;&lt;br&gt;The agent SVID lives 4 hours. About&lt;br&gt;half-way, the agent rotates it. It&lt;br&gt;attests again (steps 5 and 6) and reads&lt;br&gt;the key and the certificate again.&lt;br&gt;&lt;br&gt;mcp.local is the trust domain. Every ID&lt;br&gt;starts with spiffe://mcp.local.&lt;br&gt;&lt;br&gt;SVID: the short-lived certificate that&lt;br&gt;SPIRE issues to the agent.&lt;br&gt;&lt;br&gt;Selector: a fact that the server learns&lt;br&gt;about the node (the CN, the login)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="730" y="836" width="320" height="294" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>
