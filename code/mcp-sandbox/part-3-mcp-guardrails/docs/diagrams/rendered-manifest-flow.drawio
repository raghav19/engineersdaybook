<mxfile host="app.diagrams.net"><diagram id="rendered-manifest-flow" name="Workflow flow"><mxGraphModel adaptiveColors="auto" dx="1000" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="560" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="The workflow: from a pull request to the cluster" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="0" width="860" height="40" as="geometry"/></mxCell>
<mxCell id="wf" value="Workflow manifest-diff (GitHub Actions)" style="swimlane;startSize=26;fillColor=#e8f5e9;strokeColor=#82b366;fontSize=14;html=1;" vertex="1" parent="1"><mxGeometry x="330" y="50" width="650" height="170" as="geometry"/></mxCell>
<mxCell id="cl" value="Cluster" style="swimlane;startSize=26;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;html=1;" vertex="1" parent="1"><mxGeometry x="210" y="270" width="380" height="170" as="geometry"/></mxCell>
<mxCell id="dev" value="Developer&lt;br&gt;&lt;small&gt;changes platform/&lt;/small&gt;" style="shape=image;html=1;verticalAlign=top;verticalLabelPosition=bottom;labelBackgroundColor=default;imageAspect=0;aspect=fixed;fontSize=14;labelPerimeter=1;image=https://icons.diagrams.net/assets/developer/1/Developer-44.svg;" vertex="1" parent="1"><mxGeometry x="60" y="90" width="31" height="56" as="geometry"/></mxCell>
<mxCell id="pr" value="Pull request&lt;br&gt;&lt;small&gt;source and digest pin&lt;/small&gt;" style="shape=image;html=1;verticalAlign=top;verticalLabelPosition=bottom;labelBackgroundColor=default;imageAspect=0;aspect=fixed;fontSize=14;labelPerimeter=1;image=https://icons.diagrams.net/assets/developer/1/Code.svg;" vertex="1" parent="1"><mxGeometry x="190" y="90" width="70" height="50" as="geometry"/></mxCell>
<mxCell id="build" value="1. Build&lt;br&gt;&lt;small&gt;render, schema check&lt;/small&gt;" style="shape=image;html=1;verticalAlign=top;verticalLabelPosition=bottom;labelBackgroundColor=default;imageAspect=0;aspect=fixed;fontSize=14;labelPerimeter=1;image=https://app.diagrams.net/img/lib/ibm/devops/build_test.svg;" vertex="1" parent="wf"><mxGeometry x="30" y="40" width="56" height="56" as="geometry"/></mxCell>
<mxCell id="diff" value="2. Diff&lt;br&gt;&lt;small&gt;new render vs pinned artifact&lt;/small&gt;" style="shape=image;html=1;verticalAlign=top;verticalLabelPosition=bottom;labelBackgroundColor=default;imageAspect=0;aspect=fixed;fontSize=14;labelPerimeter=1;image=https://icons.diagrams.net/icon-cache1/Essential-2101/Search-1356.svg;" vertex="1" parent="wf"><mxGeometry x="190" y="40" width="56" height="56" as="geometry"/></mxCell>
<mxCell id="pub" value="3. Publish&lt;br&gt;&lt;small&gt;OCI artifact, tag and digest&lt;/small&gt;" style="shape=image;html=1;verticalAlign=top;verticalLabelPosition=bottom;labelBackgroundColor=default;imageAspect=0;aspect=fixed;fontSize=14;labelPerimeter=1;image=https://icons.diagrams.net/assets/material-symbols/1/Box.svg;" vertex="1" parent="wf"><mxGeometry x="350" y="40" width="56" height="56" as="geometry"/></mxCell>
<mxCell id="cmt" value="4. Comment&lt;br&gt;&lt;small&gt;the diff, one per commit&lt;/small&gt;" style="shape=image;html=1;verticalAlign=top;verticalLabelPosition=bottom;labelBackgroundColor=default;imageAspect=0;aspect=fixed;fontSize=14;labelPerimeter=1;image=https://icons.diagrams.net/assets/developer/1/Code.svg;" vertex="1" parent="wf"><mxGeometry x="510" y="40" width="70" height="50" as="geometry"/></mxCell>
<mxCell id="rev" value="Reviewer&lt;br&gt;&lt;small&gt;reads the final YAML, merges&lt;/small&gt;" style="shape=image;html=1;verticalAlign=top;verticalLabelPosition=bottom;labelBackgroundColor=default;imageAspect=0;aspect=fixed;fontSize=14;labelPerimeter=1;image=https://icons.diagrams.net/assets/developer/1/Developer-44.svg;" vertex="1" parent="1"><mxGeometry x="860" y="300" width="31" height="56" as="geometry"/></mxCell>
<mxCell id="pin" value="Pin on main&lt;br&gt;&lt;small&gt;sync/ holds the digest&lt;/small&gt;" style="shape=image;html=1;verticalAlign=top;verticalLabelPosition=bottom;labelBackgroundColor=default;imageAspect=0;aspect=fixed;fontSize=14;labelPerimeter=1;image=https://icons.diagrams.net/assets/font-awesome/1/File_Code.svg;" vertex="1" parent="1"><mxGeometry x="660" y="300" width="42" height="56" as="geometry"/></mxCell>
<mxCell id="ctrl" value="GitOps controller&lt;br&gt;&lt;small&gt;pulls the artifact at the digest&lt;/small&gt;" style="shape=image;html=1;verticalAlign=top;verticalLabelPosition=bottom;labelBackgroundColor=default;imageAspect=0;aspect=fixed;fontSize=14;labelPerimeter=1;image=https://icons.diagrams.net/assets/kubernetes/1/c-c-m.svg;" vertex="1" parent="cl"><mxGeometry x="240" y="40" width="56" height="56" as="geometry"/></mxCell>
<mxCell id="wl" value="Workloads&lt;br&gt;&lt;small&gt;run the reviewed YAML&lt;/small&gt;" style="shape=image;html=1;verticalAlign=top;verticalLabelPosition=bottom;labelBackgroundColor=default;imageAspect=0;aspect=fixed;fontSize=14;labelPerimeter=1;image=https://icons.diagrams.net/assets/kubernetes/1/deploy.svg;" vertex="1" parent="cl"><mxGeometry x="50" y="40" width="56" height="56" as="geometry"/></mxCell>
<mxCell id="e1" value="opens" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;" edge="1" source="dev" target="pr" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e2" value="trigger" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;" edge="1" source="pr" target="build" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;" edge="1" source="build" target="diff" parent="wf"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;" edge="1" source="diff" target="pub" parent="wf"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;" edge="1" source="pub" target="cmt" parent="wf"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e6" value="reads" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;" edge="1" source="cmt" target="rev" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e7" value="merge" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;" edge="1" source="rev" target="pin" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e8" value="reads pin" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;" edge="1" source="pin" target="ctrl" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e9" value="apply" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;" edge="1" source="ctrl" target="wl" parent="cl"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="n1" value="Rollback: revert the commit that changed the digest pin." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="210" y="470" width="380" height="50" as="geometry"/></mxCell>
<mxCell id="n2" value="The reviewer sees the final YAML before the merge." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="660" y="470" width="320" height="50" as="geometry"/></mxCell>
