#!/usr/bin/env bash
# Kustomize exec KRM function: emit a Secret from named keys of a sops-encrypted JSON file.
#
# Reads a ResourceList on stdin, appends one Secret built from `functionConfig`, writes the ResourceList on stdout.
# The decrypted value exists only in this process and in the rendered stream: pipe the build into
# `kubectl apply -f -`, never to disk. The file is found by walking up from the current directory.
# Needs sops, yq (mikefarah) and jq, which the repo's mise.toml pins.
#
# functionConfig (kind SopsSecret):
#   data:
#     file: .env.secrets.json
#     keys:                 # Secret key -> JSON key in the file
#       Authorization: GITHUB_TOKEN
set -euo pipefail

input=$(yq -o=json '.' -)
fc=$(jq -c '.functionConfig' <<<"$input")
name=$(jq -r '.metadata.name' <<<"$fc")
ns=$(jq -r '.metadata.namespace // "default"' <<<"$fc")
file=$(jq -r '.data.file // ".env.secrets.json"' <<<"$fc")

dir=$PWD
while [[ ! -f "$dir/$file" ]]; do
  [[ "$dir" == / ]] && { echo "sops-secret: $file not found above $PWD" >&2; exit 1; }
  dir=$(dirname "$dir")
done
path="$dir/$file"

string_data='{}'
while IFS=$'\t' read -r secret_key json_key; do
  # stderr from sops names the key, never the value
  value=$(sops -d --extract "[\"$json_key\"]" "$path") \
    || { echo "sops-secret: cannot decrypt key $json_key in $path" >&2; exit 1; }
  string_data=$(jq -c --arg k "$secret_key" --arg v "$value" '. + {($k): $v}' <<<"$string_data")
done < <(jq -r '.data.keys | to_entries[] | [.key, .value] | @tsv' <<<"$fc")

jq --arg n "$name" --arg ns "$ns" --argjson sd "$string_data" \
  '.items += [{apiVersion:"v1", kind:"Secret", metadata:{name:$n, namespace:$ns}, type:"Opaque", stringData:$sd}]' \
  <<<"$input" | yq -P '.' -
