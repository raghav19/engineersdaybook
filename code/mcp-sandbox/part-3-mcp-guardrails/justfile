# Part 3: agentgateway guardrails on kind, delivered by Flux. Run `just` to see the commands.

set quiet

# the revision that `diff-report` compares with (the same default as `base` of lib/workflow/workflow.just)
base := 'origin/main'

# the commands of this project
[default, script('bash')]
help:
    cat <<'EOF'
    One artifact per component. Every component folder has its own justfile (it imports lib/workflow/workflow.just).
    Name the folder to run a recipe: `just platform/routes/package-artifact`.

      just <component>/package-artifact    render the folder (charts included), check it, write out/<component>/manifests.yaml
      just <component>/diff                the change against the artifact origin/main pins, that is what the cluster runs
                                           (`just --set base <rev> <component>/diff` compares with another revision)
      just diff-report                     the rendered manifest diff of every component, as Markdown (the pull request workflow posts it)
      just <component>/publish-artifact    package-artifact, then push the artifact to the registry (host)
      just <component>/compose-stack       compose the stack (sync/<cluster>/infra-stack.yaml): the published tag and digest

      just clusters/kind/up | down                 the kind cluster and the hand-over to Flux, asks for the Bitwarden access token (host)
      just clusters/kind/delete-crds               remove the CRDs of the stack, explicitly (host)
      just tests/run                               the attack cases against the gateway

    Everything a component writes is in out/<component>/ (gitignored). What goes where: lib/workflow/workflow.just.
    EOF

# reads:  every component that Flux delivers (the folders of platform/ that have flux/stack.yaml), through the diff recipe of each one (lib/workflow/diff.just)
# writes: nothing (the diff recipe writes out/<component>/)
# output: Markdown on standard output, one <details> block for each component that has a rendered manifest diff, nothing for a component without one.
#         The diff recipe renders the folder with flate, so the diff is of the rendered objects (charts inflated, config values applied).
#         A failed render stops the recipe. The workflow .github/workflows/manifest-diff.yaml posts this output in the pull request
# the rendered manifest diff of every component
[script('bash')]
diff-report:
    set -euo pipefail
    for stack in $(find platform -path '*/flux/stack.yaml' | sort); do
      c=${stack%/flux/stack.yaml}
      # the diff recipe prints config: and baseline: lines first, the diff starts at --- baseline
      diff=$(just --set base {{ base }} "$c/diff" | sed -n '/^--- baseline/,$p')
      [ -n "$diff" ] || continue
      printf '<details><summary>%s</summary>\n\n````diff\n%s\n````\n\n</details>\n\n' "$c" "$diff"
    done
