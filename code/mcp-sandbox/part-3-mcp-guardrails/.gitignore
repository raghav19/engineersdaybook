# `just <component>/build` writes the artifact of a component to out/<component>/manifests.yaml, with its helper files beside it
out/
__pycache__/
*.pyc
# the venv `uv run --project tools` creates for the build functions (tools/tools.just)
.venv/
# the cache of `ruff check` / `ruff format` (tools/tools.just build), written next to the code it checked
.ruff_cache/

# a local-only runner of build and diff for the changed components (not part of the project)
/local-preview.sh
