# The components of platform/: the folders that Flux delivers (each has flux/stack.yaml). The recipes here go over all of them, one after the other.
# One component has its own justfile (it imports lib/workflow/workflow.just): `just platform/routes/package-artifact`.
# The loop is in tools/platform-pipeline/, a build function. Each recipe pulls the binary from the registry (it does not build it) and runs it in the root of part 3.
# The tag is a fixed value (`pipeline_tag` below), so a run always uses a binary that works. To use a new version of the tool:
# 1. commit the change of tools/platform-pipeline/, 2. on the host, `just tools/platform-pipeline/push` (it prints the tag: the commit that last
# changed the folder), 3. change `pipeline_tag` in a separate commit. A tag that is not in the registry is an error.
# A failed component does not stop the others, and the exit code is 1 at the end.

# the variables of the tools: root, tools, registry, ghcr_user, ghcr_push_token
import '../tools/tools.just'

pipeline := tools / 'platform-pipeline' / 'platform-pipeline'
# the tag of the binary in the registry: the output of `just tools/platform-pipeline/push`
tag := 'f67c27043ea6'

# reads:  <registry>/tools/platform-pipeline:<tag>
# writes: out/tools/platform-pipeline/platform-pipeline
# output: nothing when the binary of this tag is there. The error and the push command when the registry has no such tag
# pull the binary of the tag, once
[script('bash')]
_pipeline:
    set -euo pipefail
    [ -x {{ pipeline }} ] && [ "$(cat {{ pipeline }}.tag 2>/dev/null)" = "{{ tag }}" ] && exit 0
    mkdir -p {{ tools }}/platform-pipeline
    if ! flux pull artifact {{ registry }}/tools/platform-pipeline:{{ tag }} -o {{ tools }}/platform-pipeline \
        --creds "{{ ghcr_user }}:{{ ghcr_push_token }}" >/dev/null 2>&1; then
      echo "platform-pipeline:{{ tag }} is not in the registry. On the host: just tools/platform-pipeline/push" >&2
      exit 1
    fi
    chmod +x {{ pipeline }}
    echo "{{ tag }}" > {{ pipeline }}.tag

# reads:  the components
# writes: out/<component>/ of each component
# output: the output of package-artifact, one folded group for each component
# package-artifact for each component
[working-directory('..')]
package-artifacts: _pipeline
    {{ pipeline }} package

# reads:  the components, and the stack of each at origin/main
# writes: out/manifest-diff/changed.json (the changed components), and report.md (the text of the pull request comment, only when a component changed)
# output: the output of diff, one folded group for each component. In GitHub Actions the full text also goes to the job summary
# diff for each component. Options: --sha7 <hash> --run-url <url> --limit <characters>
[working-directory('..')]
diff-artifacts *options: _pipeline
    {{ pipeline }} diff {{ options }}

# reads:  out/manifest-diff/changed.json, written by diff-artifacts
# writes: the registry, and out/manifest.yaml (see publish-artifact)
# output: the output of publish-artifact, one folded group for each changed component
# publish-artifact for each changed component
[working-directory('..')]
publish-artifacts: _pipeline
    {{ pipeline }} publish
