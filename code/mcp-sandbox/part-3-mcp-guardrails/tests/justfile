# The attack cases of tests/attacks, run against the gateway. One line per OWASP id; the expected results are those of the profile of the
# cluster stack: phase-1 when infra/gateway/stack.yaml has the authn-jwt artifact, baseline when it has none. Run from here or as `just tests/run`.
set quiet

cluster := '../clusters/k3s'
sync := '../sync/' + `yq .sync ../clusters/k3s/cluster.yaml`
# the nodePort of the gateway (platform/routes/parameters.yaml). On k3s the node is the host, so it is a host port.
gateway_url := env('GATEWAY_URL', 'http://127.0.0.1:30080/mcp')
context := env('KUBE_CONTEXT', 'default')

# run every attack case against the gateway of the cluster
run:
    [ "$(kubectl config current-context)" = {{ context }} ] || { echo "kubectl context is not {{ context }}; refusing to touch the wrong cluster" >&2; exit 1; }
    [ "$(curl -s -o /dev/null -m 3 -w '%{http_code}' {{ gateway_url }})" != 000 ] \
      || { echo "Nothing answers on {{ gateway_url }}. Run: just clusters/k3s/up, and wait for Flux to apply the artifacts" >&2; exit 1; }
    profile=baseline; yq -N '.metadata.name' {{ sync }}/infra/gateway/stack.yaml | grep -qx authn-jwt && profile=phase-1; \
    for t in attacks/MCP*/; do bash "$t/run.sh" {{ gateway_url }} "$profile"; done
