<mxCell id="l_bk" value="Scaffolder backend" style="swimlane;rounded=1;arcSize=6;startSize=26;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;html=1;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="380" y="50" width="420" height="250" as="geometry"/></mxCell>
<mxCell id="l_out" value="Outputs" style="swimlane;rounded=1;arcSize=6;startSize=26;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;html=1;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="820" y="50" width="400" height="250" as="geometry"/></mxCell>
<mxCell id="tmpl" value="&lt;b&gt;Template entity&lt;/b&gt;&lt;br&gt;&lt;small&gt;apiVersion scaffolder.backstage.io/v1beta3&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="l_dev"><mxGeometry x="20" y="50" width="300" height="70" as="geometry"/></mxCell>
<mxCell id="wiz" value="&lt;b&gt;Wizard&lt;/b&gt;&lt;br&gt;&lt;small&gt;renders spec.parameters as a form&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="l_dev"><mxGeometry x="20" y="160" width="300" height="70" as="geometry"/></mxCell>
<mxCell id="task" value="&lt;b&gt;Task&lt;/b&gt;&lt;br&gt;&lt;small&gt;runs the steps in series&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="l_bk"><mxGeometry x="20" y="50" width="380" height="70" as="geometry"/></mxCell>
<mxCell id="act" value="&lt;b&gt;Actions&lt;/b&gt;&lt;br&gt;&lt;small&gt;fetch:template, publish:github, catalog:register, custom&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="l_bk"><mxGeometry x="20" y="160" width="380" height="70" as="geometry"/></mxCell>
<mxCell id="rep" value="&lt;b&gt;New repository&lt;/b&gt;&lt;br&gt;&lt;small&gt;publish:github creates it&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="l_out"><mxGeometry x="20" y="50" width="360" height="55" as="geometry"/></mxCell>
<mxCell id="pr" value="&lt;b&gt;Pull request&lt;/b&gt;&lt;br&gt;&lt;small&gt;publish:github:pull-request opens it&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="l_out"><mxGeometry x="20" y="115" width="360" height="55" as="geometry"/></mxCell>
<mxCell id="ent" value="&lt;b&gt;Catalog entity&lt;/b&gt;&lt;br&gt;&lt;small&gt;catalog:register adds it&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="l_out"><mxGeometry x="20" y="180" width="360" height="55" as="geometry"/></mxCell>
<mxCell id="p_custom" value="&lt;b&gt;Custom action&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="20" y="340" width="700" height="120" as="geometry"/></mxCell>
<mxCell id="p_custom_t" value="&lt;i&gt;createTemplateAction defines the id, the zod schema and the handler.&lt;/i&gt;&lt;br&gt;&lt;i&gt;A scaffolder-backend-module registers the action in the backend.&lt;/i&gt;&lt;br&gt;&lt;i&gt;A template calls the action by its id in one step.&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="32" y="386" width="676" height="62" as="geometry"/></mxCell>
<mxCell id="flow" value="&lt;b&gt;Flow&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=12;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="490" width="1200" height="140" as="geometry"/></mxCell>
<mxCell id="flow_0" value="&lt;i&gt;1  The developer opens a template in the catalog&lt;/i&gt;&lt;br&gt;&lt;i&gt;2  The wizard collects the values of spec.parameters&lt;/i&gt;&lt;br&gt;&lt;i&gt;3  The task runs each step in series&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="32" y="530" width="420" height="88" as="geometry"/></mxCell>
<mxCell id="flow_1" value="&lt;i&gt;4  An action creates the repository&lt;/i&gt;&lt;br&gt;&lt;i&gt;5  An action opens the pull request&lt;/i&gt;&lt;br&gt;&lt;i&gt;6  An action registers the new entity&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="472" y="530" width="420" height="88" as="geometry"/></mxCell>
