<mxCell id="e_c" value="3" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;html=1;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="task" target="act" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
