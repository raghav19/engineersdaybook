<mxCell id="title" value="&lt;b&gt;One Software Template run, end to end&lt;/b&gt;" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="1200" height="40" as="geometry"/></mxCell>
