<mxfile host="app.diagrams.net"><diagram id="scaffolder-workflow" name="scaffolder-workflow"><mxGraphModel adaptiveColors="auto" dx="1000" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="660" math="0" shadow="0"><root><mxCell id="0"/>
