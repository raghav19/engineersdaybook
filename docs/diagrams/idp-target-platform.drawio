<mxfile host="app.diagrams.net"><diagram id="idp-target-platform" name="idp-target-platform"><mxGraphModel adaptiveColors="auto" dx="1000" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="680" math="0" shadow="0"><root><mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="title" value="&lt;b&gt;The target platform, and what the sandbox blocks&lt;/b&gt;" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="1200" height="40" as="geometry"/></mxCell>
<mxCell id="l_vm" value="msb VM, 3 GB and no swap" style="swimlane;rounded=1;arcSize=6;startSize=26;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;html=1;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="430" height="250" as="geometry"/></mxCell>
<mxCell id="l_host" value="Host" style="swimlane;rounded=1;arcSize=6;startSize=26;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;html=1;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="470" y="50" width="330" height="250" as="geometry"/></mxCell>
<mxCell id="l_ext" value="Outside" style="swimlane;rounded=1;arcSize=6;startSize=26;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;html=1;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="820" y="50" width="400" height="250" as="geometry"/></mxCell>
<mxCell id="bs" value="&lt;b&gt;Backstage&lt;/b&gt;&lt;br&gt;&lt;small&gt;frontend and backend&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="l_vm"><mxGeometry x="20" y="50" width="190" height="70" as="geometry"/></mxCell>
<mxCell id="ob" value="&lt;b&gt;Online Boutique&lt;/b&gt;&lt;br&gt;&lt;small&gt;12 services,&lt;/small&gt;&lt;br&gt;&lt;small&gt;no catalog-info.yaml yet&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="l_vm"><mxGeometry x="20" y="160" width="190" height="70" as="geometry"/></mxCell>
<mxCell id="db" value="&lt;b&gt;Database&lt;/b&gt;&lt;br&gt;&lt;small&gt;sqlite first,&lt;/small&gt;&lt;br&gt;&lt;small&gt;postgres later&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="l_vm"><mxGeometry x="220" y="160" width="190" height="70" as="geometry"/></mxCell>
<mxCell id="kind" value="&lt;b&gt;kind cluster&lt;/b&gt;&lt;br&gt;&lt;small&gt;api server forwarded at port 6444&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="l_host"><mxGeometry x="20" y="50" width="290" height="70" as="geometry"/></mxCell>
<mxCell id="kc" value="&lt;b&gt;kubeconfig&lt;/b&gt;&lt;br&gt;&lt;small&gt;not ported into the VM yet&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="l_host"><mxGeometry x="20" y="160" width="290" height="70" as="geometry"/></mxCell>
<mxCell id="gh" value="&lt;b&gt;GitHub&lt;/b&gt;&lt;br&gt;&lt;small&gt;app repo and a templates repo&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="l_ext"><mxGeometry x="20" y="50" width="360" height="70" as="geometry"/></mxCell>
<mxCell id="aws" value="&lt;b&gt;AWS EKS&lt;/b&gt;&lt;br&gt;&lt;small&gt;phase 5, run from the host&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="l_ext"><mxGeometry x="20" y="160" width="360" height="70" as="geometry"/></mxCell>
<mxCell id="p_block" value="&lt;b&gt;Blocked in the VM&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="20" y="340" width="580" height="130" as="geometry"/></mxCell>
<mxCell id="p_block_t" value="&lt;i&gt;backstage.io, ghcr.io and backstage.github.io fail at DNS.&lt;/i&gt;&lt;br&gt;&lt;i&gt;No AWS API host is on the allow list, and no AWS credential exists.&lt;/i&gt;&lt;br&gt;&lt;i&gt;The chart must install from a local clone of backstage/charts.&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="32" y="386" width="556" height="72" as="geometry"/></mxCell>
<mxCell id="p_phase" value="&lt;b&gt;Phase order&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="620" y="340" width="600" height="130" as="geometry"/></mxCell>
<mxCell id="p_phase_t" value="&lt;i&gt;1 catalog and discovery, 2 templates and one custom action,&lt;/i&gt;&lt;br&gt;&lt;i&gt;3 sign-in and a permission policy, 4 kubernetes plugin and TechDocs,&lt;/i&gt;&lt;br&gt;&lt;i&gt;5 move the cluster to EKS from the host.&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="632" y="386" width="576" height="72" as="geometry"/></mxCell>
<mxCell id="flow" value="&lt;b&gt;Flow&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=12;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="500" width="1200" height="140" as="geometry"/></mxCell>
<mxCell id="flow_0" value="&lt;i&gt;1  Backstage stores its data in its own database&lt;/i&gt;&lt;br&gt;&lt;i&gt;2  Templates and descriptors live in GitHub&lt;/i&gt;&lt;br&gt;&lt;i&gt;3  The Kubernetes plugin needs the cluster, and the kubeconfig first&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="32" y="540" width="420" height="88" as="geometry"/></mxCell>
<mxCell id="flow_1" value="&lt;i&gt;4  The kubeconfig is the one missing link to the host cluster&lt;/i&gt;&lt;br&gt;&lt;i&gt;5  EKS arrives in phase 5, run from the host and not from the VM&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="472" y="540" width="420" height="88" as="geometry"/></mxCell>
<mxCell id="e_a" value="1" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;html=1;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;exitX=0.7;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" source="bs" target="db" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e_b" value="2" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;html=1;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="bs" target="gh" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e_c" value="3" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;html=1;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="bs" target="kind" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e_d" value="4" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;html=1;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" source="kc" target="kind" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e_e" value="5" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;html=1;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;dashed=1;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="bs" target="aws" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
