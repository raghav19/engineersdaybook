<mxCell id="k8s" value="&lt;b&gt;Kubernetes cluster&lt;/b&gt;&lt;br&gt;&lt;small&gt;kind now, EKS in phase 5&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="l_out"><mxGeometry x="330" y="50" width="260" height="70" as="geometry"/></mxCell>
<mxCell id="idp" value="&lt;b&gt;Identity provider&lt;/b&gt;&lt;br&gt;&lt;small&gt;guest now, OIDC or GitHub later&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="l_out"><mxGeometry x="640" y="50" width="260" height="70" as="geometry"/></mxCell>
<mxCell id="flow" value="&lt;b&gt;Flow&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=12;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="610" width="1200" height="150" as="geometry"/></mxCell>
<mxCell id="flow_0" value="&lt;i&gt;1  A frontend plugin calls a backend plugin over HTTP&lt;/i&gt;&lt;br&gt;&lt;i&gt;2  A backend plugin reads core services for config and storage&lt;/i&gt;&lt;br&gt;&lt;i&gt;3  A module extends one plugin through its extension point&lt;/i&gt;&lt;br&gt;&lt;i&gt;4  Core services give each plugin its own database and cache&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="32" y="650" width="420" height="98" as="geometry"/></mxCell>
<mxCell id="flow_1" value="&lt;i&gt;5  Integrations reach GitHub and the Kubernetes cluster&lt;/i&gt;&lt;br&gt;&lt;i&gt;6  The Kubernetes plugin reads workloads from the cluster&lt;/i&gt;&lt;br&gt;&lt;i&gt;7  The auth plugin signs users in through one identity provider&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="472" y="650" width="420" height="98" as="geometry"/></mxCell>
