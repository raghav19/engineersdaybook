<mxCell id="db" value="&lt;b&gt;Database&lt;/b&gt;&lt;br&gt;&lt;small&gt;postgres in production, sqlite in dev&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="l_data"><mxGeometry x="20" y="50" width="310" height="70" as="geometry"/></mxCell>
