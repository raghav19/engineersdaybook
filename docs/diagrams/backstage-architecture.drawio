<mxCell id="be" value="&lt;b&gt;Backend&lt;/b&gt;&lt;br&gt;&lt;small&gt;the unit of deployment&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="l_be"><mxGeometry x="20" y="50" width="180" height="70" as="geometry"/></mxCell>
