<mxfile host="app.diagrams.net"><diagram id="catalog-entity-life" name="catalog-entity-life"><mxGraphModel adaptiveColors="auto" dx="1000" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="540" math="0" shadow="0"><root><mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="title" value="&lt;b&gt;Life of a catalog entity&lt;/b&gt;" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="1200" height="40" as="geometry"/></mxCell>
<mxCell id="l_src" value="Where descriptors live" style="swimlane;rounded=1;arcSize=6;startSize=26;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;html=1;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="360" height="250" as="geometry"/></mxCell>
<mxCell id="l_cat" value="Catalog backend" style="swimlane;rounded=1;arcSize=6;startSize=26;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;html=1;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="400" y="50" width="420" height="250" as="geometry"/></mxCell>
<mxCell id="l_use" value="Who reads the catalog" style="swimlane;rounded=1;arcSize=6;startSize=26;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;html=1;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="840" y="50" width="380" height="260" as="geometry"/></mxCell>
<mxCell id="repo" value="&lt;b&gt;Git repository&lt;/b&gt;&lt;br&gt;&lt;small&gt;one catalog-info.yaml per service&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="l_src"><mxGeometry x="20" y="50" width="320" height="70" as="geometry"/></mxCell>
<mxCell id="loc" value="&lt;b&gt;Location entity&lt;/b&gt;&lt;br&gt;&lt;small&gt;names the descriptor file to read&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="l_src"><mxGeometry x="20" y="160" width="320" height="70" as="geometry"/></mxCell>
<mxCell id="proc" value="&lt;b&gt;Processor&lt;/b&gt;&lt;br&gt;&lt;small&gt;reads and validates a descriptor&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="l_cat"><mxGeometry x="20" y="50" width="180" height="70" as="geometry"/></mxCell>
<mxCell id="prov" value="&lt;b&gt;Provider&lt;/b&gt;&lt;br&gt;&lt;small&gt;pushes entities from outside&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="l_cat"><mxGeometry x="220" y="50" width="180" height="70" as="geometry"/></mxCell>
<mxCell id="store" value="&lt;b&gt;Entity store&lt;/b&gt;&lt;br&gt;&lt;small&gt;kinds, relations, owner, lifecycle&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="l_cat"><mxGeometry x="20" y="160" width="380" height="70" as="geometry"/></mxCell>
<mxCell id="ui" value="&lt;b&gt;Catalog UI&lt;/b&gt;&lt;br&gt;&lt;small&gt;search and browse&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="l_use"><mxGeometry x="20" y="50" width="340" height="60" as="geometry"/></mxCell>
<mxCell id="k8s" value="&lt;b&gt;Kubernetes plugin&lt;/b&gt;&lt;br&gt;&lt;small&gt;matches pods to components&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="l_use"><mxGeometry x="20" y="120" width="340" height="60" as="geometry"/></mxCell>
<mxCell id="scaf" value="&lt;b&gt;Scaffolder&lt;/b&gt;&lt;br&gt;&lt;small&gt;registers the entities it creates&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="l_use"><mxGeometry x="20" y="190" width="340" height="60" as="geometry"/></mxCell>
<mxCell id="flow" value="&lt;b&gt;Flow&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=12;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="350" width="1200" height="160" as="geometry"/></mxCell>
<mxCell id="flow_0" value="&lt;i&gt;1  A Location names a descriptor file in a repository&lt;/i&gt;&lt;br&gt;&lt;i&gt;2  A processor reads the file and validates it&lt;/i&gt;&lt;br&gt;&lt;i&gt;3  A provider pushes entities the catalog cannot read itself&lt;/i&gt;&lt;br&gt;&lt;i&gt;4  The store keeps the kind, the relations and the owner&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="32" y="390" width="420" height="108" as="geometry"/></mxCell>
<mxCell id="flow_1" value="&lt;i&gt;5  Plugins read entities from the store&lt;/i&gt;&lt;br&gt;&lt;i&gt;6  The Kubernetes plugin matches pods to components&lt;/i&gt;&lt;br&gt;&lt;i&gt;7  The Scaffolder writes the entities it creates back&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="472" y="390" width="420" height="108" as="geometry"/></mxCell>
<mxCell id="e_a" value="1" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;html=1;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" source="loc" target="repo" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
