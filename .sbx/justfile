# Sandbox tooling, loaded by the root justfile as `mod sandbox`: `just sandbox <recipe>` from the repo root, any subfolder and this folder.
# Every recipe runs on the host. The module path says what it changes:
#   host    host/host.just: the services on the host: the ghcr.io login, the sbx daemon, VS Code
#   agent   agent/agent.just: what the VM receives: the skills, the secrets, the MCP servers, the kubeconfig, the kits
# Setup is 3 commands, in this order: `host setup`, `agent setup`, `agent kube` (optional). Then `run` every day. The README has the prerequisites.
# sbxenv.yaml declares the sandbox (kits, size, clone workspace). `sbx env run` prints that plan and asks for approval.

set quiet
set lazy
set shell := ['bash', '-euo', 'pipefail', '-c']

import 'lib/common.just'

mod host 'host/host.just'
mod agent 'agent/agent.just'

# List the sandbox recipes, host and agent
[default]
help:
    just --list --list-submodules --unsorted

# Every day. Create or start the sandbox and open VS Code on it, then return (detach)
run *args: _host-only _check-daemon agent::_kube-refresh && agent::mcp-load agent::git-token-sync host::vscode-setup _open-vscode
    sbx env run {{ sbx_dir }} --detach {{ args }}

[private]
_open-vscode:
    code --folder-uri "vscode-remote://ssh-remote+{{ name }}.sbx$(git rev-parse --show-toplevel)"
