# Sandbox tooling, loaded by the root justfile as `mod sandbox`, so recipes are run as `just sandbox <recipe>` from the repo root, from any
# subfolder and from this folder.
#
# Every recipe runs on the host machine, and the module path says what it changes:
#   host    host/host.just: the services on the host: the ghcr.io login, the squid proxy, the sbx daemon, VS Code
#   agent   agent/agent.just: what the VM receives: the kit, its allowed hosts, the skills, the secrets, the MCP servers, the kubeconfig
# `just sandbox` lists both with the step number of each recipe. The README has the one-time setup and the order.
#
# This file holds `run`, the ordered start that uses both modules. sbxenv.yaml declares the sandbox (kits, size, clone workspace). `sbx env run` prints
# that plan and asks for approval.

set quiet
set lazy
set shell := ['bash', '-euo', 'pipefail', '-c']

import 'shared.just'

mod host 'host/host.just'
mod agent 'agent/agent.just'

# list the sandbox recipes, host and agent, in the order to run them
[default]
help:
    just --list --list-submodules --unsorted

# the sandbox's MCP calls go through the daemon, and the daemon's through the proxy; the secrets must be in sbx before the sandbox starts

# Step 6 of 6, then every day. Create or start the sandbox and open VS Code on it, then return (detach)
run *args: _host-only _check-daemon host::_check-proxy agent::secrets-sync agent::_kubeconfig-auto && agent::mcp-install host::vscode-setup _open-vscode
    sbx env run {{ sbx_dir }} --detach {{ args }}

_open-vscode:
    code --folder-uri "vscode-remote://ssh-remote+{{ name }}.sbx$(git rev-parse --show-toplevel)"
