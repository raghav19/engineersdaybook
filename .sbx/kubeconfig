# The kubeconfig of the VM, the same for everyone, so it is committed. The VM reads it at /run/sandbox/source/.sbx/kubeconfig (KUBECONFIG in
# kits/dev-tools/tools.toml). It holds no credential and no CA:
#   server  the apiServerPort that clusters/kind/kind-config.yaml of Part 3 pins, reached through the sbx proxy as host.docker.internal
#   token   a placeholder. The sbx proxy replaces it with a real token that the host mints (kubeconfig-install in agent/agent.just registers that)
#   CA      none. The proxy opens the TLS session, and the VM trusts the proxy. `just sandbox agent kubeconfig-check` tells you if that holds.
apiVersion: v1
kind: Config
clusters:
- name: kind-sandbox
  cluster:
    server: https://host.docker.internal:6444
users:
- name: sandbox-viewer
  user:
    token: placeholder-kube
contexts:
- name: kind-sandbox
  context:
    cluster: kind-sandbox
    user: sandbox-viewer
current-context: kind-sandbox
