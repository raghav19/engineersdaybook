# Installed by `just sandbox host daemon-install`. See ../../README.md.
[Unit]
Description=Docker Sandboxes daemon (sandboxd), with its temp files on disk
# /tmp is a RAM disk on some machines; kit assembly unpacks the kit images into TMPDIR and can fill it.

[Service]
Environment=TMPDIR=%h/.cache/sbx-tmp
ExecStartPre=/usr/bin/mkdir -p %h/.cache/sbx-tmp
# sbx comes from mise (github:docker/sbx-releases in the root mise.toml). `latest` is the symlink mise keeps pointed at the installed version, so an
# upgrade does not break this path. A unit cannot use the mise shim: it resolves the version from the current directory's mise.toml, and a unit has none.
# Foreground on purpose: systemd supervises this process, and `--detach` would make it exit and the unit stop.
ExecStart=%h/.local/share/mise/installs/github-docker-sbx-releases/latest/sbx daemon start
Restart=on-failure

[Install]
WantedBy=default.target
