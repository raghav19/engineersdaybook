# The builder: BuildKit in a rootless gVisor container with no network device and no secret. It reaches the internet only through the builder proxy. Flow: README.md#image-build-flow
# The container is the wall, because any holder of the socket can run any build step. Quadlet keys: https://docs.podman.io/en/latest/markdown/podman-systemd.unit.5.html. %t is $XDG_RUNTIME_DIR.
# Compose keys: Requires=/After= is depends_on, Network=network_mode, Exec=command, AddCapability=cap_add, Health*=healthcheck, PodmanArgs=--runtime is runtime, MemoryMax=mem_limit, TasksMax=pids_limit, CPUQuota=200% is cpus: 2, MemorySwapMax=0 is memswap_limit.
# Notify=healthy is close to depends_on with condition: service_healthy.
[Unit]
Description=Builder of the agent sandbox (BuildKit and gVisor)
Requires=sandbox-builder-proxy.service
After=sandbox-builder-proxy.service
# A stop or a restart of sandbox-agent.service stops or restarts the builder.
PartOf=sandbox-agent.service

# No network at start, so no wait for network-online.
[Quadlet]
DefaultDependencies=false

[Container]
ContainerName=sandbox-builder
Image=localhost/sandbox-builder:latest
# The flags of runsc-builder are in builder/runsc.conf.
PodmanArgs=--runtime=runsc-builder
Network=none
# User 1000 is a subuid. It is the same subuid as the user agent, so the agent may connect.
User=1000
# rootlesskit needs these three capabilities for newuidmap. No other capability.
DropCapability=ALL
AddCapability=SETUID
AddCapability=SETGID
AddCapability=SYS_CHROOT
# no-new-privileges stays off. With it, rootlesskit hangs with no log and no socket.
# The flags: https://github.com/moby/buildkit/blob/master/docs/rootless.md
Exec=--addr unix:///run/buildkit/buildkitd.sock --oci-worker-no-process-sandbox --oci-worker-snapshotter=native
# The cache is in memory and counts against MemoryMax. A stop removes it.
Tmpfs=/home/user/.local/share/buildkit:rw,exec,mode=1777,size=1g
# buildkitd makes its socket here. The sandbox mounts this folder read-only.
Volume=%t/sandbox/buildkit:/run/buildkit
Volume=%t/sandbox-builder-proxy:/run/sandbox/proxy:ro
# buildkitd and the build steps use the relay in the builder. The builder proxy passes TLS through, so no CA is needed.
Environment=HTTPS_PROXY=http://127.0.0.1:3129
Environment=HTTP_PROXY=http://127.0.0.1:3129
Environment=NO_PROXY=localhost,127.0.0.1
# Ready when buildkitd lists a worker. sandbox-agent.service starts after that.
HealthCmd=buildctl --addr unix:///run/buildkit/buildkitd.sock debug workers
HealthInterval=5s
HealthTimeout=5s
HealthRetries=6
HealthStartPeriod=60s
Notify=healthy
# An unhealthy builder stops. systemd then restarts it with an empty cache.
HealthOnFailure=kill

[Service]
# gVisor ignores the limits of Podman, so systemd sets them. Without MemorySwapMax=0, swap hides MemoryMax. See https://www.freedesktop.org/software/systemd/man/latest/systemd.resource-control.html
MemoryMax=2G
MemorySwapMax=0
TasksMax=1024
CPUQuota=200%
# A subuid owns the folder, so chown runs in the user namespace of Podman. Mode 0700 keeps other host users out.
ExecStartPre=/usr/bin/mkdir -p -m 0711 %t/sandbox
ExecStartPre=/usr/bin/mkdir -p -m 0700 %t/sandbox/buildkit
ExecStartPre=/usr/bin/podman unshare chown 1000:1000 %t/sandbox/buildkit
TimeoutStartSec=300
# The relay on 127.0.0.1:3129 copies the bytes to the socket of the builder proxy. It starts after the builder is healthy.
ExecStartPost=/usr/bin/podman exec -d sandbox-builder socat TCP-LISTEN:3129,bind=127.0.0.1,fork,reuseaddr UNIX-CONNECT:/run/sandbox/proxy/proxy.sock
# buildkitd exits with code 1 on a stop, so systemctl shows failed after a stop. This is normal.
Restart=on-failure
