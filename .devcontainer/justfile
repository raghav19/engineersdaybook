# The image recipes of the agent sandbox. ../justfile loads this file as `mod sandbox`. Recipes run in this folder.
# Run the sandbox with devcontainer and docker compose: README.md#commands. Manual: https://just.systems/man/en/
#
#   just sandbox build     build the agent image.
#   just sandbox publish   push it to ghcr.io and pin it in .env.

set quiet
set shell := ['bash', '-euo', 'pipefail', '-c']

# --- Required tools ---
# If a tool is missing, just stops with a message before any recipe runs.
docker         := require("docker")
git            := require("git")

# --- Names ---
registry := 'ghcr.io/raghav19/engineersdaybook/sandbox-dev'
# The tag is the git tree sha of agent/ at HEAD. It changes only with the content of agent/, and a squash merge keeps it.
image := registry + ':' + shell(git + ' rev-parse HEAD:.devcontainer/agent')

# List the recipes (the default)
[default]
help:
    just --list --unsorted

# Flags go to docker build: `just sandbox build --no-cache` updates the tools that the Dockerfile pins by a prefix (claude, qwen).
# Test it with: AGENT_IMAGE=<image> devcontainer up --workspace-folder ..
# Build the agent image from the committed agent/. Commit agent/ first.
build *args:
    docker build agent -t {{ image }} {{ args }}

# Push the built image to ghcr.io and write its tag and digest into .env. Commit .env after. Needs `docker login ghcr.io`.
publish:
    docker push {{ image }}
    ref=$(docker image inspect -f '{{{{index .RepoDigests 0}}' {{ image }}) && \
        echo "AGENT_IMAGE={{ image }}@${ref#*@}" > .env
