# The agent sandbox as a Quadlet unit: no network, gVisor, no real token. The host proxy (agent/proxy) is its only way out. Flow: README.md#run-flow
# Quadlet keys: https://docs.podman.io/en/latest/markdown/podman-systemd.unit.5.html. %h is your home folder and %t is $XDG_RUNTIME_DIR.
# Compose keys: Requires=/After= is depends_on, Network=network_mode, Exec=command, RunInit=init, NoNewPrivileges=security_opt, Health*=healthcheck, PodmanArgs=--runtime is runtime, MemoryMax=mem_limit, TasksMax=pids_limit, CPUQuota=400% is cpus: 4, MemorySwapMax=0 is memswap_limit.
[Unit]
Description=Agent sandbox (Podman and gVisor)
# The builder and the host proxy start first and stop with this unit, so each session has a new builder and a new proxy.
Requires=sandbox-builder.service sandbox-proxy.service
After=sandbox-builder.service sandbox-proxy.service

# No network at start, so no wait for network-online.
[Quadlet]
DefaultDependencies=false

[Container]
ContainerName=sandbox-agent
Image=localhost/sandbox-dev:latest
# The gVisor flags are in agent/runsc.conf.
PodmanArgs=--runtime=runsc
Network=none
# In rootless Podman, the user agent is a subuid, not you.
User=agent
WorkingDir=/home/agent
Exec=sleep infinity
RunInit=true
# Healthy after the task sandbox:start writes /tmp/sandbox-ready. A failed check in the first 180 s does not count.
# Exec only keeps the container alive. ExecStartPost starts the relay and runs the task sandbox:start.
HealthCmd=test -e /tmp/sandbox-ready
HealthInterval=5s
HealthTimeout=3s
HealthRetries=3
HealthStartPeriod=180s
ReadOnly=true
DropCapability=ALL
NoNewPrivileges=true
Tmpfs=/tmp
Tmpfs=/run
# buildx writes its activity and its refs here. The rest of /etc/docker is read-only.
Tmpfs=/etc/docker/buildx/activity
Tmpfs=/etc/docker/buildx/refs
# Placeholders, not secrets. The proxy swaps each one for the real token. Each must equal a proxy_value in agent/proxy/iron-proxy.yaml.
Environment=GH_TOKEN=sandbox-placeholder-GH_TOKEN
Environment=CLAUDE_CODE_OAUTH_TOKEN=sandbox-placeholder-CLAUDE_CODE_OAUTH_TOKEN
Environment=QWEN_API_KEY=sandbox-placeholder-QWEN_API_KEY
Environment=DOCKER_CONFIG=/etc/docker
Environment=BUILDX_BUILDER=sandbox
# The relay that ExecStartPost starts listens here. A tool that ignores these variables has no route.
Environment=HTTP_PROXY=http://127.0.0.1:3128
Environment=HTTPS_PROXY=http://127.0.0.1:3128
Environment=http_proxy=http://127.0.0.1:3128
Environment=https_proxy=http://127.0.0.1:3128
Environment=NO_PROXY=localhost,127.0.0.1
Environment=NODE_USE_ENV_PROXY=1
# The CA of the proxy is mounted over this file. Each tool needs to read it.
Environment=SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
Environment=REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
Environment=GIT_SSL_CAINFO=/etc/ssl/certs/ca-certificates.crt
Environment=NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt
Environment=NODE_OPTIONS=--use-system-ca
Environment=HOME=/home/agent
Environment=TMPDIR=/tmp
Environment=COLORTERM=truecolor
Environment=SANDBOX_WORKSPACE=/home/agent/engineersdaybook
Environment=REPO_URL=https://github.com/raghav19/engineersdaybook
Environment=GIT_AUTHOR_NAME=agent
Environment=GIT_COMMITTER_NAME=agent
Environment=GIT_AUTHOR_EMAIL=agent@localhost
Environment=GIT_COMMITTER_EMAIL=agent@localhost
Environment=MISE_TRUSTED_CONFIG_PATHS=/home/agent/engineersdaybook
Environment=MISE_IGNORED_CONFIG_PATHS=/home/agent/engineersdaybook/mise.toml
Environment=CLAUDE_CONFIG_DIR=/home/agent/.claude
Environment=DISABLE_UPDATES=1
# The first four mounts are read-only. repo.git is a link that `just sandbox setup` makes to the .git folder of your main checkout.
Volume=%h/.local/state/sandbox/ca.crt:/etc/ssl/certs/ca-certificates.crt:ro
Volume=%t/sandbox:/run/sandbox/proxy:ro
Volume=%t/sandbox/buildkit:/run/sandbox/buildkit:ro
Volume=%h/.config/sandbox/repo.git:/run/sandbox/source:ro
# Keep this name, so the volume of the earlier setup keeps working.
Volume=sandbox-home:/home/agent

[Service]
# gVisor ignores the limits of Podman, so systemd sets them. Without MemorySwapMax=0, swap hides MemoryMax. See https://www.freedesktop.org/software/systemd/man/latest/systemd.resource-control.html
# gVisor counts host threads. Raise TasksMax if a heavy job hits the limit.
# A normal stop ends sleep with TERM (exit code 143). A kill by a limit (137) still shows failed.
SuccessExitStatus=143
MemoryMax=3G
MemorySwapMax=0
TasksMax=2048
CPUQuota=400%
# These steps run in order, and a failed step fails the start. 1. gVisor cannot bring up the loopback interface of the guest, so the host does it.
ExecStartPost=/bin/sh -c 'pid=$(podman inspect -f "{{.State.Pid}}" sandbox-agent) && podman unshare nsenter --net=/proc/$pid/ns/net ip link set lo up'
# 2. The relay on 127.0.0.1:3128 copies the bytes to the socket of the host proxy.
ExecStartPost=/usr/bin/podman exec -d sandbox-agent socat TCP-LISTEN:3128,bind=127.0.0.1,fork,reuseaddr UNIX-CONNECT:/run/sandbox/proxy/proxy.sock
# 3. The task sandbox:start (agent/image/tasks.toml) prepares the home and the clone, and installs the plugins. The first start is slow, so the timeout is high.
ExecStartPost=/usr/bin/podman exec sandbox-agent mise run sandbox:start
TimeoutStartSec=300
