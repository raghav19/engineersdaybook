// The entry of the agent sandbox for the devcontainer CLI: `devcontainer up --workspace-folder .` from the repo root. Spec: https://containers.dev/implementors/json_reference/
// The CLI has no stop. `docker compose -p sandbox stop` or `down` stops the sandbox.
{
  "name": "sandbox",
  "dockerComposeFile": "compose.yaml",
  "service": "agent",
  "runServices": ["builder-proxy", "builder", "proxy", "agent"],
  // The clone: devcontainer exec and the lifecycle commands start here. The image makes the empty folder, because the CLI enters it before on-create.sh clones.
  // Must equal SANDBOX_WORKSPACE in compose.yaml.
  "workspaceFolder": "/home/agent/engineersdaybook",
  "remoteUser": "agent",
  "updateRemoteUserUID": false,
  // Keep the command of compose.yaml. The default runs the CMD of the image (bash), which exits without a TTY.
  "overrideCommand": false,
  // Runs on the host, in the repo root: it gives a new proxy a new CA and its tokens.
  "initializeCommand": ".devcontainer/init.sh",
  // The scripts come from the read-only mount of lifecycle/ in compose.yaml.
  // Runs once in each new container: the home and the clone.
  "onCreateCommand": "bash /run/sandbox/lifecycle/on-create.sh",
  // Runs after each start: the shell setup, the completions and the ready file for the healthcheck.
  "postStartCommand": "bash /run/sandbox/lifecycle/post-start.sh"
}
