// The entry of the agent sandbox for the devcontainer CLI: `devcontainer up --workspace-folder .` from the repo root. Spec: https://containers.dev/implementors/json_reference/
// The CLI has no stop. `docker compose -p sandbox stop` or `down` stops the sandbox.
{
  "name": "sandbox",
  "dockerComposeFile": "compose.yaml",
  "service": "agent",
  "runServices": ["builder-proxy", "builder", "proxy", "agent"],
  // Lifecycle commands run in this folder. The clone does not exist before on-create.sh makes it.
  "workspaceFolder": "/home/agent",
  "remoteUser": "agent",
  "updateRemoteUserUID": false,
  // Keep the command of compose.yaml. The default runs the CMD of the image (bash), which exits without a TTY.
  "overrideCommand": false,
  // Runs on the host, in the repo root: it checks the one-time setup, then gives a new proxy its token.
  "initializeCommand": ".devcontainer/init.sh",
  // Runs once in each new container: the home and the clone. compose.yaml mounts the script.
  "onCreateCommand": "/opt/sandbox/on-create.sh",
  // Runs after each start: the shell setup, the completions and the ready file for the healthcheck.
  "postStartCommand": "/opt/sandbox/post-start.sh"
}
