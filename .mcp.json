{
  "mcpServers": {
    "drawio": {
      "type": "http",
      "url": "https://mcp.draw.io/mcp"
    },
    "github": {
      "command": "docker",
      "args": [
        "run", "--rm", "-i",
        "--network", "mcp-egress-github",
        "--read-only", "--tmpfs", "/tmp",
        "--cap-drop", "ALL",
        "--security-opt", "no-new-privileges",
        "--user", "10001:10001",
        "--log-driver", "journald",
        "-e", "HTTPS_PROXY=http://mcp-egress-proxy:3128",
        "-e", "HTTP_PROXY=http://mcp-egress-proxy:3128",
        "-v", "${MCP_GH_KEY_PATH}:/key.pem:ro",
        "ghcr.io/github/github-mcp-server@sha256:508a0857ec762b1ab1cece29193345b501fab1dd9d1228a7b617062954cecac6",
        "stdio",
        "--app-id", "${MCP_GH_APP_ID}",
        "--app-installation-id", "${MCP_GH_INSTALLATION_ID}",
        "--app-private-key-path", "/key.pem",
        "--toolsets", "context,issues,pull_requests,repos",
        "--exclude-tools", "create_repository,fork_repository,get_teams,get_team_members,list_repository_collaborators"
      ]
    },
    "flux-schema-catalog": {
      "type": "http",
      "url": "https://schemas.fluxoperator.dev/mcp"
    }
  }
}
