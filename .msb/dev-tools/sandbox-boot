#!/bin/bash
# The command of the msb sandbox (cmd in sandbox.yaml). It runs as root. It prepares the workspace, then it waits.
# You can run it again at any time, and `just msb run` does so each time: every step does nothing if its work is done already.
# `sandbox-boot prepare` does the steps and then exits. Without the word, the script waits after the steps, and that keeps the VM up.
# If a step fails, the script prints the reason and exits with 1. As the command of a new VM, this stops the VM: `msb logs <name>` shows the reason.
# The file /run/sandbox-ready exists only after a good run. `just msb run` waits for it.
# Values from sandbox.yaml: SANDBOX_WORKSPACE (the path of the clone), SANDBOX_BRANCH and REPO_URL.
# This script does not set the git identity (sandbox.yaml sets it) or the GitHub token helper (the image sets it).
set -eu

ws=${SANDBOX_WORKSPACE:?SANDBOX_WORKSPACE is not set}
home=/home/agent
ready=/run/sandbox-ready
headroom_log=/tmp/headroom.log
mode=${1:-wait}
# In `msb exec`, msb sets NODE_EXTRA_CA_CERTS to a file that does not exist, and node prints a warning for each call. Drop the variable then.
[ -e "${NODE_EXTRA_CA_CERTS:-}" ] || unset NODE_EXTRA_CA_CERTS
fail() { echo "sandbox-boot: $*" >&2; exit 1; }
as_agent() { runuser -u agent -- env HOME="$home" "$@"; }

rm -f "$ready"
mkdir -p "$(dirname "$ws")" "$home/.claude" "$home/.cache/terraform-providers" "$home/.local/share/containers"
chown agent:agent "$(dirname "$ws")" "$home/.claude" "$home/.cache" "$home/.cache/terraform-providers" "$home/.local" "$home/.local/share" "$home/.local/share/containers" || fail "chown of the workspace folders failed"

# Podman, rootless as agent. The VM kernel makes /dev/fuse and /dev/net/tun for root only. These are devices of the VM, not of the host.
# fuse-overlayfs needs /dev/fuse, and the network of a container (pasta) needs /dev/net/tun. The agent group can use them, and no other user.
# `/` must be a shared mount, or podman prints a warning and can miss mounts.
chgrp agent /dev/fuse /dev/net/tun && chmod 660 /dev/fuse /dev/net/tun || fail "could not open /dev/fuse and /dev/net/tun for podman"
mount --make-rshared / || fail "could not make / a shared mount for podman"

# The clone is private. The VM cannot write to /run/sandbox/source, which is the .git directory of the host repo.
# The clone starts on the branch of the host checkout. Push goes to GitHub, to a feature branch.
if [ ! -d "$ws/.git" ]; then
  as_agent git clone --no-hardlinks ${SANDBOX_BRANCH:+--branch "$SANDBOX_BRANCH"} /run/sandbox/source "$ws" || fail "git clone failed (branch: ${SANDBOX_BRANCH:-the default})"
  as_agent git -C "$ws" remote set-url origin "$REPO_URL" || fail "could not set origin to $REPO_URL"
fi
as_agent sh -c "cd '$ws' && prek install --allow-missing-config" || fail "prek install failed"

# The Headroom proxy for Claude Code listens on 127.0.0.1:8787. ANTHROPIC_BASE_URL in .claude/settings.json points to it.
# Wait until it answers.
# A run of this script when Headroom runs already starts no second one.
curl -sf -o /dev/null http://127.0.0.1:8787/health || as_agent sh -c "setsid nohup headroom proxy --port 8787 >$headroom_log 2>&1 &"
for _ in $(seq 60); do
  curl -sf -o /dev/null http://127.0.0.1:8787/health && break
  sleep 1
done
curl -sf -o /dev/null http://127.0.0.1:8787/health || { tail -n 20 "$headroom_log" >&2; fail "Headroom did not answer on 127.0.0.1:8787 in 60 seconds"; }

# Ponytail is a plugin for Claude Code. The version is a release tag. The plugin goes to the claude-home volume, so a new VM finds it there.
# A failure prints a warning and does not stop the boot, as in sbx.
as_agent sh -c "claude plugin marketplace add DietrichGebert/ponytail#v5.3.2; claude plugin install ponytail@ponytail" \
  || echo "sandbox-boot: warning: the ponytail plugin is not installed" >&2

touch "$ready"
echo "sandbox-boot: ready"
[ "$mode" = prepare ] || exec sleep infinity
