[
  {
    "name": "markdown-preview",
    "displayName": "Markdown Preview",
    "repo": "https://github.com/eugenioenko/ttt-plugins",
    "version": "0.1.0",
    "enabled": true,
    "permissions": {
      "panel.editor": true,
      "commands": true,
      "editor.read": true
    },
    "grantsVersion": 2
  },
  {
    "name": "omarchy-theme",
    "displayName": "Omarchy Theme",
    "repo": "https://github.com/eugenioenko/ttt-plugins",
    "version": "0.1.0",
    "enabled": true,
    "permissions": {
      "fs.read": ["~/.local/state/omarchy"],
      "fs.write": ["{config}/themes"],
      "settings": true,
      "settings_keys": ["theme"],
      "commands": true
    },
    "grantsVersion": 2
  }
]
