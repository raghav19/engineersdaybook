{
  "check_for_updates": false,
  "auto_attach": false,
  "plugins": {
    "agent_discovery": {"enabled": false},
    "agent_sessions": {"enabled": false},
    "agent_sessions_claude_code": {"enabled": false},
    "agent_sessions_codex": {"enabled": false},
    "agent_sessions_multiplexers": {"enabled": false},
    "agent_sessions_orchestrators": {"enabled": false},
    "agent_sessions_tmux": {"enabled": false},
    "orchestrator": {"enabled": false},
    "live_sessions": {"enabled": false},
    "dashboard": {"enabled": false},
    "welcome": {"enabled": false},
    "welcome_screen": {"enabled": false}
  },
  "clipboard": {"use_osc52": true, "use_system_clipboard": false},
  "lsp": {
    "python": [
      {"name": "ty", "command": "ty", "args": ["server"], "auto_start": true, "root_markers": ["pyproject.toml", ".git"]},
      {"name": "ruff", "command": "ruff", "args": ["server"], "auto_start": true, "root_markers": ["pyproject.toml", ".git"]}
    ],
    "terraform": [{"name": "terraform-ls", "command": "terraform-ls", "args": ["serve"], "auto_start": true}],
    "yaml": [{"name": "yaml-language-server", "command": "yaml-language-server", "args": ["--stdio"], "auto_start": true}],
    "toml": [{"name": "taplo", "command": "taplo", "args": ["lsp", "stdio"], "auto_start": true}],
    "markdown": [{"name": "marksman", "command": "marksman", "args": ["server"], "auto_start": true, "process_limits": {"enabled": false}}],
    "bash": [{"name": "bash-language-server", "command": "bash-language-server", "args": ["start"], "auto_start": true, "process_limits": {"enabled": false}}],
    "dockerfile": [{"name": "docker-language-server", "command": "docker-language-server", "args": ["start", "--stdio"], "auto_start": true}],
    "justfile": [{"name": "just-lsp", "command": "just-lsp", "args": [], "auto_start": true}]
  }
}
