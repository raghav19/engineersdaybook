# The msb sandbox: a microsandbox VM for Claude Code and VS Code. ../justfile loads this file as `mod msb`. Use `just msb <recipe>`.
# Every recipe runs on the host. sandbox.yaml declares the VM. The recipe `run` makes the VM from it.
# If sandbox.yaml changes, `run` tells you to remove the VM first.
# The recipes list the steps in order. msb.py has the logic of the steps that need logic.
#
#   just msb setup        once for each host: authorize your SSH key and connect VS Code
#   just msb run          every day: make the VM if none exists, then open VS Code on it
#   just msb allow-host   allow one more host for the VM
#   just msb github-login log in to GitHub (once, and when it asks for it)
#   just msb image-build  build the image after you change a file of dev-tools/
#   just msb image-publish  push the image to ghcr.io (the token comes from Bitwarden)

set quiet
set shell := ['bash', '-euo', 'pipefail', '-c']

# msb.py reads these three values.
export MSB_NAME := 'sandbox-dev'
export MSB_IMAGE := 'engineersdaybook-sandbox:local'
# The path of the clone in the VM. SANDBOX_WORKSPACE in sandbox.yaml has the same value.
export MSB_WORKSPACE := '/home/agent/engineersdaybook'

msb_dir := source_directory()
step := msb_dir / 'msb.py'
volumes := 'claude-home terraform-providers podman-storage'
registry := 'ghcr.io/raghav19/engineersdaybook/dev-sbx'
registry_user := 'raghav19'
# The timestamp of every file of the published image (a fixed date in 2023). Do not change it: a new value gives every layer a new digest.
image_epoch := '1700000000'

# List the recipes (the default)
[default]
help:
    just --list --unsorted

_host-only:
    [ -z "${SANDBOX_NAME:-}" ] || { echo "Run this on the host. You are in the sbx sandbox $SANDBOX_NAME, and msb and Docker are on the host." >&2; exit 1; }

# Once for each host (safe to run again): authorize your SSH key for `msb ssh`, install Remote-SSH, set VS Code to use .msb/ssh_config
setup: _host-only
    key=$({{ step }} ssh-key) && msb ssh authorize --file "$key"
    code --install-extension ms-vscode-remote.remote-ssh
    {{ step }} vscode-settings
    echo "Setup is complete. Next, run: just msb image-build. Then run: just msb run"

# Log in to GitHub with the GitHub App: you type a code in the browser. The tokens go to ~/.config/msb/github-app.json (mode 600). The VM never has them
github-login: _host-only
    {{ step }} github-login

# Build the image from dev-tools/ and load it into msb. Needs Docker. The first build takes several minutes
image-build: _host-only
    docker build -t $MSB_IMAGE {{ msb_dir }}/dev-tools
    docker save $MSB_IMAGE | msb load --tag $MSB_IMAGE
    echo "The image $MSB_IMAGE is in msb now. A VM that exists keeps the old image. To use the new image, run: just msb rm && just msb run"

# Stop if BWS_ACCESS_TOKEN is not set. `bws run` reads it. It is the access token of the Bitwarden machine account
_vault:
    [ -n "${BWS_ACCESS_TOKEN:-}" ] || { echo "msb: BWS_ACCESS_TOKEN is not set. Set it, for example: export BWS_ACCESS_TOKEN=\$(cat ~/.config/bws/access-token)" >&2; exit 1; }

# The tags are the commit, `latest` on main and the git tag of the commit. All files get the same fixed timestamp (image_epoch), and the build adds no
# provenance and no SBOM. So the same files give the same digest. The date of the last commit would not work: a new commit would change the timestamp of
# every file, so every layer would get a new digest and no layer could be reused.
# The layers of every stage go to the registry as a cache (the tag `cache`). A new version of one tool rebuilds one stage, and any machine gets the other stages from the cache.
# The cache needs a builder with the docker-container driver. The default builder cannot export it, so the recipe makes the builder `msb-builder` once.
# The push token is the Bitwarden key GITHUB_TOKEN (a classic token with the scope write:packages). `bws run` gives it to the login command only. The login goes
# to a temporary Docker config folder that the recipe removes at the end. So no login stays on disk, and your ~/.docker/config.json is not used or changed.

# Maintainer. Build the image and push it to ghcr.io with zstd layers (level 9, as the sbx kits)
[script]
image-publish: _host-only _vault
    tags=$({{ step }} image-tags)
    docker buildx inspect msb-builder >/dev/null 2>&1 || docker buildx create --name msb-builder --driver docker-container >/dev/null
    args=()
    for tag in $tags; do args+=(-t "{{ registry }}:$tag"); done
    meta=$(mktemp)
    login=$(mktemp -d)
    trap 'rm -rf -- "$login" "$meta"' EXIT
    reg='{{ registry }}'
    bws run -- 'printf %s "$GITHUB_TOKEN" | DOCKER_CONFIG='"$login"' docker login '"${reg%%/*}"' -u {{ registry_user }} --password-stdin'
    # The builder and its state stay where they are. Only the login is in the temporary folder.
    export DOCKER_CONFIG="$login" BUILDX_CONFIG="${BUILDX_CONFIG:-$HOME/.docker/buildx}"
    docker buildx build --builder msb-builder {{ msb_dir }}/dev-tools "${args[@]}" \
      --provenance=false --sbom=false \
      --cache-from type=registry,ref={{ registry }}:cache \
      --cache-to type=registry,ref={{ registry }}:cache,mode=max \
      --build-arg SOURCE_DATE_EPOCH={{ image_epoch }} \
      --output type=registry,compression=zstd,compression-level=9,force-compression=true,rewrite-timestamp=true \
      --metadata-file "$meta"
    digest=$(jq -r '."containerimage.digest"' "$meta")
    echo "published {{ registry }}@$digest with the tags: $tags"

# Every day. Make the VM from sandbox.yaml if none exists, then open VS Code on it
run: _host-only _vault
    {{ step }} preflight
    # Only this step runs under `bws run`: the Bitwarden keys are variables in its environment. `code` and the other steps do not get them
    bws run -- '{{ step }} ensure-vm'
    {{ step }} wait-boot
    code --folder-uri "vscode-remote://ssh-remote+$MSB_NAME.msb$MSB_WORKSPACE"

# Allow one more host for the VM: add it to network.allow in sandbox.yaml, then run. If a VM exists, `run` tells you to remove it first
allow-host host: _host-only && run
    {{ step }} check-host '{{ host }}'
    HOST='{{ host }}' yq -i '.network.allow += [strenv(HOST)] | .network.allow |= unique' {{ msb_dir }}/sandbox.yaml
    echo "{{ host }} is now in network.allow."

# A bash prompt in the VM, as the agent user
shell: _host-only
    msb exec -t -u agent $MSB_NAME -- bash -l

# Remove the VM. `--volumes` also removes the Claude login and settings, and the Terraform provider cache and the podman images
rm *args: _host-only
    msb rm -f $MSB_NAME || true
    if [ "{{ args }}" = "--volumes" ]; then msb volume rm {{ volumes }} || true; fi
