# The msb sandbox: a microsandbox microVM for Claude Code and VS Code. Loaded by ../justfile as `mod msb`: `just msb <recipe>`.
# Every recipe runs on the host. sandbox.yaml declares the whole VM; `run` makes the VM from it, and makes it again when the file changes.
#
#   just msb setup        once per machine: authorize your SSH key, connect VS Code
#   just msb run          every day: create or start the VM and open VS Code on it
#   just msb allow-host   allow one more host for the VM
#   just msb image-build  build the image after you change image/tools.toml or image/Dockerfile

set quiet
set lazy
set shell := ['bash', '-euo', 'pipefail', '-c']
set script-interpreter := ['bash', '-euo', 'pipefail']

msb_dir := source_directory()
repo := parent_directory(msb_dir)
name := 'sandbox-dev'
image := 'engineersdaybook-sandbox:local'
volume := 'claude-home'

# The host values that sandbox.yaml names (${NAME}). `run` puts them in its environment, with the [env] lines above it.
# (A variable that you mark with `export` is evaluated for every recipe, even with `set lazy`. These are only evaluated by `run`.)
workspace := shell('git -C "$1" rev-parse --show-toplevel', repo)
git_dir := shell('git -C "$1" rev-parse --path-format=absolute --git-common-dir', repo)
branch := shell('git -C "$1" branch --show-current', repo)
repo_url := shell('git -C "$1" remote get-url origin | sed -E "s#^(ssh://)?git@github.com[:/]#https://github.com/#"', repo)
git_user_name := shell('git -C "$1" config user.name || echo agent', repo)
git_user_email := shell('git -C "$1" config user.email || echo agent@localhost', repo)
# The token of the host `gh` login. It is empty without a login, and `run` stops then.
github_token := shell('gh auth token 2>/dev/null || true')

# List the recipes (the default)
[default]
help:
    just --list --unsorted

_host-only:
    [ -z "${SANDBOX_NAME:-}" ] || { echo "Run this on the host, not in the sandbox ($SANDBOX_NAME): msb and Docker are on the host." >&2; exit 1; }

# Once per machine, safe to run again: authorize your SSH key for `msb ssh`, install Remote-SSH, point VS Code at .msb/ssh_config
[script]
setup: _host-only
    key="${SANDBOX_SSH_PUBKEY:-$HOME/.ssh/id_ed25519.pub}"
    [ -r "$key" ] || { echo "No SSH public key at $key. Make one (ssh-keygen -t ed25519), or set SANDBOX_SSH_PUBKEY. ssh_config uses ~/.ssh/id_ed25519." >&2; exit 1; }
    msb ssh authorize --file "$key"
    code --install-extension ms-vscode-remote.remote-ssh
    f="$HOME/.config/Code/User/settings.json"
    mkdir -p "$(dirname "$f")"
    [ -f "$f" ] || echo '{}' > "$f"
    merged=$(jq --arg cfg "{{ msb_dir }}/ssh_config" '. * {
      "remote.SSH.configFile": $cfg,
      "remote.SSH.defaultExtensions": [
        "astral-sh.ty",
        "charliermarsh.ruff",
        "tamasfe.even-better-toml",
        "kennylong.kubernetes-yaml-formatter",
        "yzhang.markdown-all-in-one",
        "skellock.just",
        "isontheline.vscode-sysmon"
      ],
      "remote.SSH.useExecServer": false,
      "remote.SSH.enableDynamicForwarding": false,
      "remote.SSH.enableAgentForwarding": false,
      "remote.SSH.connectTimeout": 30,
      "remote.SSH.showLoginTerminal": false,
      "remote.SSH.localServerDownload": "always",
      "update.mode": "none",
      "extensions.autoUpdate": "off",
      "extensions.autoCheckUpdates": false
    }' "$f")
    if [ "$merged" != "$(cat "$f")" ]; then echo "$merged" > "$f"; echo "VS Code settings updated in $f (applies to windows opened from now on)"; fi
    echo "setup done. Next: just msb image-build, then just msb run"

# Build the image from image/ and load it into msb. Needs Docker. The first build takes several minutes
[script]
image-build: _host-only
    docker build -t {{ image }} {{ msb_dir }}/image
    docker save {{ image }} | msb load --tag {{ image }}
    echo "image {{ image }} loaded. Run: just msb run (a running VM is made again, if the image changed)"

# The token is in the environment of this recipe only, so msb sees it and the VM gets a placeholder.
# Run `run` as often as you like: it never makes a second VM, and it makes the VM again only when sandbox.yaml, the image or a host value changed.
# Every day. Create or start the VM from sandbox.yaml, then open VS Code on it
[env('GITHUB_TOKEN', github_token)]
[env('SANDBOX_WORKSPACE', workspace)]
[env('SANDBOX_MISE_IGNORED', workspace + '/mise.toml')]
[env('SANDBOX_GIT_DIR', git_dir)]
[env('SANDBOX_BRANCH', branch)]
[env('REPO_URL', repo_url)]
[env('GIT_USER_NAME', git_user_name)]
[env('GIT_USER_EMAIL', git_user_email)]
[script]
run: _host-only
    command -v msb >/dev/null || { echo "msb is not on the PATH. Run: mise install && eval \"\$(mise activate bash)\"" >&2; exit 1; }
    [ -n "$GITHUB_TOKEN" ] || { echo "gh has no login, so git push in the VM would fail. Run: gh auth login" >&2; exit 1; }
    image_id=$(docker image inspect {{ image }} 2>/dev/null | jq -r '.[0].Id') && [ -n "$image_id" ] \
      || { echo "The image {{ image }} does not exist. Run: just msb image-build" >&2; exit 1; }

    # running, stopped (or crashed), or missing
    vm_state() { msb inspect {{ name }} --format json 2>/dev/null | jq -r '.status | ascii_downcase' || echo missing; }
    # the fingerprint that the VM was made from: msb keeps it as the label config-sha
    vm_made_from() { msb inspect {{ name }} --format json | jq -r '.config.labels["config-sha"] // ""'; }
    # unpushed work in the clone, which removing the VM would delete
    unpushed_work() { msb exec {{ name }} -u agent -- sh -c "cd '$SANDBOX_WORKSPACE' 2>/dev/null && { git status --porcelain; git log --branches --not --remotes --oneline; }" || true; }

    # The fingerprint of what we would make now: sandbox.yaml, the image, and the host values (another repo path is another mount). The token is not one of them.
    wanted=$(cat {{ msb_dir }}/sandbox.yaml <(echo "$image_id" "$SANDBOX_WORKSPACE" "$SANDBOX_GIT_DIR" "$SANDBOX_MISE_IGNORED" "$REPO_URL" "$GIT_USER_NAME" "$GIT_USER_EMAIL") | sha256sum | cut -c1-16)
    state=$(vm_state)

    # 1. A VM that was made from an older fingerprint is removed, unless its clone holds unpushed work. The {{ volume }} volume stays.
    if [ "$state" != missing ] && [ "$(vm_made_from)" != "$wanted" ]; then
      echo "msb: sandbox.yaml, the image or a host value changed, so the VM is made again (the {{ volume }} volume stays)"
      [ "$state" = running ] || msb start {{ name }} >/dev/null
      dirty=$(unpushed_work)
      if [ -n "$dirty" ] && [ -z "${SANDBOX_FORCE:-}" ]; then
        echo "msb: the clone in the VM has work that is not pushed (below). Push it, or run again with SANDBOX_FORCE=1 to drop it." >&2
        echo "$dirty" >&2
        exit 1
      fi
      msb rm -f {{ name }} >/dev/null
      state=missing
    fi

    # 2. Make the VM, or start it, or leave it as it is.
    case $state in
      missing)
        # A boot that failed leaves a stale folder, and msb then says "already exists" (microsandbox issue 1908). `msb ls` does not list it: remove it.
        rm -rf "${MSB_HOME:-$HOME/.microsandbox}/sandboxes/{{ name }}"
        msb run -d --name {{ name }} --conf {{ msb_dir }}/sandbox.yaml --label "config-sha=$wanted" ;;
      running) ;;
      *) msb start {{ name }} ;;
    esac

    # 3. Wait for the boot. sandbox-boot clones the repo, installs the hook and starts Headroom, then writes /run/sandbox-ready.
    # If a step fails, sandbox-boot exits with an error and that stops the VM: the loop ends, and the boot log shows the reason.
    for _ in $(seq 120); do
      [ "$(vm_state)" = running ] || break
      msb exec {{ name }} -- test -f /run/sandbox-ready 2>/dev/null && break
      sleep 1
    done
    msb exec {{ name }} -- test -f /run/sandbox-ready 2>/dev/null \
      || { echo "msb: the sandbox did not finish its boot. Its log (msb logs {{ name }}):" >&2; msb logs {{ name }} 2>&1 | tail -n 15 >&2; exit 1; }

    # 4. Open VS Code on the clone.
    code --folder-uri "vscode-remote://ssh-remote+{{ name }}.msb$SANDBOX_WORKSPACE"

# Allow one more host for the VM: add it to network.allow in sandbox.yaml, then make the VM again
allow-host host: _host-only && run
    [[ '{{ host }}' =~ ^(\*\.)?[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?$ ]] || { echo "Not a host name: {{ host }}" >&2; exit 1; }
    HOST='{{ host }}' yq -i '.network.allow += [strenv(HOST)] | .network.allow |= unique' {{ msb_dir }}/sandbox.yaml
    echo "added {{ host }} to network.allow"

# A bash prompt in the VM, as the agent user, in the clone
shell: _host-only
    msb exec -t -u agent {{ name }} -- bash -l

# Delete the VM. `--volumes` also deletes the Claude login and settings
[script]
rm *args: _host-only
    msb rm -f {{ name }} || true
    if [ "{{ args }}" = "--volumes" ]; then msb volume rm {{ volume }} || true; fi
