# The msb sandbox: a microsandbox VM for Claude Code and the TTT editor. ../justfile loads this file as `mod msb`. Use `just msb <recipe>`.
# Every recipe runs on the host. vm/sandbox.yaml declares the VM. The recipe `run` makes the VM from it.
# If vm/sandbox.yaml changes, `run` tells you to remove the VM first.
# The recipes list the steps in order. msb.py has the steps that need Python.
#
#   just msb setup          once for each host: authorize your SSH key.
#   just msb run            every day: register the VM, start the agent of the host, make or start the VM, and prepare it. Then check its SPIFFE identity and open the TTT editor in it.
#   just msb edit           open the TTT editor in the running VM, in this terminal. Quit with Ctrl+Q.
#   just msb allow-host     allow one more host for the VM.
#   just msb sync-kubeconfig  make the read-only ServiceAccount of the agent in k3s (before the first run), and give the running VM a token of it.
#   just msb github-login   log in to GitHub (once, and when it asks for it).
#   just msb host-register  register this host with the SPIRE server: the node certificate, the node entry and the delegate entry.
#   just msb vm-register    register the VM with the SPIRE server: its entry. `vm-unregister` and `host-unregister` remove them.
#   just msb agent-up       install the SPIRE agent of the host, the msbvm plugin and the delegate, and start the agent. `agent-down` stops it. `agent-status` shows it.
#   just msb identity       ask the agent of the host for the SVID of the VM, and check its ID. `run` does this.
#   just msb build          build the image after you change a file of image/, push it to ghcr.io, and pin its digest in vm/sandbox.yaml.

set quiet
set shell := ['bash', '-euo', 'pipefail', '-c']
set script-interpreter := ['bash', '-euo', 'pipefail']

# msb.py reads these two values.
export MSB_NAME := 'sandbox-dev'
# The path of the clone in the VM. SANDBOX_WORKSPACE in vm/sandbox.yaml has the same value.
export MSB_WORKSPACE := '/home/agent/engineersdaybook'
# The node identity of the VM (key, certificate, trust bundle). `node-cert` fills it. vm/sandbox.yaml mounts it read-only in the VM.
export SANDBOX_NODE_DIR := home_directory() / '.config/msb/node'

# The registration of the agent workload identity (k3s/host-registration.yaml and k3s/vm-registration.yaml).
# MSB_NODE is the name of this host in the SPIRE server: the host name in lower case. A new host registers under its own name.
export MSB_NODE := lowercase(shell('hostname'))
# The GitHub login of the owner of the host. k3s/host-registration.yaml puts it in the node certificate and in the IDs.
export MSB_GITHUB_ID := 'raghav19'
# The node identity of the host agent (key, certificate, trust bundle). `host-register` fills it.
export HOST_NODE_DIR := home_directory() / '.config/msb/host-node'
# Where the delegate binary lives. The delegate entry has this path as a selector, so the agent only accepts the delegate at this path.
awi_bin := home_directory() / '.local/share/agent-workload-identity/bin'
delegate_path := awi_bin / 'delegate'
# The code of the project and the SPIRE agent of the host (code/agent-workload-identity/agent/agent.conf.tmpl).
awi_dir := msb_dir / '../code/agent-workload-identity'
spire_version := '1.15.5'
spire_cache := home_directory() / '.cache/agent-workload-identity/spire-' + spire_version
agent_state := home_directory() / '.local/state/agent-workload-identity/spire-agent'
agent_run := env('XDG_RUNTIME_DIR', '/tmp') / 'awi-spire-agent'
agent_admin := env('XDG_RUNTIME_DIR', '/tmp') / 'awi-spire-agent-admin'
msb_db := home_directory() / '.microsandbox/db/msb.db'

# --- Required tools ---
msb    := require("msb")
bws    := require("bws")
age    := require("age")
uv      := require("uv")
podman  := require("podman")
jq      := require("jq")
yq      := require("yq")
ssh     := require("ssh")
kubectl := require("kubectl")

# --- Required environment variables ---
in_bws                  := env('MSB_IN_BWS', '')
GH_TOKEN                := if in_bws == '' { '' } else { env('GH_TOKEN') }
CLAUDE_CODE_OAUTH_TOKEN := if in_bws == '' { '' } else { env('CLAUDE_CODE_OAUTH_TOKEN') }
GITHUB_TOKEN            := if in_bws == '' { '' } else { env('GITHUB_TOKEN') }
QWEN_API_KEY            := if in_bws == '' { '' } else { env('QWEN_API_KEY') }

msb_dir := source_directory()
step := msb_dir / 'msb.py'
# The agent in the VM reaches the k3s API server with the token of the ServiceAccount sandbox-agent (k3s/sandbox-agent-rbac.yaml).
# The token stays on the host and in msb. The VM holds the placeholder $MSB_K8S_TOKEN. The token lasts one year and is not rotated.
# kube_ctx is the kubectl context of the host. k3s names it `default`. k8s_ca_file is the public CA of k3s. msb trusts it for the API server. `_vm` gives it to msb.py.
kube_ctx := env('KUBE_CONTEXT', 'default')
k8s_ca_file := home_directory() / '.config/msb/k3s-ca.crt'
k8s_token := 'kubectl --context ' + kube_ctx + ' -n sandbox-agent create token sandbox-agent --duration 8760h'
volumes := 'claude-home terraform-providers podman-storage herdr qwen-home'
# Bitwarden token encrypted with `age -p`. See README.md prerequisite 4.
token_file := home_directory() / '.config/bws/access-token.age'
# `bws run` injects Bitwarden keys into one command's environment. Uses BWS_ACCESS_TOKEN if set, else decrypts `token_file` with `age -d`. Passphrase is not stored.
bws_run := 'BWS_ACCESS_TOKEN="${BWS_ACCESS_TOKEN:-$(age -d ' + token_file + ')}" bws run --'
registry_host := 'ghcr.io'
registry := registry_host + '/raghav19/engineersdaybook/dev-sbx'
registry_user := 'raghav19'
# External repository URLs (passed to Dockerfile as --build-arg)
mise_installer_url := 'https://mise.run'
ttt_plugins_url := 'https://raw.githubusercontent.com/eugenioenko/ttt-plugins/main'
te_repo := 'https://github.com/microsoft/TokenEconomizer.git'
# `setup` authorizes this SSH public key. To use another key, set SANDBOX_SSH_PUBKEY.
ssh_pubkey := env('SANDBOX_SSH_PUBKEY', home_directory() / '.ssh/id_ed25519.pub')
# ssh, not msb exec. msb exec stops output at 1 MB and freezes screen editors. ssh does not.
ssh_config := source_directory() / 'vm' / 'ssh_config'
# The tag of the image is the commit.
commit := shell('git rev-parse HEAD')
# The timestamp of every file in the published image (a fixed date in 2023). Do not change it. A new value gives every layer a new digest.
image_epoch := '1700000000'

# List the recipes (the default)
[default]
help:
    just --list --unsorted

_host-only:
    [ -z "${SANDBOX_NAME:-}" ] || { echo "Run this on the host. You are in the sbx sandbox $SANDBOX_NAME, and msb and Podman are on the host." >&2; exit 1; }

# Authorize your SSH key for `msb ssh`. Safe to run again.
setup: _host-only
    [ -r '{{ ssh_pubkey }}' ] || { echo "msb: no SSH public key at {{ ssh_pubkey }}. Run: ssh-keygen -t ed25519. Or set SANDBOX_SSH_PUBKEY." >&2; exit 1; }
    msb ssh authorize --file '{{ ssh_pubkey }}'

# GitHub App login. Client secret from Bitwarden. Token goes to ~/.config/msb/github-app.json (mode 600). Copy to GH_TOKEN, then delete. The VM never has it.
github-login: _host-only
    {{ bws_run }} '{{ step }} github-login'

# Build the image and push to ghcr.io. GITHUB_TOKEN (write:packages) comes from Bitwarden via bws run.
# Podman cache: each stage is a separate image in {{ registry }}-cache. --cache-from degrades if unreachable. --cache-to failure stops the build.
# Digest from --digestfile, written to vm/sandbox.yaml by yq. Commit it.
# `build refresh`: rebuild without cache to update prefix-pinned tools (claude, qwen).
build refresh='': _host-only
    {{ bws_run }} 'printf %s "$GITHUB_TOKEN" | podman login {{ registry_host }} -u {{ registry_user }} --password-stdin'
    podman build {{ msb_dir }}/image -t {{ registry }}:{{ commit }} \
      --build-arg MISE_INSTALLER_URL={{ mise_installer_url }} \
      --build-arg TTT_PLUGINS_URL={{ ttt_plugins_url }} \
      --build-arg TE_REPO={{ te_repo }} \
      --timestamp {{ image_epoch }} \
      --compression-format zstd --compression-level 9 --force-compression --rewrite-timestamp \
      --cache-to {{ registry }}-cache --cache-from {{ registry }}-cache \
      {{ if refresh == 'refresh' { '--no-cache' } else if refresh == '' { '' } else { error('msb: build takes no argument, or: refresh') } }}
    podman push {{ registry }}:{{ commit }} --compression-format zstd --digestfile /tmp/msb-digest
    podman logout {{ registry_host }}
    digest=$(cat /tmp/msb-digest) && rm -f /tmp/msb-digest \
      && yq -i ".image.oci = \"{{ registry }}@$digest\"" {{ msb_dir }}/vm/sandbox.yaml \
      && echo "vm/sandbox.yaml pins {{ registry }}@$digest. Commit it. Then run: just msb rm && just msb run"

# `token=$(...) && ...` stops if kubectl fails. Without a token no VM starts, so the VM never gets another credential.
_vm: _k8s-ca
    token=$({{ k8s_token }}) || { echo "msb: no token. Run first: just msb sync-kubeconfig" >&2; exit 1; } && K8S_TOKEN="$token" K8S_CA_FILE={{ k8s_ca_file }} {{ step }} ensure-vm

# Write the public CA of k3s from the kubeconfig of the host. A new k3s cluster has a new CA.
_k8s-ca:
    mkdir -p "$(dirname {{ k8s_ca_file }})"
    kubectl --context {{ kube_ctx }} config view --raw --minify -o 'jsonpath={.clusters[0].cluster.certificate-authority-data}' | base64 -d > {{ k8s_ca_file }}
    [ -s {{ k8s_ca_file }} ] || { echo "msb: the kubectl context {{ kube_ctx }} has no certificate-authority-data" >&2; exit 1; }

# The steps in order: the node identity of the VM agent, the entry of the VM, the SPIRE agent of the host, the VM. Then the check that the VM got its SVID.
# If the VM gets no SVID, the run stops before it opens the editor. `just msb host-register` must have run once for this host.
# The [env] lines give the git values and the Omarchy theme path that vm/sandbox.yaml names as ${NAME}. They apply to this recipe only.
# Every day. Make or start the VM from vm/sandbox.yaml, run sandbox-boot in it, then open Herdr in it.
# Use prefix+t in Herdr to open TTT in a worktree.
[env('SANDBOX_GIT_DIR', shell('git rev-parse --path-format=absolute --git-common-dir'))]
[env('SANDBOX_BRANCH', shell('git branch --show-current'))]
[env('GIT_AUTHOR_NAME', shell('git config user.name || echo agent'))]
[env('GIT_AUTHOR_EMAIL', shell('git config user.email || echo agent@localhost'))]
[env('SANDBOX_OMARCHY_THEME', shell('printf %s "$HOME/.local/state/omarchy/current/theme"'))]
run: _host-only node-cert vm-register agent-up
    {{ bws_run }} 'MSB_IN_BWS=1 GHCR_PUSH_TOKEN="$GITHUB_TOKEN" just --justfile {{ source_file() }} _vm'
    just --justfile {{ source_file() }} identity
    ssh -t -F {{ ssh_config }} $MSB_NAME.msb "cd $MSB_WORKSPACE && COLORTERM=truecolor exec herdr"

# ssh, not msb exec (1 MB output limit freezes editors). COLORTERM gives TTT 24-bit color. VM outlives the session.
edit: _host-only
    ssh -t -F {{ ssh_config }} $MSB_NAME.msb "cd $MSB_WORKSPACE && COLORTERM=truecolor exec ttt ."

# The node identity of the VM: cert-manager makes the key pair and the 90-day certificate (the Certificate `sandbox-node` in the spire addon of part 3, signed by the node CA).
# This recipe waits until the certificate is Ready, then copies the key, the certificate and the SPIFFE trust bundle into ~/.config/msb/node. The VM mounts that folder read-only.
# `run` does this first, so the VM does not start without it. cert-manager renews the certificate 30 days before its end, and a new key comes with it. Run this recipe again to copy them.
# To rotate the key at once (a leak), delete the Secret: kubectl -n spire-system delete secret sandbox-node-tls. cert-manager makes a new one. Run this recipe, then restart the agent.
# kubectl uses the current context, or KUBE_CONTEXT.
[script('bash')]
node-cert: _host-only
    set -euo pipefail
    k() { kubectl ${KUBE_CONTEXT:+--context "$KUBE_CONTEXT"} -n spire-system "$@"; }
    k wait --for=condition=Ready certificate/sandbox-node --timeout=60s || { echo "msb: the Certificate sandbox-node is not Ready. Is the cluster up, with the spire addon applied?" >&2; exit 1; }
    dir=$SANDBOX_NODE_DIR
    mkdir -p "$dir" && chmod 700 "$dir"
    k get secret sandbox-node-tls -o 'jsonpath={.data.tls\.key}' | base64 -d > "$dir/node.key.new"
    k get secret sandbox-node-tls -o 'jsonpath={.data.tls\.crt}' | base64 -d > "$dir/node.crt.new"
    k exec spire-server-0 -c spire-server -- /opt/spire/bin/spire-server bundle show -format spiffe > "$dir/bundle.json.new"
    chmod 600 "$dir/node.key.new" && chmod 644 "$dir/node.crt.new" "$dir/bundle.json.new"
    for file in node.key node.crt bundle.json; do mv "$dir/$file.new" "$dir/$file"; done
    echo "The node identity is in $dir."

# Fail if the name of the host or of the VM does not fit in a Kubernetes name and in a SPIFFE path.
[script('bash')]
_check-names:
    for n in "$MSB_NODE" "$MSB_NAME"; do
      [[ "$n" =~ ^[a-z0-9]([-a-z0-9]{0,38}[a-z0-9])?$ ]] || { echo "msb: '$n' is not a valid name. Use 1 to 40 characters: lower case letters, digits and '-'. Start and end with a letter or a digit." >&2; exit 1; }
    done

# Register this host with the SPIRE server (k3s/host-registration.yaml): the node certificate, the node entry and the delegate entry. Run it once for each host.
# It waits until the certificate is ready. Then it copies the key, the certificate and the trust bundle to ~/.config/msb/host-node, as `node-cert` does for the VM.
# The key of this certificate is the key of the host agent. It is a different key and a different node entry than the agent in the VM, so the two agents do not clash.
# It changes the cluster. kubectl uses the context kube_ctx (KUBE_CONTEXT).
[script('bash')]
host-register: _host-only _check-names
    set -euo pipefail
    export MSB_UID=$(id -u) DELEGATE_PATH={{ delegate_path }}
    k() { kubectl --context {{ kube_ctx }} -n spire-system "$@"; }
    envsubst '$MSB_NODE $MSB_GITHUB_ID $MSB_UID $DELEGATE_PATH' < {{ msb_dir }}/k3s/host-registration.yaml | kubectl --context {{ kube_ctx }} apply -f -
    k wait --for=condition=Ready certificate/host-node-$MSB_NODE --timeout=60s || { echo "msb: the Certificate host-node-$MSB_NODE is not Ready. Is the node CA in the spire addon applied?" >&2; exit 1; }
    dir=$HOST_NODE_DIR
    mkdir -p "$dir" && chmod 700 "$dir"
    k get secret host-node-$MSB_NODE-tls -o 'jsonpath={.data.tls\.key}' | base64 -d > "$dir/node.key.new"
    k get secret host-node-$MSB_NODE-tls -o 'jsonpath={.data.tls\.crt}' | base64 -d > "$dir/node.crt.new"
    k exec spire-server-0 -c spire-server -- /opt/spire/bin/spire-server bundle show -format spiffe > "$dir/bundle.json.new"
    chmod 600 "$dir/node.key.new" && chmod 644 "$dir/node.crt.new" "$dir/bundle.json.new"
    for file in node.key node.crt bundle.json; do mv "$dir/$file.new" "$dir/$file"; done
    echo "The host $MSB_NODE is registered. Its node identity is in $dir."

# Remove the registration of this host: the three objects of host-registration.yaml and the Secret with the key. The files in ~/.config/msb/host-node stay.
[script('bash')]
host-unregister: _host-only _check-names
    set -euo pipefail
    export MSB_UID=$(id -u) DELEGATE_PATH={{ delegate_path }}
    envsubst '$MSB_NODE $MSB_GITHUB_ID $MSB_UID $DELEGATE_PATH' < {{ msb_dir }}/k3s/host-registration.yaml | kubectl --context {{ kube_ctx }} delete --ignore-not-found -f -
    kubectl --context {{ kube_ctx }} -n spire-system delete secret host-node-$MSB_NODE-tls --ignore-not-found

# Register the VM with the SPIRE server (k3s/vm-registration.yaml): one entry with its name. The node entry of this host (`host-register`) is the parent.
# The entry matches the VMM of the VM when the delegate sends its pid. It changes the cluster.
[script('bash')]
vm-register: _host-only _check-names
    set -euo pipefail
    export MSB_UID=$(id -u)
    envsubst '$MSB_NODE $MSB_GITHUB_ID $MSB_NAME $MSB_UID' < {{ msb_dir }}/k3s/vm-registration.yaml | kubectl --context {{ kube_ctx }} apply -f -
    echo "The VM $MSB_NAME is registered as spiffe://mcp.local/node/$MSB_NODE/user/$MSB_GITHUB_ID/vm/$MSB_NAME."

# Remove the entry of the VM.
[script('bash')]
vm-unregister: _host-only _check-names
    set -euo pipefail
    export MSB_UID=$(id -u)
    envsubst '$MSB_NODE $MSB_GITHUB_ID $MSB_NAME $MSB_UID' < {{ msb_dir }}/k3s/vm-registration.yaml | kubectl --context {{ kube_ctx }} delete --ignore-not-found -f -

# Install what the host agent needs: the SPIRE agent (checked with sha256sum), the msbvm plugin and the delegate.
# The SPIRE release goes to ~/.cache. The plugin and the delegate go to ~/.local/share/agent-workload-identity/bin. `go build -trimpath -buildvcs=false` keeps the path of the checkout and the git commit out of the binaries. So the checksum of the plugin changes only when the code changes, and `agent-up` does not restart the agent for nothing. The delegate entry (host-registration.yaml) has the path of the delegate as a selector.
[script('bash')]
agent-install: _host-only
    set -euo pipefail
    command -v go >/dev/null || { echo "msb: go is not installed. The plugin and the delegate need it." >&2; exit 1; }
    release=spire-{{ spire_version }}-linux-amd64-musl
    url=https://github.com/spiffe/spire/releases/download/v{{ spire_version }}
    cache={{ spire_cache }}
    mkdir -p "$cache/download"
    if [ ! -f "$cache/download/$release.tar.gz" ] || [ ! -f "$cache/download/${release}_sha256sum.txt" ]; then
      echo "Download SPIRE {{ spire_version }}."
      curl -fsSL -o "$cache/download/$release.tar.gz" "$url/$release.tar.gz"
      curl -fsSL -o "$cache/download/${release}_sha256sum.txt" "$url/${release}_sha256sum.txt"
    fi
    (cd "$cache/download" && sha256sum -c --quiet "${release}_sha256sum.txt") || { echo "msb: the checksum of the SPIRE archive is wrong. Remove $cache and run again." >&2; exit 1; }
    if [ ! -x "$cache/release/bin/spire-agent" ]; then
      rm -rf "$cache/release" && mkdir "$cache/release"
      tar -xzf "$cache/download/$release.tar.gz" -C "$cache/release" --strip-components=1
    fi
    mkdir -p {{ awi_bin }}
    (cd {{ awi_dir }}/plugin && go build -trimpath -buildvcs=false -o {{ awi_bin }}/msbvm .)
    (cd {{ awi_dir }}/delegate && go build -trimpath -buildvcs=false -o {{ awi_bin }}/delegate .)
    echo "Installed in {{ awi_bin }}: msbvm, delegate. The SPIRE agent is in $cache/release/bin."

# Start the SPIRE agent of the host as the user unit awi-spire-agent. It needs the node identity that `host-register` wrote.
# The recipe fills in agent.conf.tmpl, starts the agent, and waits until the admin socket and the health check answer.
# The agent attests to the cluster with the key of the host. The log is `journalctl --user -u awi-spire-agent`.
[script('bash')]
agent-up: _host-only _check-names agent-install
    set -euo pipefail
    [ -s "$HOST_NODE_DIR/node.key" ] || { echo "msb: no node identity of this host. Run first: just msb host-register" >&2; exit 1; }
    export AGENT_STATE={{ agent_state }} AGENT_RUN={{ agent_run }} AGENT_ADMIN={{ agent_admin }} NODE_DIR=$HOST_NODE_DIR MSB_DB={{ msb_db }}
    export DELEGATE_ID="spiffe://mcp.local/node/$MSB_NODE/user/$MSB_GITHUB_ID/delegate"
    export PLUGIN_PATH={{ awi_bin }}/msbvm
    export PLUGIN_SHA=$(sha256sum "$PLUGIN_PATH" | cut -d' ' -f1)
    mkdir -p -m 700 "$AGENT_STATE" "$AGENT_RUN" "$AGENT_ADMIN"
    (umask 077 && envsubst '$AGENT_STATE $AGENT_RUN $AGENT_ADMIN $NODE_DIR $DELEGATE_ID $PLUGIN_PATH $PLUGIN_SHA $MSB_DB' < {{ awi_dir }}/agent/agent.conf.tmpl > "$AGENT_STATE/agent.conf.new")
    # `run` calls this recipe each time. If the agent runs, is healthy and has the same config, leave it alone: a restart makes it attest again.
    if systemctl --user is-active --quiet awi-spire-agent && cmp -s "$AGENT_STATE/agent.conf.new" "$AGENT_STATE/agent.conf" \
       && {{ spire_cache }}/release/bin/spire-agent healthcheck -socketPath "$AGENT_RUN/agent.sock" >/dev/null 2>&1; then
      rm -f "$AGENT_STATE/agent.conf.new"
      echo "The agent of the host $MSB_NODE runs already. Admin socket: $AGENT_ADMIN/admin.sock"
      exit 0
    fi
    mv "$AGENT_STATE/agent.conf.new" "$AGENT_STATE/agent.conf"
    systemctl --user stop awi-spire-agent 2>/dev/null || true
    rm -f "$AGENT_RUN/agent.sock" "$AGENT_ADMIN/admin.sock"
    systemd-run --user --quiet --unit=awi-spire-agent --collect --description="SPIRE agent of the host $MSB_NODE" \
      {{ spire_cache }}/release/bin/spire-agent run -config "$AGENT_STATE/agent.conf"
    for _ in $(seq 1 60); do
      [ -S "$AGENT_ADMIN/admin.sock" ] && {{ spire_cache }}/release/bin/spire-agent healthcheck -socketPath "$AGENT_RUN/agent.sock" >/dev/null 2>&1 && break
      sleep 0.5
    done
    {{ spire_cache }}/release/bin/spire-agent healthcheck -socketPath "$AGENT_RUN/agent.sock" || { echo "msb: the agent is not healthy. See: journalctl --user -u awi-spire-agent" >&2; exit 1; }
    echo "The agent of the host $MSB_NODE runs. Admin socket: $AGENT_ADMIN/admin.sock"

# Ask the SPIRE agent of the host for the SVID of the VM, and check that its ID is the one of this VM. Print the ID and the end of the SVID.
# The delegate answers with an error until the VM runs and until the agent has the entry of the VM. The entry needs about 8 seconds to reach the agent.
# So the recipe asks again, once each second, for MSB_IDENTITY_WAIT seconds (40 if you do not set it). If no SVID comes, it prints the last answer and fails.
[script('bash')]
identity: _host-only _check-names
    set -euo pipefail
    id="spiffe://mcp.local/node/$MSB_NODE/user/$MSB_GITHUB_ID/vm/$MSB_NAME"
    wait=${MSB_IDENTITY_WAIT:-40}
    end=$((SECONDS + wait))
    last=""
    while :; do
      if out=$({{ delegate_path }} -vm "$MSB_NAME" -id "$id" -socket {{ agent_admin }}/admin.sock 2>&1); then
        echo "VM identity: $(sed -n 's/^spiffe_id=//p' <<<"$out") (expires $(sed -n 's/^not_after=//p' <<<"$out"))"
        exit 0
      fi
      last=$out
      [ "$SECONDS" -ge "$end" ] && break
      sleep 1
    done
    echo "msb: the VM $MSB_NAME got no SVID in $wait seconds. The last answer: $last" >&2
    echo "msb: look at: just msb agent-status, journalctl --user -u awi-spire-agent, and kubectl get clusterstaticentry vm-$MSB_NODE-$MSB_NAME" >&2
    exit 1

# Stop the SPIRE agent of the host.
agent-down: _host-only
    systemctl --user stop awi-spire-agent 2>/dev/null || true

# Show whether the SPIRE agent of the host runs and is healthy.
[script('bash')]
agent-status: _host-only
    systemctl --user is-active awi-spire-agent || true
    {{ spire_cache }}/release/bin/spire-agent healthcheck -socketPath {{ agent_run }}/agent.sock || true

# Add a host to network.allow in vm/sandbox.yaml, then run. If a VM exists, `run` tells you to remove it first
allow-host $host: _host-only && run
    {{ step }} allow-host "$host"

# A bash prompt in the VM, in the engineersdaybook workspace directory.
shell: _host-only
    ssh -t -F {{ ssh_config }} $MSB_NAME.msb "cd /home/agent/engineersdaybook && exec bash -l"

# Make the ServiceAccount of the sandbox agent and its read-only rights in k3s. Run it before the first `run`.
# If the VM runs, it also gives the VM a new token. Use it after a new k3s cluster (then `rm` and `run`) or when the token ends.
# To revoke the token at once, delete the ServiceAccount (kubectl -n sandbox-agent delete serviceaccount sandbox-agent), then run this recipe.
[script]
sync-kubeconfig: _host-only _k8s-ca
    kubectl --context {{ kube_ctx }} apply -f {{ msb_dir }}/k3s/sandbox-agent-rbac.yaml
    status=$(msb inspect $MSB_NAME --format json 2>/dev/null | jq -r '.status | ascii_downcase' || true)
    [ "$status" = running ] || { echo "No VM runs. 'just msb run' gives the VM its token."; exit 0; }
    token=$({{ k8s_token }})
    K8S_TOKEN="$token" msb modify $MSB_NAME --secret K8S_TOKEN@host.microsandbox.internal

# Remove the VM. `--volumes` also removes all the volumes: the Claude login and settings, the Terraform provider cache, the podman images, the Herdr layout and the Qwen sessions
rm *args: _host-only
    msb rm -f $MSB_NAME || true
    just --justfile {{ source_file() }} vm-unregister || echo "msb: could not remove the SPIRE entry of the VM. Run later: just msb vm-unregister" >&2
    if [ "{{ args }}" = "--volumes" ]; then msb volume rm {{ volumes }} || true; fi
