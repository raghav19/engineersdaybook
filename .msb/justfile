# The msb sandbox: a microsandbox VM for Claude Code and the TTT editor. ../justfile loads this file as `mod msb`. Use `just msb <recipe>`.
# Every recipe runs on the host. vm/sandbox.yaml declares the VM. The recipe `run` makes the VM from it.
# If vm/sandbox.yaml changes, `run` tells you to remove the VM first.
# The recipes list the steps in order. msb.py has the steps that need Python.
#
#   just msb setup          once for each host: authorize your SSH key.
#   just msb run            every day: make or start the VM, prepare it, then open the TTT editor in it.
#   just msb edit           open the TTT editor in the running VM, in this terminal. Quit with Ctrl+Q.
#   just msb allow-host     allow one more host for the VM.
#   just msb sync-kubeconfig  make the read-only ServiceAccount of the agent in k3s (before the first run), and give the running VM a token of it.
#   just msb github-login   log in to GitHub (once, and when it asks for it).
#   just msb build          build the image after you change a file of image/, push it to ghcr.io, and pin its digest in vm/sandbox.yaml.

set quiet
set shell := ['bash', '-euo', 'pipefail', '-c']
set script-interpreter := ['bash', '-euo', 'pipefail']

# msb.py reads these two values.
export MSB_NAME := 'sandbox-dev'
# The path of the clone in the VM. SANDBOX_WORKSPACE in vm/sandbox.yaml has the same value.
export MSB_WORKSPACE := '/home/agent/engineersdaybook'

# --- Required tools ---
msb    := require("msb")
bws    := require("bws")
age    := require("age")
uv      := require("uv")
podman  := require("podman")
jq      := require("jq")
yq      := require("yq")
ssh     := require("ssh")
kubectl := require("kubectl")

# --- Required environment variables ---
in_bws                  := env('MSB_IN_BWS', '')
GH_TOKEN                := if in_bws == '' { '' } else { env('GH_TOKEN') }
CLAUDE_CODE_OAUTH_TOKEN := if in_bws == '' { '' } else { env('CLAUDE_CODE_OAUTH_TOKEN') }
GITHUB_TOKEN            := if in_bws == '' { '' } else { env('GITHUB_TOKEN') }
QWEN_API_KEY            := if in_bws == '' { '' } else { env('QWEN_API_KEY') }

msb_dir := source_directory()
step := msb_dir / 'msb.py'
# The agent in the VM reaches the k3s API server with the token of the ServiceAccount sandbox-agent (k3s/sandbox-agent-rbac.yaml).
# The token stays on the host and in msb. The VM holds the placeholder $MSB_K8S_TOKEN. The token lasts one year and is not rotated.
# kube_ctx is the kubectl context of the host. k3s names it `default`. msb.py reads K8S_CA_FILE, the public CA of k3s that msb trusts for the API server.
kube_ctx := env('KUBE_CONTEXT', 'default')
export K8S_CA_FILE := home_directory() / '.config/msb/k3s-ca.crt'
k8s_token := 'kubectl --context ' + kube_ctx + ' -n sandbox-agent create token sandbox-agent --duration 8760h'
volumes := 'claude-home terraform-providers podman-storage herdr qwen-home'
# Bitwarden token encrypted with `age -p`. See README.md prerequisite 4.
token_file := home_directory() / '.config/bws/access-token.age'
# `bws run` injects Bitwarden keys into one command's environment. Uses BWS_ACCESS_TOKEN if set, else decrypts `token_file` with `age -d`. Passphrase is not stored.
bws_run := 'BWS_ACCESS_TOKEN="${BWS_ACCESS_TOKEN:-$(age -d ' + token_file + ')}" bws run --'
registry_host := 'ghcr.io'
registry := registry_host + '/raghav19/engineersdaybook/dev-sbx'
registry_user := 'raghav19'
# External repository URLs (passed to Dockerfile as --build-arg)
mise_installer_url := 'https://mise.run'
ttt_plugins_url := 'https://raw.githubusercontent.com/eugenioenko/ttt-plugins/main'
te_repo := 'https://github.com/microsoft/TokenEconomizer.git'
# `setup` authorizes this SSH public key. To use another key, set SANDBOX_SSH_PUBKEY.
ssh_pubkey := env('SANDBOX_SSH_PUBKEY', home_directory() / '.ssh/id_ed25519.pub')
# ssh, not msb exec. msb exec stops output at 1 MB and freezes screen editors. ssh does not.
ssh_config := source_directory() / 'vm' / 'ssh_config'
# The tag of the image is the commit.
commit := shell('git rev-parse HEAD')
# The timestamp of every file in the published image (a fixed date in 2023). Do not change it. A new value gives every layer a new digest.
image_epoch := '1700000000'

# List the recipes (the default)
[default]
help:
    just --list --unsorted

_host-only:
    [ -z "${SANDBOX_NAME:-}" ] || { echo "Run this on the host. You are in the sbx sandbox $SANDBOX_NAME, and msb and Podman are on the host." >&2; exit 1; }

# Authorize your SSH key for `msb ssh`. Safe to run again.
setup: _host-only
    [ -r '{{ ssh_pubkey }}' ] || { echo "msb: no SSH public key at {{ ssh_pubkey }}. Run: ssh-keygen -t ed25519. Or set SANDBOX_SSH_PUBKEY." >&2; exit 1; }
    msb ssh authorize --file '{{ ssh_pubkey }}'

# GitHub App login. Client secret from Bitwarden. Token goes to ~/.config/msb/github-app.json (mode 600). Copy to GH_TOKEN, then delete. The VM never has it.
github-login: _host-only
    {{ bws_run }} '{{ step }} github-login'

# Build the image and push to ghcr.io. GITHUB_TOKEN (write:packages) comes from Bitwarden via bws run.
# Podman cache: each stage is a separate image in {{ registry }}-cache. --cache-from degrades if unreachable. --cache-to failure stops the build.
# Digest from --digestfile, written to vm/sandbox.yaml by yq. Commit it.
# `build refresh`: rebuild without cache to update prefix-pinned tools (claude, qwen).
build refresh='': _host-only
    {{ bws_run }} 'printf %s "$GITHUB_TOKEN" | podman login {{ registry_host }} -u {{ registry_user }} --password-stdin'
    podman build {{ msb_dir }}/image -t {{ registry }}:{{ commit }} \
      --build-arg MISE_INSTALLER_URL={{ mise_installer_url }} \
      --build-arg TTT_PLUGINS_URL={{ ttt_plugins_url }} \
      --build-arg TE_REPO={{ te_repo }} \
      --timestamp {{ image_epoch }} \
      --compression-format zstd --compression-level 9 --force-compression --rewrite-timestamp \
      --cache-to {{ registry }}-cache --cache-from {{ registry }}-cache \
      {{ if refresh == 'refresh' { '--no-cache' } else if refresh == '' { '' } else { error('msb: build takes no argument, or: refresh') } }}
    podman push {{ registry }}:{{ commit }} --compression-format zstd --digestfile /tmp/msb-digest
    podman logout {{ registry_host }}
    digest=$(cat /tmp/msb-digest) && rm -f /tmp/msb-digest \
      && yq -i ".image.oci = \"{{ registry }}@$digest\"" {{ msb_dir }}/vm/sandbox.yaml \
      && echo "vm/sandbox.yaml pins {{ registry }}@$digest. Commit it. Then run: just msb rm && just msb run"

# `token=$(...) && ...` stops if kubectl fails. Without a token no VM starts, so the VM never gets another credential.
_vm: _k8s-ca
    token=$({{ k8s_token }}) || { echo "msb: no token. Run first: just msb sync-kubeconfig" >&2; exit 1; } && K8S_TOKEN="$token" {{ step }} ensure-vm

# Write the public CA of k3s from the kubeconfig of the host. A new k3s cluster has a new CA.
_k8s-ca:
    mkdir -p "$(dirname {{ K8S_CA_FILE }})"
    kubectl --context {{ kube_ctx }} config view --raw --minify -o 'jsonpath={.clusters[0].cluster.certificate-authority-data}' | base64 -d > {{ K8S_CA_FILE }}
    [ -s {{ K8S_CA_FILE }} ] || { echo "msb: the kubectl context {{ kube_ctx }} has no certificate-authority-data" >&2; exit 1; }

# The [env] lines give the git values and the Omarchy theme path that vm/sandbox.yaml names as ${NAME}. They apply to this recipe only.
# Every day. Make or start the VM from vm/sandbox.yaml, run sandbox-boot in it, then open Herdr in it.
# Use prefix+t in Herdr to open TTT in a worktree.
[env('SANDBOX_GIT_DIR', shell('git rev-parse --path-format=absolute --git-common-dir'))]
[env('SANDBOX_BRANCH', shell('git branch --show-current'))]
[env('GIT_AUTHOR_NAME', shell('git config user.name || echo agent'))]
[env('GIT_AUTHOR_EMAIL', shell('git config user.email || echo agent@localhost'))]
[env('SANDBOX_OMARCHY_THEME', shell('printf %s "$HOME/.local/state/omarchy/current/theme"'))]
run: _host-only
    {{ bws_run }} 'MSB_IN_BWS=1 GHCR_PUSH_TOKEN="$GITHUB_TOKEN" just --justfile {{ source_file() }} _vm'
    ssh -t -F {{ ssh_config }} $MSB_NAME.msb "cd $MSB_WORKSPACE && COLORTERM=truecolor exec herdr"

# ssh, not msb exec (1 MB output limit freezes editors). COLORTERM gives TTT 24-bit color. VM outlives the session.
edit: _host-only
    ssh -t -F {{ ssh_config }} $MSB_NAME.msb "cd $MSB_WORKSPACE && COLORTERM=truecolor exec ttt ."

# Add a host to network.allow in vm/sandbox.yaml, then run. If a VM exists, `run` tells you to remove it first
allow-host $host: _host-only && run
    {{ step }} allow-host "$host"

# A bash prompt in the VM, in the engineersdaybook workspace directory.
shell: _host-only
    ssh -t -F {{ ssh_config }} $MSB_NAME.msb "cd /home/agent/engineersdaybook && exec bash -l"

# Make the ServiceAccount of the sandbox agent and its read-only rights in k3s. Run it before the first `run`.
# If the VM runs, it also gives the VM a new token. Use it after a new k3s cluster (then `rm` and `run`) or when the token ends.
# To revoke the token at once, delete the ServiceAccount (kubectl -n sandbox-agent delete serviceaccount sandbox-agent), then run this recipe.
[script]
sync-kubeconfig: _host-only _k8s-ca
    kubectl --context {{ kube_ctx }} apply -f {{ msb_dir }}/k3s/sandbox-agent-rbac.yaml
    status=$(msb inspect $MSB_NAME --format json 2>/dev/null | jq -r '.status | ascii_downcase' || true)
    [ "$status" = running ] || { echo "No VM runs. 'just msb run' gives the VM its token."; exit 0; }
    token=$({{ k8s_token }})
    K8S_TOKEN="$token" msb modify $MSB_NAME --secret K8S_TOKEN@host.microsandbox.internal

# Remove the VM. `--volumes` also removes all the volumes: the Claude login and settings, the Terraform provider cache, the podman images, the Herdr layout and the Qwen sessions
rm *args: _host-only
    msb rm -f $MSB_NAME || true
    if [ "{{ args }}" = "--volumes" ]; then msb volume rm {{ volumes }} || true; fi
