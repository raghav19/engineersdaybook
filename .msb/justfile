# The msb sandbox: a microsandbox VM for Claude Code and VS Code. ../justfile loads this file as `mod msb`. Use `just msb <recipe>`.
# Every recipe runs on the host. sandbox.yaml declares the VM. The recipe `run` makes the VM from it.
# If sandbox.yaml changes, `run` tells you to remove the VM first.
# The recipes list the steps in order. msb.py has the logic of the steps that need logic.
#
#   just msb setup        once for each host: authorize your SSH key and connect VS Code
#   just msb run          every day: make the VM if none exists, then open VS Code on it
#   just msb allow-host   allow one more host for the VM
#   just msb github-login log in to GitHub (once, and when it asks for it)
#   just msb image-build  build the image after you change a file of dev-tools/
#   just msb image-publish  push the image to ghcr.io (the token comes from Bitwarden)

set quiet
set lazy
set shell := ['bash', '-euo', 'pipefail', '-c']
set script-interpreter := ['bash', '-euo', 'pipefail']

# msb.py reads these three values.
export MSB_NAME := 'sandbox-dev'
export MSB_IMAGE := 'engineersdaybook-sandbox:local'
# The path of the clone in the VM. SANDBOX_WORKSPACE in sandbox.yaml has the same value.
export MSB_WORKSPACE := '/home/agent/engineersdaybook'

msb_dir := source_directory()
step := msb_dir / 'msb.py'
volumes := 'claude-home terraform-providers podman-storage'
registry_host := 'ghcr.io'
registry := registry_host + '/raghav19/engineersdaybook/dev-sbx'
registry_user := 'raghav19'
# The user in the VM that `shell` opens (the Dockerfile makes it).
vm_user := 'agent'
# `setup` authorizes this SSH public key. To use another key, set SANDBOX_SSH_PUBKEY.
ssh_pubkey := env('SANDBOX_SSH_PUBKEY', home_directory() / '.ssh/id_ed25519.pub')
# The VS Code extension for Remote-SSH, and the user settings file that `setup` writes.
remote_ssh_extension := 'ms-vscode-remote.remote-ssh'
vscode_settings_file := config_directory() / 'Code/User/settings.json'
# The tag of the image is the commit. `set lazy` runs git only for the recipe that uses the variable.
commit := shell('git rev-parse HEAD')
# The VS Code settings that Remote-SSH needs. `setup` merges them into your user settings: your other settings stay. New VS Code windows use them.
vscode_settings := '''{
  "remote.SSH.configFile": "''' + msb_dir + '''/ssh_config",
  "remote.SSH.defaultExtensions": [
    "astral-sh.ty",
    "charliermarsh.ruff",
    "tamasfe.even-better-toml",
    "kennylong.kubernetes-yaml-formatter",
    "yzhang.markdown-all-in-one",
    "skellock.just",
    "isontheline.vscode-sysmon"
  ],
  "remote.SSH.useExecServer": false,
  "remote.SSH.enableDynamicForwarding": false,
  "remote.SSH.enableAgentForwarding": false,
  "remote.SSH.connectTimeout": 30,
  "remote.SSH.showLoginTerminal": false,
  "remote.SSH.localServerDownload": "always",
  "update.mode": "none",
  "extensions.autoUpdate": "off",
  "extensions.autoCheckUpdates": false
}'''
# The timestamp of every file of the published image (a fixed date in 2023). Do not change it: a new value gives every layer a new digest.
image_epoch := '1700000000'
# zstd level 9 as the sbx kits. With image_epoch, the same files give the same digest.
image_output := 'type=registry,compression=zstd,compression-level=9,force-compression=true,rewrite-timestamp=true'

# List the recipes (the default)
[default]
help:
    just --list --unsorted

_host-only:
    [ -z "${SANDBOX_NAME:-}" ] || { echo "Run this on the host. You are in the sbx sandbox $SANDBOX_NAME, and msb and Docker are on the host." >&2; exit 1; }

# Once for each host (safe to run again): authorize your SSH key for `msb ssh`, install Remote-SSH, set VS Code to use .msb/ssh_config
[script]
setup: _host-only
    [ -r '{{ ssh_pubkey }}' ] || { echo "msb: there is no SSH public key at {{ ssh_pubkey }}. Make one with: ssh-keygen -t ed25519. Or set SANDBOX_SSH_PUBKEY." >&2; exit 1; }
    msb ssh authorize --file '{{ ssh_pubkey }}'
    code --install-extension {{ remote_ssh_extension }}
    mkdir -p "$(dirname '{{ vscode_settings_file }}')"
    [ -f '{{ vscode_settings_file }}' ] || echo '{}' > '{{ vscode_settings_file }}'
    jq --argjson new '{{ vscode_settings }}' '. * $new' '{{ vscode_settings_file }}' > '{{ vscode_settings_file }}.new'
    mv '{{ vscode_settings_file }}.new' '{{ vscode_settings_file }}'
    echo "The VS Code settings are in {{ vscode_settings_file }}. New VS Code windows use them."
    echo "Setup is complete. Next, run: just msb image-build. Then run: just msb run"

# Log in to GitHub with the GitHub App: you approve it in the browser. The client secret comes from Bitwarden. The tokens go to ~/.config/msb/github-app.json (mode 600). The VM never has them
github-login: _host-only
    bws run -- '{{ step }} github-login'

# Build the image from dev-tools/ and load it into msb. Needs Docker. The first build takes several minutes
image-build: _host-only
    docker build -t $MSB_IMAGE {{ msb_dir }}/dev-tools
    docker save $MSB_IMAGE | msb load --tag $MSB_IMAGE
    echo "The image $MSB_IMAGE is in msb now. A VM that exists keeps the old image. To use the new image, run: just msb rm && just msb run"

# The token is the Bitwarden key GITHUB_TOKEN (scope write:packages). `bws run` pipes it to `docker login`, and it is in no variable.
# `bws run` needs BWS_ACCESS_TOKEN, and it stops the recipe with its own message if it is missing.
# The layers of every stage go to the tag `cache`, so a machine rebuilds only the stage that changed. docker reuses what has not changed.
# Maintainer. Push the image to ghcr.io, tagged with the commit
image-publish: _host-only
    bws run -- 'printf %s "$GITHUB_TOKEN" | docker login {{ registry_host }} -u {{ registry_user }} --password-stdin'
    docker buildx build {{ msb_dir }}/dev-tools -t {{ registry }}:{{ commit }} \
      --provenance=false --sbom=false --build-arg SOURCE_DATE_EPOCH={{ image_epoch }} \
      --cache-from type=registry,ref={{ registry }}:cache --cache-to type=registry,ref={{ registry }}:cache,mode=max \
      --output {{ image_output }}
    docker logout {{ registry_host }}

# The four [env] lines are the git values that sandbox.yaml names as ${NAME}. They are the git directory to clone, the branch to start on, and the author of the commits in the VM.
# They run for this recipe only.
# Every day. Make the VM from sandbox.yaml if none exists, then open VS Code on it
[env('SANDBOX_GIT_DIR', shell('git rev-parse --path-format=absolute --git-common-dir'))]
[env('SANDBOX_BRANCH', shell('git branch --show-current'))]
[env('GIT_AUTHOR_NAME', shell('git config user.name || echo agent'))]
[env('GIT_AUTHOR_EMAIL', shell('git config user.email || echo agent@localhost'))]
run: _host-only
    command -v msb >/dev/null || { echo "msb: msb is not on the PATH. Run: mise install && eval \"\$(mise activate bash)\"" >&2; exit 1; }
    # Only this step runs under `bws run`: the Bitwarden keys are variables in its environment. `code` and the other steps do not get them
    bws run -- '{{ step }} ensure-vm'
    {{ step }} wait-boot
    code --folder-uri "vscode-remote://ssh-remote+$MSB_NAME.msb$MSB_WORKSPACE"

# Allow one more host for the VM: add it to network.allow in sandbox.yaml, then run. If a VM exists, `run` tells you to remove it first
allow-host host: _host-only && run
    [[ '{{ host }}' =~ ^(\*\.)?[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?$ ]] || { echo "msb: {{ host }} is not a host name." >&2; exit 1; }
    HOST='{{ host }}' yq -i '.network.allow += [strenv(HOST)] | .network.allow |= unique' {{ msb_dir }}/sandbox.yaml
    echo "{{ host }} is now in network.allow."

# A bash prompt in the VM, as the agent user
shell: _host-only
    msb exec -t -u {{ vm_user }} $MSB_NAME -- bash -l

# Remove the VM. `--volumes` also removes the Claude login and settings, and the Terraform provider cache and the podman images
rm *args: _host-only
    msb rm -f $MSB_NAME || true
    if [ "{{ args }}" = "--volumes" ]; then msb volume rm {{ volumes }} || true; fi
