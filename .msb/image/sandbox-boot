#!/bin/bash
# The command of the msb sandbox (cmd in sandbox.yaml). It runs as root at every start, prepares the workspace, then waits.
# Every step may fail without stopping the boot: a failed step prints its reason to the log (msb logs <name>).
# Env from sandbox.yaml: SANDBOX_WORKSPACE (repo path, same as on the host), SANDBOX_BRANCH, REPO_URL.
# The git identity (GIT_AUTHOR_*, GIT_COMMITTER_*) and the GitHub token helper are not set here: sandbox.yaml sets the first, the image the second.
set -u

ws=${SANDBOX_WORKSPACE:?SANDBOX_WORKSPACE is not set}
home=/home/agent
log() { echo "sandbox-boot: $*"; }
as_agent() { runuser -u agent -- env HOME="$home" "$@"; }

mkdir -p "$(dirname "$ws")" "$home/.claude"
chown agent:agent "$(dirname "$ws")" "$home/.claude" "$home/.cache" 2>/dev/null

# The private clone. The .git directory of the host repo is mounted read-only at /run/sandbox/source and is never written. Push goes to GitHub, to a feature branch.
if [ ! -d "$ws/.git" ]; then
  # /run/sandbox/source is the .git directory of the host repo (read-only). --branch starts the clone on the host branch.
  as_agent git clone --no-hardlinks ${SANDBOX_BRANCH:+--branch "$SANDBOX_BRANCH"} /run/sandbox/source "$ws" || log "clone failed"
  [ -n "${REPO_URL:-}" ] && as_agent git -C "$ws" remote set-url origin "$REPO_URL"
fi
[ -d "$ws/.git" ] && as_agent sh -c "cd '$ws' && prek install --allow-missing-config" || log "prek hook not installed"

# Headroom proxy for Claude Code (127.0.0.1:8787, ANTHROPIC_BASE_URL in .claude/settings.json), as in the sbx kit.
as_agent sh -c 'setsid nohup headroom proxy --port 8787 >/dev/null 2>&1 &'

log "ready"
exec sleep infinity
