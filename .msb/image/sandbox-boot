#!/bin/bash
# Prepare the workspace of the msb sandbox. It runs as root.
# `just msb run` runs it at each run, in a new VM and in an old VM. It does not wait. The VM has no command of its own.
# Each step does nothing if its work exists. So you can run the script as often as you want.
# If a step fails, the script prints the reason and exits with 1.
# Values from sandbox.yaml: SANDBOX_WORKSPACE (the path of the clone), SANDBOX_BRANCH and REPO_URL.
# The script does not set the git identity (sandbox.yaml does) or the GitHub token helper (the image does).
set -eu

ws=${SANDBOX_WORKSPACE:?SANDBOX_WORKSPACE is not set}
home=/home/agent
headroom_log=/tmp/headroom.log
fail() { echo "sandbox-boot: $*" >&2; exit 1; }
as_agent() { runuser -u agent -- env HOME="$home" "$@"; }

# msb sets NODE_EXTRA_CA_CERTS in `msb exec` to a file that does not exist. Node then prints a warning for each call.
[ -e "${NODE_EXTRA_CA_CERTS:-}" ] || unset NODE_EXTRA_CA_CERTS

mkdir -p "$(dirname "$ws")" "$home/.claude" "$home/.qwen" "$home/.herdr" "$home/.cache/terraform-providers" "$home/.local/share/containers"
chown agent:agent "$(dirname "$ws")" "$home/.claude" "$home/.qwen" "$home/.herdr" "$home/.cache" "$home/.cache/terraform-providers" "$home/.local" "$home/.local/share" "$home/.local/share/containers" || fail "chown of the workspace folders failed"

# Podman runs as agent, without root. The kernel of the VM makes /dev/fuse and /dev/net/tun for root only.
# fuse-overlayfs needs /dev/fuse. The network of a container (pasta) needs /dev/net/tun. The group agent can use both.
# The mount `/` must be shared, or podman prints a warning.
chgrp agent /dev/fuse /dev/net/tun && chmod 660 /dev/fuse /dev/net/tun || fail "could not open /dev/fuse and /dev/net/tun for podman"
mount --make-rshared / || fail "could not make / a shared mount for podman"

# The clone is private. The VM cannot write to /run/sandbox/source, the .git directory of the host repo.
# The clone starts on the branch of the host checkout. A push goes to GitHub, to a feature branch.
if [ ! -d "$ws/.git" ]; then
  as_agent git clone --no-hardlinks ${SANDBOX_BRANCH:+--branch "$SANDBOX_BRANCH"} /run/sandbox/source "$ws" || fail "git clone failed (branch: ${SANDBOX_BRANCH:-the default})"
  as_agent git -C "$ws" remote set-url origin "$REPO_URL" || fail "could not set origin to $REPO_URL"
fi
as_agent sh -c "cd '$ws' && prek install --allow-missing-config" || fail "prek install failed"

# The kubeconfig of the sandbox agent. It has no credential. The token is the placeholder $MSB_K8S_TOKEN (K8S_TOKEN in vm/sandbox.yaml).
# The host replaces it with a token of the ServiceAccount sandbox-agent in each request to host.microsandbox.internal.
# The file has no certificate-authority-data on purpose: the host proxy ends the TLS on port 6443, so kubectl must trust the CA of the proxy (the system CA store).
# The heredoc is quoted, so the shell does not expand the placeholder. The file replaces any older kubeconfig, such as one that has an admin credential.
mkdir -p "$home/.kube"
cat > "$home/.kube/config" <<'KUBECONFIG'
apiVersion: v1
kind: Config
clusters:
  - name: k3s
    cluster:
      server: https://host.microsandbox.internal:6443
users:
  - name: sandbox-agent
    user:
      token: $MSB_K8S_TOKEN
contexts:
  - name: default
    context: {cluster: k3s, user: sandbox-agent}
current-context: default
KUBECONFIG
chown agent:agent "$home/.kube" "$home/.kube/config"
chmod 600 "$home/.kube/config"

# The SPIRE agent dials spire.localhost, the name of the route of the SPIRE server on the gateway of the host.
# The VM does not resolve a name under .localhost to the host, so this step maps the name to the IPv4 address of the host. It runs at each boot, because the address can change.
# It writes /etc/hosts with cat and not with mv, because a mount can be the file.
host_ip=$(getent ahostsv4 host.microsandbox.internal | awk '{print $1; exit}')
[ -n "$host_ip" ] || fail "could not find the address of host.microsandbox.internal"
{ grep -v '[[:space:]]spire\.localhost$' /etc/hosts || true; echo "$host_ip spire.localhost"; } > /tmp/hosts.new && cat /tmp/hosts.new > /etc/hosts && rm /tmp/hosts.new || fail "could not map spire.localhost in /etc/hosts"

# The SPIRE agent attests the VM to the SPIRE server with the node key and certificate that `just msb node-cert` copies from the cluster, and the VM mounts read-only at /run/sandbox/node.
# It runs as root, because the key is a mode 600 file of the host, and the user agent must not read it. Its config, data folder, socket folder and log are owned by root for the same reason.
# A running agent stays as it is: it attests again by itself each time its own SVID rotates. A new agent starts with an empty data folder, so it attests at each start.
# If the agent is not healthy in 30 seconds, this script stops, and so does `just msb run`. The VM keeps running: `just msb shell` opens it.
command -v spire-agent >/dev/null || fail "spire-agent is not in the PATH of the VM"
mkdir -p /run/spire /var/lib/spire-agent
agent_healthy() { spire-agent healthcheck -socketPath /run/spire/agent.sock >/dev/null 2>&1; }
if ! agent_healthy; then
  pkill -x spire-agent || true
  rm -rf /var/lib/spire-agent/*
  setsid nohup spire-agent run -config /etc/spire/agent.conf -logFile /var/log/spire-agent.log >/dev/null 2>&1 </dev/null &
  for _ in $(seq 30); do
    agent_healthy && break
    sleep 1
  done
  agent_healthy || { tail -n 20 /var/log/spire-agent.log >&2; fail "the SPIRE agent did not attest in 30 seconds (its log is above)"; }
fi

# The editor (TTT) has no workspace trust gate, so nothing here pre-answers one. It starts a language server as soon as
# a file matches an entry of lsp.servers, with no prompt. See decision 15 in README.md for what that costs.

# The Headroom proxy for Claude Code listens on port 8787. ANTHROPIC_BASE_URL in .claude/settings.json points to 127.0.0.1:8787.
# It binds 0.0.0.0, because the port that sandbox.yaml publishes to the host arrives on the network interface of the VM, not on loopback.
# Start it only if it does not answer. Then wait until it answers.
curl -sf -o /dev/null http://127.0.0.1:8787/health || as_agent sh -c "setsid nohup headroom proxy --host 0.0.0.0 --port 8787 >$headroom_log 2>&1 &"
for _ in $(seq 60); do
  curl -sf -o /dev/null http://127.0.0.1:8787/health && break
  sleep 1
done
curl -sf -o /dev/null http://127.0.0.1:8787/health || { tail -n 20 "$headroom_log" >&2; fail "Headroom did not answer on 127.0.0.1:8787 in 60 seconds"; }

# Ponytail is a plugin for Claude Code. Its version is a release tag. The plugin goes to the claude-home volume, so a new VM finds it.
# A failure prints a warning and does not stop the script, as in sbx.
as_agent sh -c "claude plugin marketplace add DietrichGebert/ponytail#v5.3.2; claude plugin install ponytail@ponytail" \
  || echo "sandbox-boot: warning: the ponytail plugin is not installed" >&2

# TokenEconomizer: Claude Code plugin. Clone at /home/agent/token-economizer.
as_agent sh -c "claude plugin marketplace add /home/agent/token-economizer; claude plugin install tokeneconomizer@tokeneconomizer" \
  || echo "sandbox-boot: warning: the TokenEconomizer plugin is not installed" >&2

# Herdr keeps its layout in ~/.config/herdr. The volume herdr (mounted at ~/.herdr) keeps session.json and session-snapshots, so that a new VM restores the panes.
# Herdr writes through the links. ln -sfn makes the same links at each boot.
as_agent mkdir -p "$home/.config/herdr" "$home/.herdr/session-snapshots"
as_agent ln -sfn "$home/.herdr/session.json" "$home/.config/herdr/session.json"
as_agent ln -sfn "$home/.herdr/session-snapshots" "$home/.config/herdr/session-snapshots"

echo "sandbox-boot: ready"
