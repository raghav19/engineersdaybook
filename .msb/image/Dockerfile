# syntax=docker/dockerfile:1

FROM debian:trixie-slim AS stage1-base
ARG MISE_VERSION=v2026.10.0

ENV MISE_DATA_DIR=/opt/mise \
    MISE_CACHE_DIR=/tmp/mise-cache \
    MISE_INSTALL_PATH=/usr/local/bin/mise \
    COMPLETIONS_DIR=/home/agent/.local/share/bash-completion/completions

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      curl ca-certificates git xz-utils bzip2 bash-completion tar gzip libstdc++6 procps less openssh-client nano \
      podman podman-docker uidmap passt fuse-overlayfs \
 && rm -rf /var/lib/apt/lists/* \
 && ldconfig

RUN useradd --create-home --uid 1000 --shell /bin/bash agent \
 && mkdir -p /opt/mise /home/agent/.cache/terraform-providers \
 && chown -R agent:agent /opt/mise /home/agent

RUN curl -fsSL https://mise.run | MISE_VERSION=$MISE_VERSION sh
COPY mise.toml /etc/mise/conf.d/mise.toml
USER agent


FROM stage1-base AS stage2-runtimes
COPY tools/runtimes.toml /etc/mise/conf.d/runtimes.toml
RUN mise install --yes && rm -rf /opt/mise/installs/node/*/include

# 
FROM stage2-runtimes AS stage3-headroom
COPY tools/headroom.toml /etc/mise/conf.d/headroom.toml
# uv cache (~880 MiB) is a download cache. Tools do not read it. Removed from the layer.
RUN mise install --yes && rm -rf /home/agent/.cache/uv

FROM stage1-base AS stage4-infra
COPY tools/infra.toml /etc/mise/conf.d/infra.toml
# The same step removes spire-server. The VM runs only the agent.
RUN mise install --yes && rm -f /opt/mise/installs/github-spiffe-spire/*/bin/spire-server

FROM stage1-base AS stage5-dev
COPY tools/dev.toml /etc/mise/conf.d/dev.toml
RUN mise install --yes

FROM stage1-base AS stage6-agents
COPY tools/agents.toml /etc/mise/conf.d/agents.toml
RUN mise install --yes

FROM stage1-base AS stage7-lsp
COPY tools/lsp.toml /etc/mise/conf.d/lsp.toml
RUN mise install --yes

FROM stage1-base AS stage8-ttt-plugins
ARG TTT_PLUGINS_REF=2722887bdbd6080e1a8970fcdf4cb958b2089484
RUN set -eu; \
    url="https://raw.githubusercontent.com/eugenioenko/ttt-plugins/${TTT_PLUGINS_REF}"; \
    mkdir -p /home/agent/.cache/ttt-plugins-build/markdown-preview /home/agent/.cache/ttt-plugins-build/lang-just/syntaxes /home/agent/.cache/ttt-plugins-build/omarchy-theme; \
    curl -fsSL -o /home/agent/.cache/ttt-plugins-build/markdown-preview/plugin.lua      "$url/markdown-preview/plugin.lua"; \
    curl -fsSL -o /home/agent/.cache/ttt-plugins-build/markdown-preview/plugin.ttt.json "$url/markdown-preview/plugin.ttt.json"; \
    curl -fsSL -o /home/agent/.cache/ttt-plugins-build/lang-just/plugin.ttt.json        "$url/lang-just/plugin.ttt.json"; \
    curl -fsSL -o /home/agent/.cache/ttt-plugins-build/lang-just/syntaxes/just.tmLanguage.json "$url/lang-just/syntaxes/just.tmLanguage.json"; \
    curl -fsSL -o /home/agent/.cache/ttt-plugins-build/omarchy-theme/init.lua           "$url/omarchy-theme/init.lua"; \
    curl -fsSL -o /home/agent/.cache/ttt-plugins-build/omarchy-theme/plugin.ttt.json    "$url/omarchy-theme/plugin.ttt.json"

FROM stage1-base AS stage9-token-economizer
ARG TE_REF=main
RUN git clone https://github.com/microsoft/TokenEconomizer.git /home/agent/token-economizer \
 && cd /home/agent/token-economizer && git fetch origin ${TE_REF} && git checkout FETCH_HEAD \
 && rm -rf .git tests experiments docs .github README.md SECURITY.md CLAUDE.md .gitattributes .gitignore

FROM stage1-base AS stage10-final
COPY --from=stage2-runtimes --chown=agent:agent /opt/mise/installs /opt/mise/installs
COPY --from=stage3-headroom --chown=agent:agent /opt/mise/installs/pypi-headroom-ai /opt/mise/installs/pypi-headroom-ai
COPY --from=stage3-headroom --chown=agent:agent /opt/mise/installs/uv /opt/mise/installs/uv
COPY --from=stage4-infra --chown=agent:agent /opt/mise/installs /opt/mise/installs
COPY --from=stage5-dev --chown=agent:agent /opt/mise/installs /opt/mise/installs
COPY --from=stage6-agents --chown=agent:agent /opt/mise/installs /opt/mise/installs
COPY --from=stage7-lsp --chown=agent:agent /opt/mise/installs /opt/mise/installs
COPY tools/ /etc/mise/conf.d/
# mise creates shims from installed tools. Bash completions are generated by a mise task.
RUN mise reshim && mise run sandbox:completions

# Build-time proof that ttt runs. Prints version and exits. Shims not yet on PATH (ENV below adds them).
RUN PATH=/opt/mise/shims:$PATH ttt --version

# Agent-level configs.
COPY --chown=agent:agent configs/editor/ttt-settings.json /home/agent/.config/ttt/settings.json
COPY --from=stage8-ttt-plugins --chown=agent:agent /home/agent/.cache/ttt-plugins-build/markdown-preview/ /home/agent/.config/ttt/plugins/markdown-preview/
COPY --from=stage8-ttt-plugins --chown=agent:agent /home/agent/.cache/ttt-plugins-build/lang-just/ /home/agent/.config/ttt/plugins/lang-just/
COPY --from=stage8-ttt-plugins --chown=agent:agent /home/agent/.cache/ttt-plugins-build/omarchy-theme/ /home/agent/.config/ttt/plugins/omarchy-theme/
COPY --chown=agent:agent configs/editor/ttt-plugins.json /home/agent/.config/ttt/plugins.ttt.json
COPY --chown=agent:agent configs/spire/spire-agent.conf /home/agent/.config/spire/agent.conf
COPY --chown=agent:agent configs/containers/containers.conf /home/agent/.config/containers/containers.conf
COPY --from=stage9-token-economizer --chown=agent:agent /home/agent/token-economizer /home/agent/token-economizer
COPY --chown=agent:agent configs/agent/gitconfig /home/agent/.gitconfig
COPY --chown=agent:agent configs/agent/profile /home/agent/.profile
RUN mkdir -p /home/agent/.config/ttt/themes /home/agent/.tokeneconomizer /home/agent/.config/containers \
 && touch /home/agent/.config/containers/nodocker

# Root-only: sandbox-boot, managed settings.
USER root
COPY sandbox-boot /usr/local/bin/sandbox-boot
RUN chmod 0755 /usr/local/bin/sandbox-boot

RUN mkdir -p /etc/claude-code && chmod 0755 /etc/claude-code
COPY --chmod=0644 configs/agents/managed-settings.json /etc/claude-code/managed-settings.json

RUN mkdir -p /etc/qwen-code && chmod 0755 /etc/qwen-code
COPY --chmod=0644 configs/agents/qwen-settings.json /etc/qwen-code/settings.json

ENV PATH=/opt/mise/shims:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    LANG=C.UTF-8 \
    EDITOR=ttt
