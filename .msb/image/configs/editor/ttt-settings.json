{
  "version": 1,
  "theme": "omarchy",
  "appearance": {
    "icons": "nerd-font"
  },
  "editor": {
    "transparentBackground": true,
    "bracketPairColorization": true,
    "diffMode": "unified",
    "formatOnSave": true,
    "autoClosing": {
      "brackets": true,
      "quotes": true
    }
  },
  "terminal": {
    "shell": "/bin/bash",
    "args": ["--login", "-i"]
  },
  "plugins": {
    "enabled": true
  },
  "lsp": {
    "servers": {
      "python": {
        "command": ["ruff", "server"],
        "languages": {".py": "python", ".pyi": "python"}
      },
      "terraform": {
        "command": ["terraform-ls", "serve"],
        "languages": {".tf": "terraform", ".tfvars": "terraform-vars"}
      },
      "yaml": {
        "command": ["yaml-language-server", "--stdio"],
        "languages": {".yaml": "yaml", ".yml": "yaml"}
      },
      "json": {
        "command": ["vscode-json-language-server", "--stdio"],
        "languages": {".json": "json", ".jsonc": "jsonc"}
      },
      "toml": {
        "command": ["taplo", "lsp", "stdio"],
        "languages": {".toml": "toml"}
      },
      "markdown": {
        "command": ["marksman", "server"],
        "languages": {".md": "markdown"}
      },
      "bash": {
        "command": ["bash-language-server", "start"],
        "languages": {".sh": "shellscript", ".bash": "shellscript"}
      },
      "dockerfile": {
        "command": ["docker-language-server", "start", "--stdio"]
      },
      "just": {
        "command": ["just-lsp"]
      }
    }
  },
  "formatters": {
    "py": "ruff format --stdin-filename {file} -",
    "tf": "terraform fmt -",
    "yaml": "yamlfmt -",
    "yml": "yamlfmt -",
    "toml": "taplo fmt -",
    "sh": "shfmt",
    "bash": "shfmt"
  }
}
